---
import { articles } from '../../data/news/index.js';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';

const featured = articles[0]; // newest
const rest = articles.slice(1);

function formatDate(dateStr: string) {
  return new Date(dateStr + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

const title = "What's New at United | Fleet, Routes & Ops Updates | The Blue Board";
const description =
  'Everything a United frequent flyer should know right now. Fleet moves, new routes, lounge changes, and the ops updates that actually matter. Curated by The Blue Board.';
const shareTitle = "What's New at United | Fleet, Routes & Ops Updates";
const shareDescription =
  'Everything a United frequent flyer should know right now. Fleet moves, new routes, lounge changes, and the ops updates that actually matter.';

const metaClass =
  'font-mono text-[10px] tracking-wider text-muted-foreground uppercase';
const readMoreClass =
  'mt-auto inline-flex min-h-11 w-fit items-center text-xs font-semibold text-foreground underline underline-offset-2';
---

<BaseLayout
  title={title}
  description={description}
  canonical="/news"
  ogImage="https://theblueboard.co/og/og-news.jpg"
  ogTitle={shareTitle}
  ogDescription={shareDescription}
  ogImageAlt="The Blue Board — What's New at United"
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'News' }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-foreground">
        What's New at United
      </h1>
      <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
        Everything a frequent flyer should know right now. Fleet moves, new routes, lounge changes,
        and the ops updates that actually matter.
      </p>
    </header>

    {
      articles.length === 0 ? (
        <div class="mt-7 rounded-lg border border-border bg-card p-10 text-center">
          <p class="text-sm text-muted-foreground">No news published yet. Check back soon.</p>
          <p class="mt-2 text-sm text-muted-foreground">
            Follow{' '}
            <a
              href="https://x.com/theblueboard"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-foreground underline underline-offset-2"
            >
              @theblueboard
            </a>{' '}
            for updates.
          </p>
          <p class="mt-3">
            <a
              href="/"
              class="inline-flex min-h-11 items-center text-sm font-semibold text-foreground underline underline-offset-2"
            >
              &larr; Back to dashboard
            </a>
          </p>
        </div>
      ) : (
        <>
          {featured && (
            <article class="mt-7 rounded-lg border border-border border-l-2 border-l-[var(--bb-warn)] bg-card p-5">
              <p class={metaClass}>
                <span class="font-semibold text-primary">{featured.category}</span> &middot;{' '}
                {formatDate(featured.date)}
              </p>
              <h2 class="mt-1.5 text-lg font-bold tracking-tight text-balance text-foreground">
                <a href={`/news/${featured.slug}`} class="hover:underline hover:underline-offset-4">
                  {featured.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{featured.summary}</p>
              <a class={readMoreClass} href={`/news/${featured.slug}`}>
                Read more &rarr;
              </a>
            </article>
          )}

          {rest.length > 0 && (
            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {rest.map((a) => (
                <article class="flex flex-col rounded-lg border border-border bg-card p-4 hover:border-primary">
                  <p class={metaClass}>
                    <span class="font-semibold text-primary">{a.category}</span> &middot;{' '}
                    {formatDate(a.date)}
                  </p>
                  <h3 class="mt-1.5 text-sm leading-snug font-semibold text-balance text-foreground">
                    <a href={`/news/${a.slug}`} class="hover:underline hover:underline-offset-4">
                      {a.title}
                    </a>
                  </h3>
                  <p class="mt-1.5 mb-3 line-clamp-3 text-xs leading-relaxed text-muted-foreground">
                    {a.summary}
                  </p>
                  <a class={readMoreClass} href={`/news/${a.slug}`}>
                    Read &rarr;
                  </a>
                </article>
              ))}
            </div>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
