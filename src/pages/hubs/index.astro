---
import { hubOrder, hubs } from '../../data/hubs/index.js';
import { HUB_LINE_LONG, HUB_LINE_SHORT, TRACKED_BOARDS } from '../../data/facts.js';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import ContentSection from '../../components/site/ContentSection.astro';

const hubSummaries: Record<string, { name: string; city: string; subtitle: string; iata: string }> =
  {};
for (const key of hubOrder) {
  const h = hubs[key];
  hubSummaries[key] = {
    name: h.airportSchema.name,
    city: h.airportSchema.addressLocality,
    subtitle: h.subtitle,
    iata: h.iata,
  };
}

const title = `United Airlines Hubs — ${HUB_LINE_SHORT}, Delays & Status | The Blue Board`;
const description = `Live status across ${HUB_LINE_LONG}. Check delays, cancellations, on-time performance, and Starlink WiFi at ORD, DEN, IAH, EWR, SFO, IAD, LAX, NRT, and GUM. Real-time operations dashboard for United frequent flyers.`;
const shareTitle = `United Airlines Hubs — ${HUB_LINE_SHORT} & Live Status`;

const faqs = [
  {
    question: "What are United Airlines' hub airports?",
    answer:
      "United Airlines operates 8 official hub airports — Chicago O'Hare (ORD), Denver (DEN), Houston Intercontinental (IAH), Newark Liberty (EWR), San Francisco (SFO), Washington Dulles (IAD), Los Angeles (LAX), and Guam (GUM) — plus the Tokyo-Narita (NRT) gateway that The Blue Board also tracks. ORD is the largest with approximately 750 daily departures.",
  },
  {
    question: 'Which United Airlines hub has the most flights?',
    answer:
      "Chicago O'Hare (ORD) is United Airlines' largest hub with up to approximately 750 daily departures at summer peak. Denver (DEN) is the second-largest hub with about 540 daily departures. Houston Intercontinental (IAH) has around 480 daily departures. Newark Liberty (EWR) handles roughly 350-400, operating under FAA flight caps (72 operations per hour) extended through October 2027.",
  },
  {
    question: 'How can I check delays at United Airlines hubs?',
    answer:
      'The Blue Board monitors delays, cancellations, and ground stops at all 8 United hubs plus the Tokyo-Narita gateway in real time. Visit theblueboard.co to see the hub health bar with on-time performance, or visit individual hub pages for detailed delay patterns, seasonal trends, and live flight counts.',
  },
  {
    question: 'Which United hubs have international flights?',
    answer:
      "United's 8 hubs and the Tokyo-Narita gateway all have some level of international service. The primary international gateways are: Newark (EWR) for transatlantic flights, San Francisco (SFO) for transpacific routes, and Houston (IAH) for Latin America. Tokyo Narita (NRT) is United's Asia-Pacific gateway, though most mainland-US Tokyo service now uses Tokyo Haneda (HND). Chicago O'Hare (ORD) and Washington Dulles (IAD) also serve major international routes.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const HUB_LIST_NAMES: Record<string, string> = {
  ord: "United Airlines at Chicago O'Hare (ORD)",
  den: 'United Airlines at Denver (DEN)',
  iah: 'United Airlines at Houston (IAH)',
  ewr: 'United Airlines at Newark (EWR)',
  sfo: 'United Airlines at San Francisco (SFO)',
  iad: 'United Airlines at Washington Dulles (IAD)',
  lax: 'United Airlines at Los Angeles (LAX)',
  nrt: 'United Airlines at Tokyo Narita (NRT)',
  gum: 'United Airlines at Guam (GUM)',
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Airports The Blue Board Tracks',
  description:
    "The 9 airports The Blue Board tracks: United's 8 hubs plus the Tokyo-Narita gateway, with live status, delays, and operations data",
  numberOfItems: hubOrder.length,
  itemListElement: hubOrder.map((key, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: HUB_LIST_NAMES[key],
    url: `https://theblueboard.co/hubs/${key}`,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/hubs"
  ogImage="https://theblueboard.co/og/og-hubs.jpg"
  ogTitle={shareTitle}
  ogDescription={`Live status across ${HUB_LINE_LONG}. Delays, cancellations, on-time performance, and Starlink WiFi. Updated every 30 seconds.`}
  ogImageAlt="The Blue Board — United Airlines Hub Status Dashboard"
  twitterDescription={`Live status across ${HUB_LINE_LONG}. Delays, cancellations, on-time performance. Updated every 30 seconds.`}
  jsonLd={[faqSchema, itemListSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Hubs' }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-foreground">
        United Airlines <span class="text-primary">Hub Airports</span> — Live Status &amp;
        Delays
      </h1>
      <p class="mt-1.5 text-xs text-muted-foreground">
        Real-time operations across all 8 United hubs plus the Tokyo-Narita gateway · Delays,
        cancellations, on-time performance
      </p>
    </header>

    <div class="mt-6 rounded-lg border border-border bg-card p-5 text-center">
      <p class="text-sm text-muted-foreground">
        See all hubs on the live dashboard with real-time delay counts and flight positions.
      </p>
      <a
        class="mt-3 inline-flex min-h-11 items-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
        href="/">Open The Blue Board Dashboard &#8594;</a
      >
    </div>

    <section class="mt-8">
      <h2
        class="mb-3 border-b border-border pb-1.5 text-base font-bold tracking-tight text-foreground"
      >
        Airports The Blue Board Tracks — 8 Hubs + NRT Gateway
      </h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          hubOrder.map((key) => {
            const hub = hubSummaries[key];
            return (
              <li class="flex flex-col rounded-lg border border-border bg-card p-4 hover:border-primary">
                <p class="font-mono text-2xl font-bold tracking-wide text-primary">{hub.iata}</p>
                <p class="mt-1 text-sm font-semibold text-foreground">{hub.name}</p>
                <p class="mt-0.5 mb-3 text-[11px] leading-relaxed text-muted-foreground">
                  {hub.subtitle}
                </p>
                <a
                  class="mt-auto inline-flex min-h-11 w-fit items-center rounded-md bg-primary px-4 text-xs font-semibold text-primary-foreground hover:bg-primary/90"
                  href={`/hubs/${key}`}
                >
                  View {hub.iata} Hub Status &#8594;
                </a>
                {key === 'ewr' && (
                  <a
                    href="/newark"
                    class="mt-2 inline-flex min-h-11 w-fit items-center text-[11px] text-foreground underline underline-offset-2"
                  >
                    FAA cap explained →
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <ContentSection heading="United Airlines Hub Network">
      <p>
        United Airlines operates a network of <strong>8 hub airports</strong> spanning the United
        States and the Pacific, plus the <strong>Tokyo-Narita gateway</strong> — all {
          TRACKED_BOARDS
        } of which The Blue Board tracks. Together, these airports handle thousands of daily
        departures connecting over 350 destinations worldwide. The Blue Board tracks every United
        flight at every one of these airports in real time — updated every 30 seconds.
      </p>
      <p>
        Select a hub above to see live delay counts, on-time performance, Starlink WiFi fleet
        information, seasonal delay patterns, terminal details, and more.
      </p>
      <p>United's hub-and-spoke network is built around three tiers of hubs:</p>
      <ul>
        <li>
          <strong>Major domestic hubs:</strong> <a href="/hubs/ord">Chicago O'Hare (ORD)</a> and <a
            href="/hubs/den">Denver (DEN)</a
          > are the two largest, handling over 1,200 daily departures combined. ORD is United's global
          headquarters and largest operation.
        </li>
        <li>
          <strong>Gateway hubs:</strong> <a href="/hubs/ewr">Newark (EWR)</a> serves as the East Coast
          transatlantic gateway, operating under FAA flight caps (72 operations per hour) extended through
          October 2027; <a href="/hubs/sfo">San Francisco (SFO)</a> and <a href="/hubs/lax"
            >Los Angeles (LAX)</a
          > are Pacific gateways, and <a href="/hubs/iah">Houston (IAH)</a> is the primary Latin America
          gateway.
        </li>
        <li>
          <strong>International hubs:</strong> <a href="/hubs/nrt">Tokyo Narita (NRT)</a> is United's
          Asia-Pacific connecting hub (though most mainland-US Tokyo service now uses Tokyo Haneda), and
          <a href="/hubs/gum">Guam (GUM)</a> connects Pacific island routes. <a href="/hubs/iad"
            >Washington Dulles (IAD)</a
          > serves both domestic and transatlantic routes.
        </li>
      </ul>
    </ContentSection>

    <ContentSection heading="What The Blue Board Tracks at Each Hub">
      <ul>
        <li>
          <strong>Live flight counts</strong> — active United flights at each hub, updated every 30
          seconds
        </li>
        <li>
          <strong>Delay monitoring</strong> — real-time delay counts, cancellations, and on-time
          percentage
        </li>
        <li><strong>Ground stops &amp; FAA alerts</strong> — NAS status affecting hub operations</li>
        <li>
          <strong>Departure &amp; arrival schedules</strong> — with on-time stats and equipment swap
          detection
        </li>
        <li>
          <strong>Starlink WiFi fleet</strong> — which aircraft at each hub have Starlink satellite
          internet
        </li>
        <li><strong>Weather conditions</strong> — METAR observations and NEXRAD radar overlay</li>
        <li>
          <strong>Seasonal delay patterns</strong> — historical context for weather-driven
          disruptions
        </li>
      </ul>
    </ContentSection>

    <ContentSection id="faq" heading="Frequently Asked Questions">
      <h3>What are United Airlines' hub airports?</h3>
      <p>
        United Airlines operates 8 official hub airports: Chicago O'Hare (ORD), Denver (DEN),
        Houston Intercontinental (IAH), Newark Liberty (EWR), San Francisco (SFO), Washington Dulles
        (IAD), Los Angeles (LAX), and Guam (GUM) — plus the Tokyo-Narita (NRT) gateway that The Blue
        Board also tracks. ORD is the largest with approximately 750 daily departures.
      </p>

      <h3>Which United Airlines hub has the most flights?</h3>
      <p>
        Chicago O'Hare (ORD) is United's largest hub with up to approximately 750 daily departures
        at summer peak. Denver (DEN) is the second-largest with about 540. Houston (IAH) handles
        around 480, while Newark (EWR) handles roughly 350-400 under FAA flight caps (extended
        through October 2027).
      </p>

      <h3>How can I check delays at United Airlines hubs?</h3>
      <p>
        The Blue Board monitors delays, cancellations, and ground stops at all 8 United hubs plus
        the Tokyo-Narita gateway in real time. Visit <a href="/">theblueboard.co</a> to see the hub health
        bar with on-time performance, or visit individual hub pages for detailed delay patterns, seasonal
        trends, and live flight counts.
      </p>

      <h3>Which United hubs have international flights?</h3>
      <p>
        United's 8 hubs and the Tokyo-Narita gateway all have some level of international service.
        The primary international gateways are: <a href="/hubs/ewr">Newark (EWR)</a> for transatlantic
        flights, <a href="/hubs/sfo">San Francisco (SFO)</a> for transpacific routes, and <a
          href="/hubs/iah">Houston (IAH)</a
        > for Latin America. <a href="/hubs/nrt">Tokyo Narita (NRT)</a> is United's Asia-Pacific gateway,
        though most mainland-US Tokyo service now uses Tokyo Haneda (HND).
      </p>
    </ContentSection>
  </div>
</BaseLayout>
