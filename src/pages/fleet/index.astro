---
import { fleetOrder, fleetTypes } from '../../data/fleet/index.js';
import { STARLINK_EQUIPPED, STARLINK_EQUIPPED_LABEL, STARLINK_AS_OF } from '../../data/starlink-facts.js';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import ContentSection from '../../components/site/ContentSection.astro';
import StatTile from '../../components/site/StatTile.astro';
import SupportNote from '../../components/site/SupportNote.astro';
import { FLEET_DB_AS_OF, formatFleetAsOf, polarisAircraftCount } from '../../lib/fleet-utils.js';
import fleetDb from '../../../public/data/fleet.json';
import { withBrand } from '../../lib/page-seo.js';

// Build type summaries for the grid
const typeSummaries: Record<
  string,
  { displayName: string; count: number; role: string; bodyType: string; seatTotal: string; slug: string }
> = {};
for (const key of fleetOrder) {
  const t = fleetTypes[key];
  typeSummaries[key] = {
    displayName: t.displayName,
    count: t.count,
    role: t.role,
    bodyType: t.bodyType,
    seatTotal: t.seatConfig.total,
    slug: t.slug,
  };
}

// Family groupings for organized display
const fleetFamilies = [
  { name: 'Boeing 737 Family', types: ['737-800', '737-900er', '737-max-9', '737-max-8', '737-700', '737-900'], role: 'Domestic / Short-haul', count: 0 },
  { name: 'Airbus A320 Family', types: ['a319', 'a320', 'a321neo'], role: 'Domestic / Medium-haul', count: 0 },
  { name: 'Boeing 777', types: ['777-200er', '777-300er', '777-200'], role: 'Long-haul International', count: 0 },
  { name: 'Boeing 787 Dreamliner', types: ['787-9-dreamliner', '787-10-dreamliner', '787-8-dreamliner'], role: 'Long-haul International', count: 0 },
  { name: 'Boeing 757', types: ['757-200', '757-300'], role: 'Transcon / Hawaii', count: 0 },
  { name: 'Boeing 767', types: ['767-300er', '767-400er'], role: 'Transatlantic / Medium-haul', count: 0 },
];
for (const fam of fleetFamilies) {
  // Use optional chaining so a renamed or removed type key degrades to 0
  // rather than crashing the build with "cannot read properties of undefined".
  fam.count = fam.types.reduce((sum, key) => sum + (fleetTypes[key]?.count ?? 0), 0);
}

// Compute fleet-wide stats
const totalAircraft = fleetOrder.reduce((sum, key) => sum + fleetTypes[key].count, 0);
// Per tail, not per type: 4 of the 777-200ERs fly a domestic layout with no Polaris cabin.
const polarisTypeKeys = fleetOrder.filter((key) => fleetTypes[key].seatConfig.hasPolaris);
const polarisTypeTotal = polarisTypeKeys.reduce((sum, key) => sum + fleetTypes[key].count, 0);
const polarisAircraft = polarisAircraftCount(
  fleetDb,
  polarisTypeKeys.map((key) => fleetTypes[key].typeCode),
);
const polarisNote =
  polarisTypeTotal > polarisAircraft
    ? ` (the other ${polarisTypeTotal - polarisAircraft} fly a domestic layout without it)`
    : '';
const widebodyAircraft = fleetOrder.reduce(
  (sum, key) => sum + (fleetTypes[key].bodyType === 'widebody' ? fleetTypes[key].count : 0),
  0,
);
const starlinkEquipped = STARLINK_EQUIPPED; // canonical value from src/data/facts.js (refreshed at build)

// Seat config table order: widebody (Polaris) first, then narrowbody
const seatConfigOrder = [
  '777-300er', '777-200er', '787-10-dreamliner', '787-9-dreamliner', '787-8-dreamliner',
  '767-300er', '767-400er', '777-200',
  '757-300', '757-200', 'a321neo',
  '737-max-9', '737-max-8', '737-900er', '737-800', 'a320', 'a319', '737-700', '737-900',
];

// Short cabin label map
const cabinShortLabel: Record<string, string> = {
  'Polaris Business': 'Polaris',
  'Premium Plus': 'Prem+',
  'Economy Plus': 'E+',
  Economy: 'Y',
  First: 'First',
};

// Family table rows: the per-family total is hand-maintained copy (MAINTENANCE.md).
const FAMILY_ROWS = [
  { name: 'Boeing 737', total: 640, role: 'Domestic / Short-haul', types: [
    { slug: '737-700', label: '737-700' }, { slug: '737-800', label: '-800' }, { slug: '737-900', label: '-900' },
    { slug: '737-900er', label: '-900ER' }, { slug: '737-max-8', label: 'MAX 8' }, { slug: '737-max-9', label: 'MAX 9' },
  ] },
  { name: 'Airbus A320 Family', total: 207, role: 'Domestic / Medium-haul', types: [
    { slug: 'a319', label: 'A319' }, { slug: 'a320', label: 'A320' }, { slug: 'a321neo', label: 'A321neo' },
  ] },
  { name: 'Boeing 777', total: 96, role: 'Long-haul International', types: [
    { slug: '777-200', label: '777-200' }, { slug: '777-200er', label: '-200ER' }, { slug: '777-300er', label: '-300ER' },
  ] },
  { name: 'Boeing 787 Dreamliner', total: 97, role: 'Long-haul International', types: [
    { slug: '787-8-dreamliner', label: '787-8' }, { slug: '787-9-dreamliner', label: '-9' }, { slug: '787-10-dreamliner', label: '-10' },
  ] },
  { name: 'Boeing 757', total: 61, role: 'Transcon / Hawaii', types: [
    { slug: '757-200', label: '757-200' }, { slug: '757-300', label: '-300' },
  ] },
  { name: 'Boeing 767', total: 53, role: 'Transatlantic / Medium-haul', types: [
    { slug: '767-300er', label: '767-300ER' }, { slug: '767-400er', label: '-400ER' },
  ] },
];

const HUB_LINKS = [
  { slug: 'ord', label: "ORD — Chicago O'Hare" },
  { slug: 'den', label: 'DEN — Denver' },
  { slug: 'iah', label: 'IAH — Houston' },
  { slug: 'ewr', label: 'EWR — Newark' },
  { slug: 'sfo', label: 'SFO — San Francisco' },
  { slug: 'iad', label: 'IAD — Washington Dulles' },
  { slug: 'lax', label: 'LAX — Los Angeles' },
  { slug: 'nrt', label: 'NRT — Tokyo Narita' },
  { slug: 'gum', label: 'GUM — Guam' },
];

// SEO strings: counts come from the per-type data, never hand-typed (see src/lib/page-seo.js).
const totalAircraftText = totalAircraft.toLocaleString('en-US');
const title = withBrand(`United Airlines Fleet: ${totalAircraftText} Aircraft, ${fleetOrder.length} Types`);
const description = `All ${totalAircraftText} United Airlines mainline aircraft across ${fleetOrder.length} types: seat maps, WiFi, Starlink status and registries for every Boeing and Airbus type.`;
const shareTitle = `United Airlines Fleet — ${totalAircraftText} Aircraft Database | The Blue Board`;

// JSON-LD. The Starlink figures come from the build-time facts, so these are
// objects rather than the literal <script> text they used to be.
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'United Airlines Fleet Database',
  description:
    `Complete database of United Airlines mainline fleet with ${totalAircraftText} aircraft across ${fleetOrder.length} types. Includes aircraft type, registration, seat configuration, WiFi type, IFE system, delivery date, operational status, and Starlink satellite internet equipment status.`,
  url: 'https://theblueboard.co/fleet',
  license: 'https://creativecommons.org/licenses/by-nc/4.0/',
  creator: { '@type': 'Organization', name: 'The Blue Board', url: 'https://theblueboard.co' },
  dateModified: FLEET_DB_AS_OF,
  temporalCoverage: '2025/..',
  keywords: ['United Airlines', 'fleet database', 'aircraft', 'seat configuration', 'Starlink WiFi', 'Polaris'],
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Aircraft Count', value: String(totalAircraft) },
    { '@type': 'PropertyValue', name: 'Aircraft Types', value: '19' },
    { '@type': 'PropertyValue', name: 'Starlink Equipped', value: String(STARLINK_EQUIPPED) },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'United Airlines Fleet — Aircraft Types',
  description: 'All 19 mainline aircraft types in the United Airlines fleet with detailed guides',
  numberOfItems: 19,
  itemListElement: fleetOrder.map((key, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `United Airlines ${fleetTypes[key].displayName}`,
    url: `https://theblueboard.co/fleet/${key}`,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How many aircraft does United Airlines have?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `United reported 1,143 mainline aircraft at the end of September 2026 in its October 20, 2026 fleet plan. The Blue Board's fleet database lists ${totalAircraftText} mainline aircraft as of ${formatFleetAsOf()}, including jets delivered in October, across ${fleetOrder.length} types: the Boeing 737, 757, 767, 777, and 787 families, plus Airbus A319, A320, and A321neo. Both counts exclude the United Express regional fleet — 432 aircraft at the end of September 2026 (Embraer E175, Bombardier CRJ550, and others) — flown by partner carriers such as SkyWest and Republic.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Which United Airlines planes have Polaris business class?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `United Polaris lie-flat business class is available on all widebody international aircraft: Boeing 777-200ER (${fleetTypes['777-200er'].count}), 777-300ER (${fleetTypes['777-300er'].count}), 787-8 (${fleetTypes['787-8-dreamliner'].count}), 787-9 (${fleetTypes['787-9-dreamliner'].count}), 787-10 (${fleetTypes['787-10-dreamliner'].count}), 767-300ER (${fleetTypes['767-300er'].count}), and 767-400ER (${fleetTypes['767-400er'].count}). That's ${polarisAircraft} aircraft with Polaris seats${polarisNote}. Use The Blue Board's fleet database to check the exact seat configuration for any specific aircraft.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Which United Airlines planes have Starlink WiFi?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `As of ${STARLINK_AS_OF}, ${STARLINK_EQUIPPED_LABEL} United Airlines aircraft are equipped with free SpaceX Starlink satellite internet — the majority of them United Express regional jets, which led the rollout, followed by mainline Boeing 737s and Airbus A321neos and, since June 2026, the first widebody Boeing 777s. United expects Starlink on 61% of its flights by the end of 2026 and fleet-wide by the end of 2027. Starlink is free for all MileagePlus members and provides gate-to-gate high-speed connectivity. Check if your specific plane has Starlink using The Blue Board's Starlink Tracker.`,
      },
    },
    {
      '@type': 'Question',
      name: "What is the largest aircraft in United's fleet?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "The Boeing 777-300ER is the largest aircraft in United Airlines' fleet, seating up to 350 passengers across four cabin classes: 60 Polaris business, 24 Premium Plus, 62 Economy Plus, and 204 Economy. United operates 22 of these aircraft on flagship long-haul international routes.",
      },
    },
    {
      '@type': 'Question',
      name: "What is the newest aircraft in United's fleet?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: `United's newest aircraft type is the Airbus A321XLR, delivered from June 2026 and in domestic service since September 2026 — United's first single-aisle jet with lie-flat Polaris business suites and Premium Plus, which United is using to replace the Boeing 757 on long, thin transatlantic routes from December 2026. The Airbus A321neo (${fleetTypes['a321neo'].count} aircraft including the XLRs, delivered 2023–2026) is the newest high-volume narrowbody, and United keeps taking new Boeing 737 MAX 9s. Among widebodies, the latest Boeing 787-9 Dreamliners now debut United's new Polaris Studio suites, with 787 deliveries continuing through the decade.`,
      },
    },
  ],
};

// The site's page-link pill (PillNav, the 404 page, news cross-links): bordered card, no tint.
const hubLinkClass =
  'inline-flex min-h-11 items-center rounded-md border border-border bg-card px-3.5 text-[11px] font-semibold text-muted-foreground no-underline hover:border-primary hover:text-foreground';
---

<BaseLayout
  title={title}
  description={description}
  canonical="/fleet"
  ogImage="https://theblueboard.co/og/og-fleet.jpg"
  ogTitle={shareTitle}
  ogDescription="Complete United Airlines fleet database. Every mainline aircraft — 737, 757, 767, 777, 787, A319, A320, A321neo — with seat configs, WiFi, and detailed type guides."
  ogImageAlt="The Blue Board — United Airlines Fleet Database"
  twitterDescription={`Complete United Airlines fleet. ${totalAircraftText} aircraft, ${fleetOrder.length} types. Seat maps, WiFi, Starlink status. Fleet data as of ${formatFleetAsOf()}.`}
  jsonLd={[datasetSchema, itemListSchema, faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Fleet Database' }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-foreground">
        United Airlines Fleet Database
      </h1>
      <p class="mt-1.5 text-xs text-muted-foreground">
        {totalAircraftText} mainline aircraft · {fleetOrder.length} types · seat configs · WiFi · Starlink · as of
        <time datetime={FLEET_DB_AS_OF}>{formatFleetAsOf()}</time>
      </p>
      <SupportNote variant="inline" placement="fleet-index-top" />
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          class="inline-flex min-h-11 items-center rounded-md bg-primary-fill px-6 text-sm font-semibold text-primary-foreground hover:bg-primary-fill/90"
          href="/?tab=fleet">Explore Interactive Fleet Database &rarr;</a
        >
        <p class="max-w-sm text-[11px] leading-relaxed text-muted-foreground">
          Search by registration, filter by aircraft type, seat configuration, WiFi system, Starlink
          status — all in one interactive dashboard.
        </p>
      </div>
    </header>

    <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
      <StatTile label="Mainline Aircraft" value={totalAircraft.toLocaleString()} />
      <StatTile label="Polaris Aircraft" value={polarisAircraft} />
      <StatTile label="Starlink Equipped" value={starlinkEquipped} />
      <StatTile label="Widebody Aircraft" value={widebodyAircraft} />
    </div>

    <ContentSection heading="Fleet Overview">
      <p>
        United Airlines operates one of the world's largest and most diverse fleets, with {totalAircraftText}
        mainline aircraft spanning narrowbody and widebody types from Boeing and Airbus — and it is
        in the middle of its biggest fleet renewal in decades, taking 250+ new jets by 2028 while
        rolling out free Starlink WiFi and the new Polaris Studio suite.
      </p>
      <table>
        <thead>
          <tr><th>Family</th><th>Types</th><th class="text-right">Aircraft</th><th>Role</th></tr>
        </thead>
        <tbody>
          {
            FAMILY_ROWS.map((fam) => (
              <tr>
                <td class="font-semibold text-primary">{fam.name}</td>
                <td>
                  {fam.types.map((t, i) => (
                    <>{i > 0 ? ', ' : ''}<a href={`/fleet/${t.slug}`}>{t.label}</a></>
                  ))}
                </td>
                <td class="text-right font-mono font-bold text-foreground tabular-nums">{fam.total}</td>
                <td>{fam.role}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </ContentSection>

    <ContentSection heading="What's New in United's Fleet — 2026">
      <ul>
        <li>
          <strong>Polaris Studio debuts on the Boeing 787-9.</strong> United's newest "Elevated" <a
            href="/fleet/787-9-dreamliner">787-9 Dreamliners</a
          > carry eight ultra-premium Polaris Studio suites — sliding privacy doors, 27-inch 4K screens,
          and a companion seat — giving them the highest premium-seat ratio of any U.S. widebody. In service
          since April 2026 from San Francisco to Singapore and London, since joined by Zurich and Seoul,
          with Houston departures scheduled from October 24, 2026.
        </li>
        <li>
          <strong>The Airbus A321XLR enters service.</strong> United's first long-range single-aisle
          jet arrived in June 2026 with 20 lie-flat Polaris suites and Premium Plus and debuted in
          domestic service in September. It is scheduled to start replacing the <a
            href="/fleet/757-200">Boeing 757-200</a
          > on long, thin transatlantic routes; its first, Washington Dulles to Dublin and Amsterdam, are scheduled from December 1, 2026.
        </li>
        <li>
          <strong>Free Starlink WiFi passes {STARLINK_EQUIPPED_LABEL} aircraft.</strong> United
          Express regional jets led the rollout, mainline <a href="/fleet/737-800">737-800s</a>
          followed in October 2025, and the first widebody <a href="/fleet/777-200er"
            >Boeing 777</a
          > went live in June 2026. United expects Starlink on 61% of its flights by the end of 2026 and
          fleet-wide by the end of 2027.
        </li>
        <li>
          <strong>The Signature Interior reaches most narrowbodies.</strong> 68% of United's
          narrowbody fleet had seatback 4K screens, Bluetooth audio, and larger overhead bins by the end
          of 2025, with new <a href="/fleet/a321neo">A321neo</a> and 737 MAX jets arriving factory-fit.
        </li>
        <li>
          <strong>The Boeing 737 MAX 10 is certified.</strong> The FAA certified the 737-10 on October
          20, 2026. As of its September 30 quarterly filing, United expected its first 19 in 2027 — see
          the <a href="/fleet/737-max-9">737 MAX 9</a> page.
        </li>
        <li>
          <strong>United marks its 100th anniversary in 2026,</strong> tracing its roots to Varney Air
          Lines' first airmail flight on April 6, 1926.
        </li>
      </ul>
    </ContentSection>

    {
      fleetFamilies.map((fam) => (
        <section class="mt-8">
          <div class="mb-3 flex flex-wrap items-baseline gap-2.5 border-b border-border pb-2">
            <span class="font-mono text-xl font-bold tracking-wide text-primary tabular-nums">
              {fam.count}
            </span>
            <h2 class="text-base font-bold tracking-tight text-foreground">{fam.name}</h2>
            <span class="ml-auto text-[11px] tracking-wider text-muted-foreground uppercase">
              {fam.role}
            </span>
          </div>
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {fam.types.map((key) => {
              const t = typeSummaries[key];
              return (
                <li class="flex flex-col rounded-lg border border-border bg-card p-4 hover:border-primary">
                  <p class="font-mono text-2xl font-bold tracking-wide text-primary tabular-nums">
                    {t.count}
                  </p>
                  <p class="mt-1 text-sm font-semibold text-foreground">{t.displayName}</p>
                  <p class="mt-1 mb-3 text-[11px] leading-relaxed text-muted-foreground">
                    <span
                      class:list={[
                        'mr-1 inline-block rounded-sm px-1.5 py-0.5 font-semibold text-foreground',
                        t.bodyType === 'widebody'
                          ? 'bg-primary/25'
                          : 'bg-bb-ok/22',
                      ]}
                    >
                      {t.bodyType === 'widebody' ? 'Widebody' : 'Narrowbody'}
                    </span>
                    {t.seatTotal} seats · <span class="whitespace-nowrap">{t.role}</span>
                  </p>
                  <a
                    class="mt-auto inline-flex min-h-11 w-fit items-center rounded-md bg-primary-fill px-4 text-xs font-semibold text-primary-foreground hover:bg-primary-fill/90"
                    href={`/fleet/${t.slug}`}
                  >
                    View {t.displayName} &rarr;
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <ContentSection heading="Seat Configurations & Cabin Classes">
      <p>
        United offers up to four cabin classes depending on the aircraft: <span
          class="cabin-tag cabin-polaris">Polaris Business</span
        > <span class="cabin-tag cabin-pp">Premium Plus</span> <span class="cabin-tag cabin-ep"
          >Economy Plus</span
        > and Economy. Polaris lie-flat seats are available on all widebody international aircraft. Select
        any type above for the full seat configuration guide.
      </p>
      <table class="tabular-nums">
        <thead>
          <tr><th>Aircraft</th><th class="text-right">Count</th><th>Cabin Configuration</th><th class="text-right">Total</th></tr>
        </thead>
        <tbody>
          {
            seatConfigOrder.map((key) => {
              const t = fleetTypes[key];
              return (
                <tr>
                  <td class="font-bold"><a href={`/fleet/${t.slug}`}>{t.typeCode}</a></td>
                  <td class="text-right font-mono">{t.count}</td>
                  <td>
                    {t.seatConfig.cabins.map((cab: { name: string; seats: string; cssClass: string }) => (
                      <span class:list={['cabin-tag', cab.cssClass]}>
                        {cabinShortLabel[cab.name] || cab.name}
                        <span class="ml-0.5 font-mono text-[11px] font-semibold"> {cab.seats}</span>
                      </span>
                    ))}
                  </td>
                  <td class="text-right font-mono">{t.seatConfig.total}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </ContentSection>

    <ContentSection id="faq" heading="Frequently Asked Questions">
      <h3>How many aircraft does United Airlines have?</h3>
      <p>
        United reported 1,143 mainline aircraft at the end of September 2026 in its October 20, 2026
        fleet plan. The Blue Board's fleet database lists {totalAircraftText} mainline aircraft as of
        {formatFleetAsOf()}, including jets delivered in October, across {fleetOrder.length} types: the
        Boeing 737, 757, 767, 777, and 787 families, plus Airbus A319, A320, and A321neo. Both counts
        exclude the United Express regional fleet — 432 aircraft at the end of September 2026
        (Embraer E175, Bombardier CRJ550, and others) — flown by partner carriers such as SkyWest and
        Republic.
      </p>

      <h3>Which United Airlines planes have Polaris business class?</h3>
      <p>
        United Polaris lie-flat business class is available on all widebody international aircraft:
        <a href="/fleet/777-200er">Boeing 777-200ER</a> ({fleetTypes['777-200er'].count}), <a href="/fleet/777-300er">777-300ER</a
        > ({fleetTypes['777-300er'].count}), <a href="/fleet/787-8-dreamliner">787-8</a> ({fleetTypes['787-8-dreamliner'].count}), <a href="/fleet/787-9-dreamliner"
          >787-9</a
        > ({fleetTypes['787-9-dreamliner'].count}), <a href="/fleet/787-10-dreamliner">787-10</a> ({fleetTypes['787-10-dreamliner'].count}), <a href="/fleet/767-300er"
          >767-300ER</a
        > ({fleetTypes['767-300er'].count}), and <a href="/fleet/767-400er">767-400ER</a> ({fleetTypes['767-400er'].count}). That's {polarisAircraft} aircraft with Polaris seats{polarisNote}.
        Use the <a href="/?tab=fleet">interactive fleet database</a> to check the exact seat configuration
        for any specific aircraft by registration number.
      </p>

      <h3>Which United Airlines planes have Starlink WiFi?</h3>
      <p>
        As of {STARLINK_AS_OF}, {STARLINK_EQUIPPED_LABEL} United Airlines aircraft are equipped with
        free SpaceX Starlink satellite internet — the majority of them United Express regional jets,
        which led the rollout, followed by mainline Boeing 737s and Airbus A321neos and, since June
        2026, the first widebody Boeing 777s. United expects Starlink on 61% of its flights by the end
        of 2026 and fleet-wide by the end of 2027. Starlink is free for all MileagePlus members and provides gate-to-gate high-speed
        connectivity. Check if your specific plane has Starlink using the <a href="/?tab=fleet"
          >Starlink Tracker</a
        > — search by tail number or aircraft type.
      </p>

      <h3>What is the largest aircraft in United's fleet?</h3>
      <p>
        The <a href="/fleet/777-300er">Boeing 777-300ER</a> is the largest aircraft in United Airlines'
        fleet, seating up to 350 passengers across four cabin classes: Polaris business, Premium Plus,
        Economy Plus, and Economy. United operates 22 of these aircraft, primarily on flagship long-haul
        international routes from hubs like <a href="/hubs/ewr">Newark (EWR)</a> and <a
          href="/hubs/sfo">San Francisco (SFO)</a
        >.
      </p>

      <h3>What is the newest aircraft in United's fleet?</h3>
      <p>
        United's newest aircraft type is the <a href="/fleet/a321neo">Airbus A321XLR</a>, delivered
        from June 2026 and in domestic service since September 2026 — United's first single-aisle jet
        with lie-flat Polaris business suites and Premium Plus, which United is using to replace the
        Boeing 757 on long, thin transatlantic routes from December 2026. The <a href="/fleet/a321neo"
          >Airbus A321neo</a
        > ({fleetTypes['a321neo'].count} aircraft including the XLRs, 2023–2026) is the newest
        high-volume narrowbody, with Pratt &amp; Whitney PW1100G engines and 4K seatback screens at every
        seat, and United keeps adding <a href="/fleet/737-max-9">Boeing 737 MAX 9s</a>. Among widebodies,
        the latest <a href="/fleet/787-9-dreamliner">Boeing 787-9 Dreamliners</a> now feature United's
        new Polaris Studio suites.
