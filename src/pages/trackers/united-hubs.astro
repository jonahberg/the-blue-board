---
import outline from '../../data/trackers/us-outline.json';
import { unitedHubsMeta, unitedHubs, unitedProjects } from '../../data/trackers/united-hubs.js';
import { atcAirports } from '../../data/trackers/atc.js';
import { projectPoint, outlinePaths } from '../../lib/tracker-map.js';
import { trackerParentSeo } from '../../lib/tracker-detail.js';
import StatStrip from '../../components/trackers/StatStrip.astro';
import TrackerMap from '../../components/trackers/TrackerMap.astro';
import TrackerSearch from '../../components/trackers/TrackerSearch.astro';
import TrackerTable from '../../components/trackers/TrackerTable.astro';
import StatusBadge from '../../components/trackers/StatusBadge.astro';
import Changelog from '../../components/trackers/Changelog.astro';
import LastUpdated from '../../components/trackers/LastUpdated.astro';
import CrossLink from '../../components/trackers/CrossLink.astro';
import SourceDisclosure from '../../components/trackers/SourceDisclosure.astro';
import TrackerPulse from '../../components/trackers/TrackerPulse.astro';
import TrackerDataActions from '../../components/trackers/TrackerDataActions.astro';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import { SECTION, SECTION_H2 } from '../../components/trackers/detail';

const paths = outlinePaths(outline);

// ---- status + type vocabulary ----
const STATUS = {
  open: { label: 'Open', tone: 'green', glyph: '●', rank: 2 },
  'under-construction': { label: 'Under construction', tone: 'yellow', glyph: '◆', rank: 0 },
  announced: { label: 'Announced', tone: 'accent', glyph: '◇', rank: 1 },
  rumored: { label: 'Rumored', tone: 'dim', glyph: '?', rank: 3 },
};
const TYPE_LABEL = {
  club: 'Club',
  polaris: 'Polaris',
  'club-fly': 'Club Fly',
  terminal: 'Terminal',
  gates: 'Gates',
  other: 'Other',
};
// traveler-facing overrides for the generic 'other' bucket
const TYPE_OVERRIDE = {
  'ewr-airtrain': 'Transit',
  'lax-people-mover': 'Transit',
  'gum-lobby': 'Check-in',
};
const typeLabelFor = (p) => TYPE_OVERRIDE[p.id] ?? TYPE_LABEL[p.projectType];

const hubOrder = ['IAH', 'IAD', 'SFO', 'DEN', 'ORD', 'EWR', 'LAX', 'GUM'];
const projectsByHub = Object.fromEntries(hubOrder.map((h) => [h, unitedProjects.filter((p) => p.hub === h)]));
const atcCodes = new Set(atcAirports.map((a) => a.code));
const hubPulseEntities = Object.fromEntries(
  hubOrder.map((code) => {
    const projects = projectsByHub[code];
    const moving = projects.filter((p) => p.status === 'under-construction' || p.status === 'announced').length;
    return [
      code,
      {
        label: `${code} · ${unitedHubs[code].city}`,
        summary: `${projects.length} tracked ${projects.length === 1 ? 'project' : 'projects'} · ${moving} active or announced.`,
        href: `/trackers/united-hubs#hub-${code.toLowerCase()}`,
      },
    ];
  })
);

// ---- per-hub map status: colored by United-funded activity, not airport megaprojects,
// or every hub would read "construction". Legend explains the distinction. ----
const hubMapMeta = {
  IAH: { shape: 'diamond', tone: 'yellow', badge: { label: 'United building', tone: 'yellow', glyph: '◆' },
    line1: '4 projects — the 54,000 sq ft flagship club and 22 new gates target fall 2026.' },
  IAD: { shape: 'diamond', tone: 'yellow', badge: { label: 'United building', tone: 'yellow', glyph: '◆' },
    line1: "5 projects — a 14-gate concourse and United's new 40,000 sq ft club open this fall." },
  SFO: { shape: 'diamond', tone: 'accent', badge: { label: 'Club announced', tone: 'accent', glyph: '◇' },
    line1: '2 projects — a 25,000 sq ft club with an outdoor terrace, due by end of 2026.' },
  DEN: { shape: 'diamond', tone: 'accent', badge: { label: 'Polaris announced', tone: 'accent', glyph: '◇' },
    line1: '6 projects — two big clubs already open; the promised Polaris lounge still has no date.' },
  ORD: { shape: 'dot', tone: 'green', badge: { label: 'Recently delivered', tone: 'green', glyph: '●' },
    line1: '4 projects — the expanded Polaris reopened in 2025; the big terminal work is the city’s, and slow.' },
  EWR: { shape: 'dot', tone: 'green', badge: { label: 'Recently delivered', tone: 'green', glyph: '●' },
    line1: '3 projects — United finished its lounge buildout in 2023–25; the Port Authority builds on.' },
  LAX: { shape: 'ring', tone: 'dim', badge: { label: 'Quiet', tone: 'dim', glyph: '○' },
    line1: '1 project — nothing United-funded is active; the airport’s people mover inches toward opening.' },
  GUM: { shape: 'ring', tone: 'dim', badge: { label: 'Quiet', tone: 'dim', glyph: '○' },
    line1: '1 project — a check-in lobby refresh opened in December 2025.' },
};

const mapPoints = [];
const offMap = [];
for (const code of hubOrder) {
  const h = unitedHubs[code];
  const m = hubMapMeta[code];
  const p = projectPoint(h.lng, h.lat);
  const card = { title: `${code} — ${h.name}`, badge: m.badge, line1: m.line1, line2: h.quietNote ?? '' };
  if (!p) {
    offMap.push({ title: `${code} — ${h.city}`, badge: m.badge });
    continue;
  }
  mapPoints.push({ id: `hub-${code.toLowerCase()}`, code, x: p.x, y: p.y, shape: m.shape, tone: m.tone, label: true, card });
}

const legend = [
  { label: 'United building now', shape: 'diamond', tone: 'yellow' },
  { label: 'United project announced', shape: 'diamond', tone: 'accent' },
  { label: 'Recently delivered', shape: 'dot', tone: 'green' },
  { label: 'Quiet right now', shape: 'ring', tone: 'dim' },
];

// ---- formatting ----
const fmtDate = (d) => {
  if (!d) return '';
  const opts = d.length === 7 ? { year: 'numeric', month: 'short' } : { year: 'numeric', month: 'short', day: 'numeric' };
  return new Date((d.length === 7 ? d + '-15' : d) + 'T12:00:00Z').toLocaleDateString('en-US', opts);
};
const fmtSqFt = (n) => `${n.toLocaleString('en-US')} sq ft`;
const fmtCost = (n) => (n >= 1e9 ? `$${(n / 1e9).toFixed(n % 1e9 === 0 ? 0 : 2).replace(/\.?0+$/, '')}B` : `$${Math.round(n / 1e6)}M`);

const metaLineFor = (p) => {
  const bits = [];
  if (p.status === 'open' && p.openedDate) bits.push(`Opened ${fmtDate(p.openedDate)}`);
  else if (p.targetDate) bits.push(`Target: ${p.targetDate}`);
  if (p.sizeSqFt) bits.push(fmtSqFt(p.sizeSqFt));
  if (p.costUsd) bits.push(fmtCost(p.costUsd));
  if (p.gates) bits.push(`${p.gates} gates`);
  return bits.join(' · ');
};

// ---- table ----
const sortedProjects = [...unitedProjects].sort(
  (a, b) => hubOrder.indexOf(a.hub) - hubOrder.indexOf(b.hub) || STATUS[a.status].rank - STATUS[b.status].rank
);
const tableRows = sortedProjects.map((p) => {
  const s = STATUS[p.status];
  const scale = [p.sizeSqFt && fmtSqFt(p.sizeSqFt), p.costUsd && fmtCost(p.costUsd), p.gates && `${p.gates} gates`]
    .filter(Boolean)
    .join(' · ');
  return {
    id: `t-${p.id}`,
    searchText: `${p.hub} ${unitedHubs[p.hub].city} ${unitedHubs[p.hub].state} ${unitedHubs[p.hub].searchAlias ?? ''} ${unitedHubs[p.hub].name} ${p.name} ${typeLabelFor(p)} ${s.label}`.toLowerCase(),
    cells: {
      project: { primary: p.name, secondary: p.builder === 'airport-authority' ? 'airport builds' : p.builder === 'joint' ? 'joint build' : '', sortVal: p.name.toLowerCase() },
      hub: {
        primary: p.hub,
        mono: true,
        sortVal: `${hubOrder.indexOf(p.hub)}`.padStart(2, '0'),
        link: { href: `/trackers/united-hubs/${p.hub.toLowerCase()}`, text: `${p.hub} projects →` },
      },
      type: { primary: typeLabelFor(p), sortVal: typeLabelFor(p) },
      status: { badge: { label: s.label, tone: s.tone, glyph: s.glyph }, sortVal: String(s.rank) },
      date: p.status === 'open' && p.openedDate
        ? { primary: fmtDate(p.openedDate), mono: true, sortVal: p.openedDate }
        : p.targetDate
          ? { primary: p.targetDate, dim: true, sortVal: '' }
          : { primary: '—', dim: true, sortVal: '' },
      scale: { primary: scale || '—', ...(scale ? {} : { dim: true }) },
      sources: {
        evidence: {
          sources: p.sources,
          verified: unitedHubsMeta.lastVerified,
          entryId: p.id,
          entryLabel: `${p.hub} · ${p.name}`,
          shareHref: `/trackers/united-hubs#${p.id}`,
        },
      },
    },
  };
});
const columns = [
  { key: 'project', label: 'Project', sortable: true },
  { key: 'hub', label: 'Hub', sortable: true },
  { key: 'type', label: 'Type', sortable: true },
  { key: 'status', label: 'Status', sortable: true },
  { key: 'date', label: 'Opened / target', sortable: true },
  { key: 'scale', label: 'Scale' },
  { key: 'sources', label: 'Evidence' },
];

// ---- stats ----
const stats = [
  { label: 'new flagship clubs in 2026', value: '3', tone: 'green', sub: 'IAH · IAD · SFO' },
  { label: 'new club space this year', value: '~119k', tone: 'amber', sub: 'sq ft — IAH 54k + IAD 40k + SFO 25k' },
  { label: 'new gates targeted fall 2026', value: '36', sub: '22 at IAH · 14 at IAD' },
  { label: 'largest club, once IAH opens', value: '54,000', sub: 'sq ft — DEN holds the title today' },
];

// ---- FAQ ----
const faq = [
  {
    question: 'When does the new United Club at Houston (IAH) open?',
    answer:
      'United has committed to "by the end of 2026." The 54,000 sq ft club rides on the new Terminal B North Concourse, targeted for fall 2026 — if the concourse slips, the club slips.',
  },
  {
    question: 'What is the largest United Club?',
    answer:
      'Today: the ~35,000 sq ft United Club B-East in Denver. Once Houston’s Terminal B club opens, that crown moves to IAH at 54,000 sq ft — likely the largest airline-branded lounge in the country.',
  },
  {
    question: 'What is United building at Washington Dulles?',
    answer:
      'A new 14-gate, 435,000 sq ft Concourse E (built by the airports authority, occupied entirely by United) with a ~40,000 sq ft flagship United Club above the AeroTrain station — both targeting fall 2026. Behind it sits the $20B+ Dulles master plan unveiled in July 2026, a decade-long rebuild that includes plans for one of the largest United Polaris lounges in the world.',
  },
  {
    question: 'Is United building anything at LAX?',
    answer:
      'Not right now. United’s Terminal 7/8 rebuild wrapped in 2019, and LAX is not on United’s 2026 club list. The active construction at LAX is the airport’s people mover, whose east station serves United’s terminals.',
  },
  {
    question: 'When does the Denver Polaris Lounge open?',
    answer:
      'Unknown. United announced it in May 2023 as coming "in a couple of years," and as of mid-2026 has said only that design work started. No date, no size, no construction — which is why this tracker files it as announced, not under construction.',
  },
];

const canonical = 'https://theblueboard.co/trackers/united-hubs';
const ogImage = 'https://theblueboard.co/og/og-tracker-united-hubs.jpg';

// `Breadcrumbs` emits the BreadcrumbList; this page adds the FAQPage and the Dataset.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'United Airlines hub construction projects — clubs, terminals, gates',
  description:
    'Every tracked United Airlines ground-infrastructure project across its eight hubs, with status (open / under construction / announced / rumored), dates, sizes, costs, and sources.',
  url: canonical,
  dateModified: unitedHubsMeta.lastVerified,
  creator: { '@type': 'Organization', name: 'The Blue Board', url: 'https://theblueboard.co' },
  spatialCoverage: 'United States and Guam',
  keywords: ['United Airlines hubs', 'United Club construction', 'airport terminals', 'airport gates'],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: 'https://theblueboard.co/trackers/united-hubs.csv',
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://theblueboard.co/trackers/united-hubs.json',
    },
  ],
};

const jumpLinkClass =
  'inline-flex min-h-11 items-center rounded-full border border-border bg-card px-3.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-muted-foreground transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground';
const proseClass =
  'mb-3 max-w-2xl text-sm leading-relaxed text-muted-foreground last:mb-0 [&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/40 [&_a]:underline-offset-2 [&_a:hover]:decoration-primary';
const subheadClass = 'mt-4.5 mb-2 text-sm font-semibold text-primary';
const methodClass = 'mt-3.5 max-w-2xl text-[11px] leading-relaxed text-muted-foreground';
const chipClass =
  'rounded-sm border border-border px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground';
---

<BaseLayout
  title={trackerParentSeo['united-hubs'].title}
  description={trackerParentSeo['united-hubs'].description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={[faqSchema, datasetSchema]}
  dataAttrs={{ 'data-trk-page': 'united-hubs' }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Trackers', href: '/trackers' }, { label: 'United Hubs' }]} />

    <header class="mt-6">
      <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400">
        Tracker &middot; United Ground Buildout
      </div>
      <h1 class="mt-0.5 mb-1.5 text-lg font-bold tracking-tight text-balance text-foreground sm:text-2xl">
        What's Changing at United's Hubs?
      </h1>
      <p class="mb-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        United is in the middle of its biggest ground-infrastructure buildout ever — new
        concourses, new gates, and the largest clubs it has ever opened. Here's every project at
        all eight hubs, with honest labels for what's under construction, what's merely
        announced, and what a CEO teased once at a press roundtable.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <LastUpdated iso={unitedHubsMeta.lastUpdated} />
        <LastUpdated iso={unitedHubsMeta.lastVerified} prefix="Verified" />
      </div>
      <nav class="mt-4.5 mb-1.5 flex flex-wrap gap-2" aria-label="Section navigation">
        <a href="#map" class={jumpLinkClass}>The map</a>
        <a href="#check" class={jumpLinkClass}>Check your hub</a>
        <a href="#hubs" class={jumpLinkClass}>Hub by hub</a>
        <a href="#all" class={jumpLinkClass}>All projects</a>
        <a href="#why" class={jumpLinkClass}>Why</a>
        <a href="#club-math" class={jumpLinkClass}>Club math</a>
        <a href="#faq" class={jumpLinkClass}>Quick answers</a>
        <a href="#changelog" class={jumpLinkClass}>Changelog</a>
      </nav>
    </header>

    <TrackerPulse
      slug="united-hubs"
      kind="hub"
      lastUpdated={unitedHubsMeta.lastUpdated}
      lastVerified={unitedHubsMeta.lastVerified}
      changes={unitedHubsMeta.changelog}
      entities={hubPulseEntities}
    />

    <section class="mb-10" aria-label="Headline numbers">
      <StatStrip stats={stats} />
    </section>

    <section class={SECTION} id="map">
      <h2 class={SECTION_H2}>The map: where the work is</h2>
      <TrackerMap
        paths={paths}
        points={mapPoints}
        legend={legend}
        offMap={offMap}
        ariaLabel="US map of United's eight hubs, marked by construction activity. Full details in the hub sections below."
        hint="Hover or tap a hub for its summary — full breakdown below"
      />
    </section>

    <section class={SECTION} id="check">
      <h2 class={SECTION_H2}>Check your hub</h2>
      <TrackerSearch
        label="Search hubs and projects"
        noun="projects"
        placeholder="Hub code, city, or project — try IAH, Dulles, Polaris&hellip;"
        emptyTitle="No matching project"
        emptyBody="No tracked project matches that. United's hubs are IAH, IAD, SFO, DEN, ORD, EWR, LAX, and GUM — if something's under construction at one of them and missing here, it either isn't United's project or it hasn't been announced."
      />
    </section>

    <section class={SECTION} id="hubs" aria-label="Projects by hub">
      <h2 class={SECTION_H2}>Hub by hub</h2>
      {
        hubOrder.map((code) => {
          const h = unitedHubs[code];
          const projects = projectsByHub[code];
          return (
            <div class="mb-7" id={`hub-${code.toLowerCase()}`} data-trk-group>
              <div class="mb-3 flex flex-wrap items-baseline gap-2.5 border-b border-border pb-1.5">
                <span class="font-mono text-[15px] font-bold text-primary">{code}</span>
                <a
                  class="text-sm font-semibold text-foreground underline-offset-2 hover:underline"
                  href={`/trackers/united-hubs/${code.toLowerCase()}`}
                >
                  {h.name}
                </a>
                <span class="font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground">
                  {h.city}, {h.state} · {projects.length}{' '}
                  {projects.length === 1 ? 'project' : 'projects'}
                </span>
                {atcCodes.has(code) && (
                  <a
                    class="inline-flex min-h-11 basis-full items-center font-mono text-[9px] font-semibold uppercase tracking-wide text-primary underline-offset-2 hover:underline sm:ml-auto sm:basis-auto"
                    href={`/trackers/atc/${code.toLowerCase()}`}
                  >
                    also in the FAA paper-strips rollout &rarr;
                  </a>
                )}
              </div>
              {h.quietNote && (
                <p class="mb-2.5 max-w-2xl text-xs italic text-muted-foreground">{h.quietNote}</p>
              )}
              <div class="grid gap-3 sm:grid-cols-[repeat(auto-fill,minmax(280px,1fr))]">
                {projects.map((p) => {
                  const s = STATUS[p.status];
                  return (
                    <article
                      class="rounded-md border border-border bg-card px-4 py-3.5 transition-colors hover:border-primary"
                      data-trk-row
                      data-trk-count-item
                      data-trk-search-text={`${p.hub} ${h.city} ${h.state} ${h.searchAlias ?? ''} ${h.name} ${p.name} ${typeLabelFor(p)} ${s.label}`.toLowerCase()}
                      id={p.id}
                    >
                      <div class="mb-2 flex flex-wrap gap-1.5">
                        <span class={chipClass}>{typeLabelFor(p)}</span>
                        <StatusBadge label={s.label} tone={s.tone} glyph={s.glyph} />
                        {p.builder !== 'united' && (
                          <span class:list={[chipClass, 'border-dashed']}>
                            {p.builder === 'joint' ? 'joint build' : 'airport builds'}
                          </span>
                        )}
                      </div>
                      <div class="mb-1 text-sm font-bold text-foreground">{p.name}</div>
                      {metaLineFor(p) && (
                        <div class="mb-1.5 font-mono text-[10px] font-semibold tracking-wide text-amber-400">
                          {metaLineFor(p)}
                        </div>
                      )}
                      <p class="text-xs leading-relaxed text-muted-foreground">{p.details}</p>
                      <SourceDisclosure
                        sources={p.sources}
                        verified={unitedHubsMeta.lastVerified}
                        entryId={p.id}
                        entryLabel={`${p.hub} · ${p.name}`}
                        shareHref={`/trackers/united-hubs#${p.id}`}
                      />
                    </article>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </section>

    <section class={SECTION} id="all">
      <h2
        class={SECTION_H2}
        data-trk-result-heading
        data-trk-heading-all="All projects, one table"
        data-trk-heading-noun="project"
      >
        All projects, one table
      </h2>
      <TrackerTable caption="All tracked United hub projects" columns={columns} rows={tableRows} />
      <p class={methodClass}>
        "Airport builds" marks projects funded and built by the airport authority — MWAA at
        Dulles, Houston Airports, Chicago's aviation department, the Port Authority at Newark,
        LAWA, and DEN — where United is the tenant or a funding partner, not the builder. They're
        tracked here because they change your trip, but the credit (and the schedule risk)
        belongs to the airport.
      </p>
    </section>

    <section class={SECTION} id="why">
      <h2 class={SECTION_H2}>Why United is doing this</h2>
      <p class={proseClass}>
        Start with the quote. Asked about lounge size at an April 2026 press roundtable, CEO
        Scott Kirby told reporters:
        <a href="https://thepointsguy.com/news/united-airlines-lounge-plans-2026/">"I want them to build a club that is oversized. That we look at it and say, 'That club is too big.'"</a>
        He added that it keeps not happening: "I've now been told seven or eight times, 'This one
        is going to be the one.' It's never true." That is the buildout in one anecdote — United
        says it came out of the pandemic with 49% more club space than it had before 2020, and
        it still can't build ahead of demand.
      </p>
      <p class={proseClass}>
        The demand side is deliberate. Under United Next, premium seats per North American
        departure are
        <a href="https://united.mediaroom.com/2026-03-24-United-to-Add-250-Planes-in-Next-Two-Years-Most-by-Any-Airline-Includes-New,-Premium-Customer-Experiences,-Aircraft-Variants,-Subfleet,-Seats-and-Amenities">up 40% since 2021</a>,
        and every one of those seats comes with lounge expectations. Crowding is the metric the
        executives themselves use: no survey ranks it, but United's commercial chief Andrew
        Nocella defined success as the day the <em>"no one-day passes"</em> sign disappears from
        club doors. The squeeze also shows up in policy: membership went two-tier with higher
        fees in March 2025, and in April 2026 United quietly cut Polaris Lounge access for most
        Star Alliance partners.
      </p>
      <p class={proseClass}>
        Competition is real too. Delta's flagship
        <a href="https://news.delta.com/delta-deepens-investment-lax-phase-1-second-delta-one-lounge-now-open">Delta One Lounge at JFK</a>
        runs about 40,000 sq ft — the number Houston's 54,000 was built to beat — and Amex keeps
        expanding Centurion. In the hub-lounge arms race, "largest in America" is a marketing
        asset with a construction schedule attached.
      </p>
      <h3 class={subheadClass}>Who's actually paying</h3>
      <p class={proseClass}>
        Read the badges carefully: much of this buildout rides on airport capital programs.
        MWAA is building Dulles' Concourse E; Houston is a partner on Terminal B; Chicago's
        aviation department builds the O'Hare satellites with airline money flowing through
        rates; the Port Authority owns everything moving at Newark. United's own capital is
        concentrated where its brand lives — the clubs — plus the lion's share of Houston's
        Terminal B. When an airport builds, the schedule risk is the airport's too.
      </p>
      <h3 class={subheadClass}>The honest read</h3>
      <p class={proseClass}>
        Dates slip, and teases are not commitments. The Denver Polaris Lounge was announced in
        May 2023 as <em>"a couple of years"</em> out and still has no date. The original Polaris
        lounge rollout missed its published schedule at every single hub. O'Hare's Global
        Terminal was announced in 2018 for 2026 and now reads 2032 — construction hasn't
        started. Kirby's "even bigger" second Dulles lounge is the live case study: teased as
        one sentence at an April 2026 roundtable, it graduated to the official Dulles master
        plan in July — as a Polaris, with still no size or date. That's why every project here
        carries one of four labels — open, under construction, announced, rumored — and why
        <em>announced without a date</em> is treated as a promise, not a plan.
      </p>
    </section>

    <section
      class="mb-10 rounded-r-md border border-border border-l-[3px] border-l-amber-400 bg-card px-5 py-4.5"
      id="club-math"
      aria-label="Club math"
    >
