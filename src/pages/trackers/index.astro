---
import { trackers, trackerOrder } from '../../data/trackers/index.js';
import { trackerParentSeo } from '../../lib/tracker-detail.js';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import LastUpdated from '../../components/trackers/LastUpdated.astro';
import { TONE_BAR, toneClass } from '../../components/trackers/tones';

const canonical = 'https://theblueboard.co/trackers';
const ogImage = 'https://theblueboard.co/og/og-trackers.jpg';
const fmtShort = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

// `Breadcrumbs` emits the BreadcrumbList — this page adds only the ItemList.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: trackerOrder.map((slug, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: trackers[slug].name,
    url: `https://theblueboard.co${trackers[slug].href}`,
  })),
};
---

<BaseLayout
  title={trackerParentSeo.index.title}
  description={trackerParentSeo.index.description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={[itemListSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Trackers' }]} />

    <header class="mt-6">
      <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400">
        Living Pages
      </div>
      <h1 class="mt-0.5 mb-1.5 text-lg font-bold tracking-tight text-balance text-foreground sm:text-2xl">
        Trackers
      </h1>
      <p class="mb-7 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Aviation's biggest stories don't happen in a news cycle — they happen over years, one
        airport at a time. Trackers are living pages that follow them: a map, the real numbers, a
        searchable table of every site, and a changelog. Updated monthly.
      </p>
    </header>

    <div class="mb-10 grid gap-3.5 sm:grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
      {
        trackerOrder.map((slug) => {
          const t = trackers[slug];
          return (
            <a
              class="block rounded-r-md border border-border border-l-[3px] border-l-amber-400 bg-card px-5 py-4.5 text-foreground transition-colors hover:border-primary hover:border-l-amber-400"
              href={t.href}
            >
              <div class="mb-2 font-mono text-[9px] font-semibold uppercase tracking-widest text-amber-400">
                {t.name}
              </div>
              <div class="mb-1.5 text-[15px] font-bold text-foreground">{t.question}</div>
              <p class="mb-3 text-xs leading-relaxed text-muted-foreground">{t.description}</p>
              <div
                class="my-3.5 grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-1 border-y border-border py-2.5"
                aria-label={`${t.metric}. ${t.segments.map((s) => `${s.count} ${s.label}`).join(', ')}`}
              >
                <div class="whitespace-nowrap font-mono text-sm font-bold text-foreground">
                  {t.metric}
                </div>
                <div class="flex h-2 min-w-0 gap-0.5" aria-hidden="true">
                  {t.segments.map((segment) => (
                    <span
                      class:list={['min-w-0.5 rounded-xs', toneClass(TONE_BAR, segment.tone)]}
                      style={`flex:${segment.count}`}
                    />
                  ))}
                </div>
                <div
                  class="col-start-2 flex flex-wrap gap-2 font-mono text-[8px] uppercase text-muted-foreground"
                  aria-hidden="true"
                >
                  {t.segments.map((segment) => (
                    <span>
                      {segment.count} {segment.label}
                    </span>
                  ))}
                </div>
              </div>
              <div class="mb-3 text-[10px] leading-normal text-muted-foreground">
                <strong class="font-mono text-[8px] font-semibold uppercase tracking-wide text-amber-400">
                  Latest · {fmtShort(t.latestChange.date)}
                </strong>
                <br />
                {t.latestChange.entry}
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2.5 font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground">
                <span>
                  {t.entryCount} {t.entryNoun} ·{' '}
                  <LastUpdated iso={t.lastVerified} prefix="verified" />
                </span>
                <span class="text-primary">Open tracker &rarr;</span>
              </div>
            </a>
          );
        })
      }
    </div>

    <section class="border-t border-border pt-6">
      <h2 class="mb-3.5 border-b border-border pb-1.5 text-base font-bold tracking-tight text-foreground">
        What a tracker is
      </h2>
      <p class="max-w-2xl text-xs leading-relaxed text-muted-foreground">
        Every entry cites a source — an FAA audit, an airline press release, an airport
        authority's own numbers. Where an agency publishes no date, the tracker says so instead
        of guessing. Where a claim traces to one press release, it's attributed, not asserted.
        When something changes, the changelog records it. Screenshot freely; the data underneath
        is versioned.
      </p>
    </section>
  </div>
</BaseLayout>
