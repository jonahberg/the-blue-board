    <link rel="preload" href="/fonts/satoshi-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />

    <style is:inline>
      @font-face{font-family:'Satoshi';font-style:normal;font-weight:300 900;font-display:swap;src:url(/fonts/satoshi-latin.woff2) format('woff2')}
      @font-face{font-family:'DM Sans';font-style:normal;font-weight:100 900;font-display:swap;src:url(/fonts/dm-sans-latin.woff2) format('woff2')}
      @font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:100 800;font-display:swap;src:url(/fonts/jetbrains-mono-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      *{margin:0;padding:0;box-sizing:border-box}
      :root{--ua-blue:#005DAA;--ua-dark:#0B1018;--ua-panel:#111A27;--ua-panel-elevated:#152032;--ua-border:#1E2940;--ua-border-subtle:#172236;--ua-text:#E2E8F0;--ua-muted:#94A3B8;--ua-dim:#7C8DA6;--ua-accent:#6BAAED;--ua-amber:#C4A35A;--ua-amber-soft:rgba(196,163,90,.12);--ua-blue-soft:rgba(0,93,170,.12);--ua-green:#22C55E;--ua-yellow:#EAB308;--ua-red:#EF4444;--font-display:'Satoshi',system-ui,-apple-system,sans-serif;--font-ui:'DM Sans',system-ui,-apple-system,sans-serif;--font-mono:'JetBrains Mono',monospace}
      body{background:var(--ua-dark);color:var(--ua-text);font-family:var(--font-ui);font-size:13px;line-height:1.7;min-height:100vh}
      h1,h2,h3,h4,h5,h6{font-family:var(--font-display)}
      a{color:var(--ua-accent);text-decoration:none}
      a:hover{text-decoration:underline}
      .trk-section p a,.trk-section li a{text-decoration:underline;text-decoration-color:rgba(107,170,237,.4);text-underline-offset:2px}
      .trk-section p a:hover,.trk-section li a:hover{text-decoration-color:var(--ua-accent)}
      .container{max-width:900px;margin:0 auto;padding:20px 16px}
      .trk-nav{font-family:var(--font-display);font-size:11px;font-weight:500;color:var(--ua-muted);margin-bottom:16px}
      .trk-header h1{font-size:22px;font-weight:700;letter-spacing:-.5px;text-wrap:balance;margin:2px 0 6px}
      .trk-kicker{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--ua-amber)}
      .trk-subtitle{font-size:13px;color:var(--ua-muted);max-width:680px;margin-bottom:10px}
      .trk-jump{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 6px}
      .trk-jump a{font-family:var(--font-mono);font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--ua-muted);background:var(--ua-panel);border:1px solid var(--ua-border);border-radius:20px;padding:6px 14px;transition:all .15s ease}
      .trk-jump a:hover{color:#fff;border-color:var(--ua-blue);background:var(--ua-blue);text-decoration:none;transform:translateY(-1px);box-shadow:0 2px 8px rgba(0,93,170,.3)}
      .trk-section{margin-bottom:40px;padding-top:24px;border-top:1px solid var(--ua-border)}
      .trk-section:first-of-type{border-top:none;padding-top:0}
      .trk-section h2{font-size:16px;font-weight:700;padding-bottom:6px;border-bottom:1px solid var(--ua-border);margin-bottom:14px}
      .trk-section h3{font-size:13px;font-weight:600;color:var(--ua-accent);margin:18px 0 8px}
      .trk-section p{max-width:680px;margin-bottom:12px}
      .trk-section p:last-child{margin-bottom:0}
      .trk-aside{background:linear-gradient(180deg,var(--ua-panel) 0%,rgba(17,26,39,.6) 100%);border:1px solid var(--ua-border);border-left:3px solid var(--ua-amber);border-radius:0 6px 6px 0;padding:18px 20px;margin-bottom:40px}
      .trk-aside h2{font-size:16px;font-weight:700;margin-bottom:12px;border:none;padding:0}
      .trk-aside p{font-size:13px;max-width:680px;margin-bottom:12px}
      .trk-aside p:last-child{margin-bottom:0}
      .trk-aside-kicker{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--ua-amber);margin-bottom:4px}
      .trk-faq-q{font-family:var(--font-display);font-size:13px;font-weight:600;color:var(--ua-text);margin:14px 0 4px}
      .trk-faq-a{font-size:12px;color:var(--ua-muted);max-width:680px;line-height:1.7}
      .trk-method{font-size:11px;color:var(--ua-dim);max-width:680px;line-height:1.7;margin-top:14px}
      .trk-updated-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
      @media (max-width:600px){.trk-header h1{font-size:18px}}
      @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
    </style>
