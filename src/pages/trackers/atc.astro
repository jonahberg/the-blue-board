---
import outline from '../../data/trackers/us-outline.json';
import { atcMeta, atcAirports } from '../../data/trackers/atc.js';
import { unitedHubs } from '../../data/trackers/united-hubs.js';
import { projectPoint, outlinePaths } from '../../lib/tracker-map.js';
import StatStrip from '../../components/trackers/StatStrip.astro';
import TrackerMap from '../../components/trackers/TrackerMap.astro';
import TrackerSearch from '../../components/trackers/TrackerSearch.astro';
import TrackerTable from '../../components/trackers/TrackerTable.astro';
import Changelog from '../../components/trackers/Changelog.astro';
import LastUpdated from '../../components/trackers/LastUpdated.astro';
import CrossLink from '../../components/trackers/CrossLink.astro';
import Footer from '../../components/Footer.astro';
import VercelSpeedInsights from '../../components/VercelSpeedInsights.astro';

const paths = outlinePaths(outline);

// ---- status vocabulary (color + shape + label — never color alone) ----
const STATUS = {
  live: { label: 'Live', tone: 'green', glyph: '●', shape: 'dot', rank: 0 },
  'in-progress': { label: 'In progress', tone: 'yellow', glyph: '●', shape: 'dot', rank: 1 },
  planned: { label: 'Scheduled', tone: 'yellow', glyph: '◆', shape: 'diamond', rank: 2 },
  paper: { label: 'On paper', tone: 'dim', glyph: '○', shape: 'ring', rank: 3 },
};

const fmtDate = (d) => {
  if (!d) return '';
  const opts =
    d.length === 7
      ? { year: 'numeric', month: 'short' }
      : { year: 'numeric', month: 'short', day: 'numeric' };
  return new Date((d.length === 7 ? d + '-15' : d) + 'T12:00:00Z').toLocaleDateString('en-US', opts);
};

const liveCount = atcAirports.filter((a) => a.status === 'live').length;
const plannedCount = atcAirports.filter((a) => a.status === 'planned').length;
const paperNoDateCount = atcAirports.filter((a) => a.status === 'paper').length;
const stillOnPaper = atcAirports.length - liveCount;
const hubCodes = new Set(Object.keys(unitedHubs));

// ---- map ----
const mapPoints = [];
const offMap = [];
for (const a of atcAirports) {
  const s = STATUS[a.status];
  const badge = { label: s.label, tone: s.tone, glyph: s.glyph };
  const dateLine =
    a.status === 'live'
      ? a.goLiveDate
        ? `Off paper since ${fmtDate(a.goLiveDate)}.`
        : 'Live — the FAA hasn’t published the cutover date.'
      : a.status === 'planned'
        ? `${fmtDate(a.plannedIoc)} in the FAA’s 2023 schedule — sequencing, not a promise.`
        : 'In the program, no published date.';
  const p = projectPoint(a.lng, a.lat);
  if (!p) {
    offMap.push({ title: `${a.code} — ${a.city}, ${a.state}`, badge });
    continue;
  }
  mapPoints.push({
    id: a.id,
    code: a.code,
    x: p.x,
    y: p.y,
    shape: s.shape,
    tone: s.tone,
    card: {
      title: `${a.code} — ${a.name}`,
      badge,
      line1: `${a.city}, ${a.state} · ${dateLine}`,
      line2: a.note ?? '',
    },
  });
}

const legend = [
  { label: 'Live on electronic strips', shape: 'dot', tone: 'green' },
  { label: 'In the FAA’s schedule', shape: 'diamond', tone: 'yellow' },
  { label: 'Still on paper, no date', shape: 'ring', tone: 'dim' },
];

// ---- table ----
const sortedAirports = [...atcAirports].sort(
  (a, b) =>
    STATUS[a.status].rank - STATUS[b.status].rank ||
    (a.goLiveDate ?? a.plannedIoc ?? '9999').localeCompare(b.goLiveDate ?? b.plannedIoc ?? '9999') ||
    a.code.localeCompare(b.code)
);

const tableRows = sortedAirports.map((a) => {
  const s = STATUS[a.status];
  const dateCell =
    a.status === 'live'
      ? a.goLiveDate
        ? { primary: fmtDate(a.goLiveDate), mono: true, sortVal: a.goLiveDate }
        : { primary: '—', secondary: 'unpublished', dim: true, sortVal: '' }
      : a.status === 'planned'
        ? { primary: fmtDate(a.plannedIoc), secondary: '2023 plan', dim: true, mono: true, sortVal: a.plannedIoc }
        : { primary: '—', dim: true, sortVal: '' };
  return {
    id: a.id,
    searchText: `${a.code} ${a.name} ${a.city} ${a.state} ${s.label}`.toLowerCase(),
    cells: {
      airport: { primary: a.code, mono: true, secondary: a.name, sortVal: a.code },
      location: { primary: `${a.city}, ${a.state}`, sortVal: `${a.state} ${a.city}` },
      status: { badge: { label: s.label, tone: s.tone, glyph: s.glyph }, sortVal: String(s.rank) },
      date: dateCell,
      notes: {
        secondary: a.note ?? '',
        ...(hubCodes.has(a.code)
          ? { link: { href: `/trackers/united-hubs#hub-${a.code.toLowerCase()}`, text: 'United hub →' } }
          : {}),
      },
    },
  };
});

const columns = [
  { key: 'airport', label: 'Airport', sortable: true },
  { key: 'location', label: 'Location', sortable: true },
  { key: 'status', label: 'Status', sortable: true },
  { key: 'date', label: 'Went digital', sortable: true },
  { key: 'notes', label: 'Notes' },
];

// ---- stats ----
const stats = [
  { label: 'towers live on digital strips', value: String(liveCount), tone: 'green', sub: 'of 89 in the program' },
  { label: 'still on paper today', value: String(stillOnPaper), tone: 'amber', sub: `${plannedCount} scheduled · ${paperNoDateCount} no date` },
  { label: 'copper→fiber rebuild done', value: atcMeta.stats.fiber.value, sub: 'as of May 2026' },
  { label: 'FAA target for all 89', value: atcMeta.stats.target.value, sub: 'IG estimated 2030 — for fewer' },
];

// ---- FAQ (visible section and JSON-LD stay identical) ----
const liveCodes = atcAirports.filter((a) => a.status === 'live').map((a) => a.code).join(', ');
const faq = [
  {
    question: 'What are paper flight strips?',
    answer:
      'Strips of paper, about 1x8 inches, printed for every flight and annotated by hand as controllers work the aircraft. They are physically passed between positions in plastic holders. Most US airport towers still use them in 2026.',
  },
  {
    question: 'Which airports already use electronic flight strips?',
    answer: `${liveCount} airports are live on the FAA's TFDM system as of ${fmtDate(atcMeta.lastUpdated)}: ${liveCodes}.`,
  },
  {
    question: 'When will my airport stop using paper?',
    answer:
      'The FAA’s stated target is all 89 program airports by 2028. The last published airport-by-airport schedule dates to 2023 and has been resequenced repeatedly, so per-airport dates are indicative at best — this tracker shows the latest verified status for each airport.',
  },
  {
    question: 'What is TFDM?',
    answer:
      'Terminal Flight Data Manager, built by Leidos — the FAA program replacing paper strips with electronic flight data displays, plus surface-management tools that meter taxi-out queues at the biggest airports.',
  },
  {
    question: 'Why did Washington National get upgraded early?',
    answer:
      'DCA sat at slot #40 in the FAA’s 2023 plan with a July 2028 date, and went live in February 2026 — the program’s showcase acceleration after the 2025 funding surge.',
  },
];

const canonical = 'https://theblueboard.co/trackers/atc';
const ogImage = 'https://theblueboard.co/og/og-tracker-atc.jpg';
---

