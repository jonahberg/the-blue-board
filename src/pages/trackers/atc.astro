---
import outline from '../../data/trackers/us-outline.json';
import { atcMeta, atcAirports } from '../../data/trackers/atc.js';
import { unitedHubs } from '../../data/trackers/united-hubs.js';
import { projectPoint, outlinePaths } from '../../lib/tracker-map.js';
import { trackerParentSeo } from '../../lib/tracker-detail.js';
import StatStrip from '../../components/trackers/StatStrip.astro';
import TrackerMap from '../../components/trackers/TrackerMap.astro';
import TrackerSearch from '../../components/trackers/TrackerSearch.astro';
import TrackerTable from '../../components/trackers/TrackerTable.astro';
import Changelog from '../../components/trackers/Changelog.astro';
import LastUpdated from '../../components/trackers/LastUpdated.astro';
import CrossLink from '../../components/trackers/CrossLink.astro';
import TrackerPulse from '../../components/trackers/TrackerPulse.astro';
import TrackerDataActions from '../../components/trackers/TrackerDataActions.astro';
import BaseLayout from '../../components/site/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import { SECTION, SECTION_H2 } from '../../components/trackers/detail';

const paths = outlinePaths(outline);

// ---- status vocabulary (color + shape + label — never color alone) ----
const STATUS = {
  live: { label: 'Live', tone: 'green', glyph: '●', shape: 'dot', rank: 0 },
  'in-progress': { label: 'In progress', tone: 'yellow', glyph: '●', shape: 'dot', rank: 1 },
  planned: { label: 'Scheduled', tone: 'yellow', glyph: '◆', shape: 'diamond', rank: 2 },
  paper: { label: 'On paper', tone: 'dim', glyph: '○', shape: 'ring', rank: 3 },
};

const fmtDate = (d) => {
  if (!d) return '';
  const opts =
    d.length === 7
      ? { year: 'numeric', month: 'short' }
      : { year: 'numeric', month: 'short', day: 'numeric' };
  return new Date((d.length === 7 ? d + '-15' : d) + 'T12:00:00Z').toLocaleDateString('en-US', opts);
};

const liveCount = atcAirports.filter((a) => a.status === 'live').length;
const plannedCount = atcAirports.filter((a) => a.status === 'planned').length;
const paperNoDateCount = atcAirports.filter((a) => a.status === 'paper').length;
const stillOnPaper = atcAirports.length - liveCount;
const hubCodes = new Set(Object.keys(unitedHubs));
const atcPulseEntities = Object.fromEntries(
  atcAirports.map((a) => {
    const status = STATUS[a.status].label.toLowerCase();
    const timing =
      a.status === 'live' && a.goLiveDate
        ? ` since ${fmtDate(a.goLiveDate)}`
        : a.status === 'planned'
          ? ` · ${fmtDate(a.plannedIoc)} in the FAA's 2023 sequence`
          : '';
    return [
      a.code,
      {
        label: `${a.code} · ${a.city}`,
        summary: `${status}${timing}. ${a.note ?? ''}`.trim(),
        href: `/trackers/atc#row-${a.id}`,
      },
    ];
  })
);

// ---- map ----
const mapPoints = [];
const offMap = [];
for (const a of atcAirports) {
  const s = STATUS[a.status];
  const badge = { label: s.label, tone: s.tone, glyph: s.glyph };
  const dateLine =
    a.status === 'live'
      ? a.goLiveDate
        ? `Off paper since ${fmtDate(a.goLiveDate)}.`
        : 'Live — the FAA hasn’t published the cutover date.'
      : a.status === 'planned'
        ? `${fmtDate(a.plannedIoc)} in the FAA’s 2023 schedule — sequencing, not a promise.`
        : 'In the program, no published date.';
  const p = projectPoint(a.lng, a.lat);
  if (!p) {
    offMap.push({ title: `${a.code} — ${a.city}, ${a.state}`, badge });
    continue;
  }
  mapPoints.push({
    id: a.id,
    code: a.code,
    x: p.x,
    y: p.y,
    shape: s.shape,
    tone: s.tone,
    card: {
      title: `${a.code} — ${a.name}`,
      badge,
      line1: `${a.city}, ${a.state} · ${dateLine}`,
      line2: a.note ?? '',
    },
  });
}

const legend = [
  { label: 'Live on electronic strips', shape: 'dot', tone: 'green' },
  { label: 'In the FAA’s schedule', shape: 'diamond', tone: 'yellow' },
  { label: 'Still on paper, no date', shape: 'ring', tone: 'dim' },
];

// ---- table ----
const sortedAirports = [...atcAirports].sort(
  (a, b) =>
    STATUS[a.status].rank - STATUS[b.status].rank ||
    (a.goLiveDate ?? a.plannedIoc ?? '9999').localeCompare(b.goLiveDate ?? b.plannedIoc ?? '9999') ||
    a.code.localeCompare(b.code)
);

const tableRows = sortedAirports.map((a) => {
  const s = STATUS[a.status];
  const dateCell =
    a.status === 'live'
      ? a.goLiveDate
        ? { primary: fmtDate(a.goLiveDate), mono: true, sortVal: a.goLiveDate }
        : { primary: '—', secondary: 'unpublished', dim: true, sortVal: '' }
      : a.status === 'planned'
        ? { primary: fmtDate(a.plannedIoc), secondary: '2023 plan', dim: true, mono: true, sortVal: a.plannedIoc }
        : { primary: '—', dim: true, sortVal: '' };
  return {
    id: a.id,
    searchText: `${a.code} ${a.name} ${a.city} ${a.state} ${s.label}`.toLowerCase(),
    cells: {
      airport: {
        primary: a.code,
        mono: true,
        secondary: a.name,
        sortVal: a.code,
        ...(hubCodes.has(a.code)
          ? { link: { href: `/trackers/atc/${a.code.toLowerCase()}`, text: `${a.code} status →` } }
          : {}),
      },
      location: { primary: `${a.city}, ${a.state}`, sortVal: `${a.state} ${a.city}` },
      status: { badge: { label: s.label, tone: s.tone, glyph: s.glyph }, sortVal: String(s.rank) },
      date: dateCell,
      notes: {
        secondary: a.note ?? '',
        ...(hubCodes.has(a.code)
          ? { link: { href: `/trackers/united-hubs/${a.code.toLowerCase()}`, text: 'United hub →' } }
          : {}),
      },
      sources: {
        evidence: {
          sources: a.sources,
          verified: atcMeta.lastVerified,
          entryId: a.id,
          entryLabel: `${a.code} · ${a.name}`,
          shareHref: `/trackers/atc#row-${a.id}`,
        },
      },
    },
  };
});

const columns = [
  { key: 'airport', label: 'Airport', sortable: true },
  { key: 'location', label: 'Location', sortable: true },
  { key: 'status', label: 'Status', sortable: true },
  { key: 'date', label: 'Went digital', sortable: true },
  { key: 'notes', label: 'Notes' },
  { key: 'sources', label: 'Evidence' },
];

// ---- stats ----
const stats = [
  { label: 'towers live on digital strips', value: String(liveCount), tone: 'green', sub: 'of 89 in the program' },
  { label: 'still on paper today', value: String(stillOnPaper), tone: 'amber', sub: `${plannedCount} scheduled · ${paperNoDateCount} no date` },
  { label: 'copper→fiber rebuild done', value: atcMeta.stats.fiber.value, sub: 'as of May 2026' },
  { label: 'FAA target for all 89', value: atcMeta.stats.target.value, sub: 'IG estimated 2030 — for fewer' },
];

// ---- FAQ (visible section and JSON-LD stay identical) ----
const liveCodes = atcAirports.filter((a) => a.status === 'live').map((a) => a.code).join(', ');
const faq = [
  {
    question: 'What are paper flight strips?',
    answer:
      'Strips of paper, about 1x8 inches, printed for every flight and annotated by hand as controllers work the aircraft. They are physically passed between positions in plastic holders. Most US airport towers still use them in 2026.',
  },
  {
    question: 'Which airports already use electronic flight strips?',
    answer: `${liveCount} airports are live on the FAA's TFDM system as verified ${fmtDate(atcMeta.lastVerified)}: ${liveCodes}.`,
  },
  {
    question: 'When will my airport stop using paper?',
    answer:
      'The FAA’s stated target is all 89 program airports by 2028. The last published airport-by-airport schedule dates to 2023 and has been resequenced repeatedly, so per-airport dates are indicative at best — this tracker shows the latest verified status for each airport.',
  },
  {
    question: 'What is TFDM?',
    answer:
      'Terminal Flight Data Manager, built by Leidos — the FAA program replacing paper strips with electronic flight data displays, plus surface-management tools that meter taxi-out queues at the biggest airports.',
  },
  {
    question: 'Why did Washington National get upgraded early?',
    answer:
      'DCA sat at slot #40 in the FAA’s 2023 plan with a July 2028 date, and went live in February 2026 — the program’s showcase acceleration after the 2025 funding surge.',
  },
];

const canonical = 'https://theblueboard.co/trackers/atc';
const ogImage = 'https://theblueboard.co/og/og-tracker-atc.jpg';

// `Breadcrumbs` emits the BreadcrumbList; this page adds the FAQPage and the Dataset.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'FAA TFDM electronic flight strips rollout — airport-by-airport status',
  description:
    'Status of all 89 airports in the FAA’s Terminal Flight Data Manager (electronic flight strips) program: live, scheduled, or still on paper, with sourced go-live dates.',
  url: canonical,
  dateModified: atcMeta.lastVerified,
  creator: { '@type': 'Organization', name: 'The Blue Board', url: 'https://theblueboard.co' },
  spatialCoverage: 'United States',
  keywords: ['FAA TFDM', 'electronic flight strips', 'paper flight strips', 'airport modernization'],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: 'https://theblueboard.co/trackers/atc.csv',
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: 'https://theblueboard.co/trackers/atc.json',
    },
  ],
};

const jumpLinkClass =
  'inline-flex min-h-11 items-center rounded-full border border-border bg-card px-3.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-muted-foreground transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground';
const proseClass =
  'mb-3 max-w-2xl text-sm leading-relaxed text-muted-foreground last:mb-0 [&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/40 [&_a]:underline-offset-2 [&_a:hover]:decoration-primary';
const subheadClass = 'mt-4.5 mb-2 text-sm font-semibold text-primary';
const methodClass = 'mt-3.5 max-w-2xl text-[11px] leading-relaxed text-muted-foreground';
---

<BaseLayout
  title={trackerParentSeo.atc.title}
  description={trackerParentSeo.atc.description}
  canonical={canonical}
  ogImage={ogImage}
  ogTitle="Is Your Airport Off Paper Yet? — Modern Skies Tracker"
  ogDescription={`${liveCount} airport towers are off paper flight strips, ${stillOnPaper} to go. The airport-by-airport FAA modernization tracker.`}
  ogImageAlt="Modern Skies Tracker — airports live on digital flight strips vs still on paper"
  twitterDescription={`${liveCount} airport towers off paper, ${stillOnPaper} to go. Check your airport.`}
  jsonLd={[faqSchema, datasetSchema]}
  dataAttrs={{ 'data-trk-page': 'atc' }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Trackers', href: '/trackers' }, { label: 'Modern Skies' }]} />

    <header class="mt-6">
      <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400">
        Tracker &middot; FAA Modernization
      </div>
      <h1 class="mt-0.5 mb-1.5 text-lg font-bold tracking-tight text-balance text-foreground sm:text-2xl">
        Is Your Airport Off Paper Yet?
      </h1>
      <p class="mb-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        Most US airport towers still track your flight on strips of paper, passed by hand. The FAA
        is finally replacing them at 89 airports — this page tracks every one: who's gone digital,
        who's scheduled, and who's still waiting for a date.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <LastUpdated iso={atcMeta.lastUpdated} />
        <LastUpdated iso={atcMeta.lastVerified} prefix="Verified" />
      </div>
      <nav class="mt-4.5 mb-1.5 flex flex-wrap gap-2" aria-label="Section navigation">
        <a href="#map" class={jumpLinkClass}>The map</a>
        <a href="#check" class={jumpLinkClass}>Check your airport</a>
        <a href="#all" class={jumpLinkClass}>All 89 airports</a>
        <a href="#whats-changing" class={jumpLinkClass}>What's changing</a>
        <a href="#paper-strips" class={jumpLinkClass}>Why paper?</a>
        <a href="#faq" class={jumpLinkClass}>Quick answers</a>
        <a href="#changelog" class={jumpLinkClass}>Changelog</a>
      </nav>
    </header>

    <TrackerPulse
      slug="atc"
      kind="airport"
      lastUpdated={atcMeta.lastUpdated}
      lastVerified={atcMeta.lastVerified}
      changes={atcMeta.changelog}
      entities={atcPulseEntities}
    />

    <section class="mb-10" aria-label="Headline numbers">
      <StatStrip stats={stats} />
    </section>

    <section class={SECTION} id="map">
      <h2 class={SECTION_H2}>The map: paper vs. pixels</h2>
      <TrackerMap
        paths={paths}
        points={mapPoints}
        legend={legend}
        offMap={offMap}
        ariaLabel={`US map of the FAA electronic flight strips rollout: ${liveCount} airports live, ${plannedCount} scheduled, ${paperNoDateCount} with no date. Full details in the table below.`}
        hint="Hover or tap a dot for details — full list in the table below"
      />
    </section>

    <section class={SECTION} id="check">
      <h2 class={SECTION_H2}>Check your airport</h2>
      <TrackerSearch
        label="Search the program"
        noun="airports"
        placeholder="Airport code or city — try AUS, O'Hare, Boise&hellip;"
        emptyTitle="Not in the program"
        emptyBody="No match in the FAA's 89-airport electronic-strips program. Smaller towers keep their current systems for now — the program covers the country's busiest airports first, and the FAA hasn't published a plan beyond these 89."
      />
    </section>

    <section class={SECTION} id="all">
      <h2
        class={SECTION_H2}
        data-trk-result-heading
        data-trk-heading-all="All 89 airports"
        data-trk-heading-noun="airport"
      >
        All 89 airports
      </h2>
      <TrackerTable
        caption="FAA TFDM rollout status for all 89 program airports"
        columns={columns}
        rows={tableRows}
      />
      <p class={methodClass}>
        Dates marked <em>2023 plan</em> are the airport's slot in the FAA's last published
        schedule (August 2023, via the DOT Inspector General) — sequencing, not commitments.
        Washington National jumped its slot by two and a half years; Boston's has come and gone.
        Where a live airport shows no date, the FAA never published one: it announces go-lives
        selectively, so this column is built from its audit trail and press coverage.
      </p>
    </section>

    <section class={SECTION} id="whats-changing">
      <h2 class={SECTION_H2}>What's actually changing</h2>
      <p class={proseClass}>
        In July 2025, Congress handed the FAA
        <a href="https://www.aopa.org/news-and-media/all-news/2025/july/10/where-is-the-12-5-billion-for-atc-modernization-going">$12.5 billion</a>
        to modernize air traffic control — new fiber to replace 1970s copper phone lines, new
        radios, new radar, and the end of paper flight strips. Everyone involved calls it a down
        payment: the industry's Modern Skies Coalition — 66 aviation groups —
        <a href="https://ttd.org/policy/letters-to-congress/modern-skies-coalition-urges-congress-to-close-funding-gap-for-brand-new-air-traffic-control-system-bnatcs/">asked Congress for another $20 billion</a>
        in July 2026. That part hasn't been appropriated.
      </p>
      <p class={proseClass}>
        The build is split among a handful of companies.
        <a href="https://www.peraton.com/news/faa-awards-peraton-a-modernization-contract-to-build-the-brand-new-air-traffic-control-system">Peraton</a>
        is the integrator running the overall program — its own contract is
        <a href="https://www.highergov.com/contract/693KA726C00001/">capped at $1.5 billion</a>,
        not the "$12.5 billion" some headlines claimed. L3Harris is rebuilding the network and
        <a href="https://www.l3harris.com/newsroom/editorial/2026/05/l3harris-reaches-over-50-faa-telecommunications-modernization">passed the halfway mark</a>
        in May 2026. RTX and Indra are replacing
        <a href="https://www.flyingmag.com/contractors-replace-1980s-atc-radar/">up to 612 radars</a>
        by June 2028. And Leidos builds the piece this page tracks: TFDM, the system that
        replaces paper strips.
      </p>
      <h3 class={subheadClass}>What a tower actually gets</h3>
      <p class={proseClass}>
        Today, a controller works your flight on a printed strip, marks it in pencil, and walks it
        to the next position. TFDM replaces that with electronic strips on touchscreens — shared
        instantly between controllers, traffic managers, and airline ops. At the biggest airports
        it adds surface metering: instead of everyone pushing back and idling in a taxi queue, the
        system holds you at the gate and releases you into a moving line. Less burned fuel, more
        honest departure times.
      </p>
      <h3 class={subheadClass}>The pace, honestly</h3>
      <p class={proseClass}>
        Eighteen towers went digital in the first 44 months — about five per year. The current
        promise is a different order of magnitude:
        <a href="https://fedscoop.com/faa-digital-flight-strip-system-atc-modernization/">Leidos says another dozen airports by the end of 2026</a>,
        and the FAA says all 89 by 2028 — roughly a six-fold acceleration that started showing up
        in 2026, with Washington National jumping a 2028 slot to go live in February. Worth
        holding next to that: the DOT Inspector General's
        <a href="https://www.oig.dot.gov/library-item/46321">2024 audit</a> found the program's
        first decade cut its scope from 89 towers to 49 while costs rose, and estimated
        completion in <em>2030</em> — for the smaller plan. The 2025 money put all 89 back on the
        board. This tracker exists to show which trajectory is real, one airport at a time.
      </p>
      <h3 class={subheadClass}>The skeptics' case</h3>
      <p class={proseClass}>
        Congress has seen this movie: NextGen ran two decades,
        <a href="https://www.gao.gov/products/gao-24-105254">$14 billion through 2022</a>, and
        delivered about 16% of its promised benefits by the government's own accounting. At the
        December 2025 oversight hearings, Sen. Tammy Duckworth called the three-year timeline
        "setting the integrator up to fail," and Rep. Troy Nehls asked what guardrails would keep
        this from becoming "another NextGen boondoggle." Even the sunny numbers deserve
        attribution: the claim that DCA deployed "45% faster than the typical cycle" traces to a
        single Leidos press release, and the FAA's own transparency site generates its
        per-airport answers with AI and was still calling Austin "planned" two weeks after the
        ribbon was cut. We use it as a pointer, and verify against the audit trail and press.
      </p>
    </section>

    <section
      class="mb-10 rounded-r-md border border-border border-l-[3px] border-l-amber-400 bg-card px-5 py-4.5"
      id="paper-strips"
      aria-label="Why paper strips existed"
    >
      <div class="mb-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400">
        Sidebar
      </div>
      <h2 class="mb-3 text-base font-bold tracking-tight text-foreground">
        Why paper strips existed — and why they almost outlived you
      </h2>
      <p class={proseClass}>
        A flight progress strip is a piece of paper about the size of a ruler: one flight, printed
        minutes before it needs attention, slotted into a plastic holder in a rack called a bay.
        As your flight taxis, the controller marks it in a pencil shorthand older than the FAA
        itself — runway assignments, altitudes, handoffs — and when responsibility for your
        aircraft moves to the next position, the strip physically moves with it. That little slide
        of plastic across a console <em>is</em> the handoff.
      </p>
      <p class={proseClass}>
        The reason paper survived the jet age, GPS, and the iPhone is that it's genuinely good.
        A strip never crashes, never lags, and never needs a login. It's readable in a glance from
        three feet away in a sunlit tower cab. And the act of writing is the point: controllers
        will tell you that marking a strip is how the picture of the airspace gets into your head.
        When the FAA first tried to kill paper strips, the working name for the replacement dated
        to the <em>1980s</em> — this is at least the third attempt.
      </p>
      <p class={proseClass}>
        For the record, the first US tower to actually drop paper was not Phoenix, whatever the
        internet tells you — it was Cleveland, on October 24, 2022, two years behind schedule.
        And somewhere in St. Louis there's a printer currently scheduled to produce America's
        last paper flight strip: STL holds the final slot in the FAA's published sequence, 2029
        in the plan, 2028 in the promise. This page will tell you which one wins.
      </p>
    </section>

    <section class={SECTION}>
      <CrossLink
        title="Flying United?"
        body="Seven of United's eight hubs are in this rollout — and United is in the middle of its biggest ground buildout ever: new terminals, new gates, and the largest clubs it has ever opened."
        href="/trackers/united-hubs"
        linkText="United Hub Tracker"
      />
    </section>

    <section class={SECTION} id="faq">
      <h2 class={SECTION_H2}>Quick answers</h2>
      {
        faq.map((f) => (
          <div class="mt-3.5">
            <div class="mb-1 text-sm font-semibold text-foreground">{f.question}</div>
            <p class="max-w-2xl text-xs leading-relaxed text-muted-foreground">{f.answer}</p>
          </div>
        ))
      }
    </section>

    <section class={SECTION} id="changelog">
      <h2 class={SECTION_H2}>Changelog</h2>
      <Changelog entries={atcMeta.changelog} />
      <p class={methodClass}>
        How this page is maintained: airport statuses are verified against the FAA's Modern Skies
        dashboard, the DOT Inspector General's TFDM audit, and press coverage of each go-live.
        Every airport in the underlying dataset cites at least one source, and dates appear only
        where a source supports them. Updated monthly, or when an airport goes live.
      </p>
      <TrackerDataActions
        slug="atc"
        pageLabel="FAA electronic flight strips tracker"
        pagePath="/trackers/atc"
      />
    </section>
  </div>

  <script src="../../scripts/trackers.ts"></script>
</BaseLayout>
