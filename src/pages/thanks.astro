---
/**
 * /thanks — where Stripe sends a supporter after paying (the Payment Link's after-payment
 * redirect, set by the owner in Stripe). Static, `noindex`, no script.
 *
 * A static page cannot know whether this payment has reached the site, which day it covered,
 * or whether the calendar is switched on, so every sentence here is one that holds in all of
 * those cases: what the money does, how "cover a day" counts (src/lib/cover-a-day.js: the day it
 * is given, or the next open day after it; small amounts pool), and that
 * a display name CAN appear (only after src/lib/supporter-name.js, never on a hidden row or
 * with SUPPORTER_NAMES=off; a pooled day shows a count). Point Stripe's redirect here only
 * once the webhook is live.
 */
import BaseLayout from '../components/site/BaseLayout.astro';
import { DAILY_COST_USD, MONTHLY_COST_USD } from '../lib/cover-a-day.js';

const title = 'Thank you | The Blue Board';
const description = 'Thank you for supporting The Blue Board, the free, fan-built United Airlines operations dashboard.';
---

<BaseLayout title={title} description={description} canonical="/thanks" noindex>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-2xl font-bold tracking-tight text-foreground">Thank you.</h1>

    <div class="mt-5 space-y-4 text-sm leading-relaxed text-muted-foreground">
      <p>
        Your donation keeps The Blue Board free, with no ads. It costs about ${MONTHLY_COST_USD} a month to
        run, about ${DAILY_COST_USD} a day: the live flight and schedule data, the servers, and the AI
        delay explanations.
      </p>
      <p>
        We count donations in days: every ${DAILY_COST_USD} covers one day of the site's costs, the day it
        is given or, if that day is already covered, the next open day after it. Smaller amounts pool
        with other donations until they make a day. The dashboard's About section (ⓘ → About on a
        computer, More → About on a phone) shows this month's days.
      </p>
      <p>
        If you gave a display name, it can appear beside the day your donation covered, after a basic
        check. Otherwise, or if several donations covered that day together, the day is credited to
        &ldquo;a supporter&rdquo; or to the number of supporters who covered it.
      </p>
      <p>Stripe handled your payment. Your card details stay with Stripe.</p>
    </div>

    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-primary-fill px-6 text-xs font-semibold text-primary-foreground hover:bg-primary-fill/90"
    >
      ← Back to the dashboard
    </a>
  </div>
</BaseLayout>
