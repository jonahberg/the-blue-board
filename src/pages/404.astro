---
/**
 * The 404 page.
 *
 * `tests/agent-readiness.test.js` reads THIS SOURCE FILE and asserts the
 * literal `href="…"` strings below: the four machine-readable indexes
 * (/sitemap.xml, /llms.txt, /llms-full.txt, /feed.xml) and the four section
 * indexes (/fleet, /hubs, /trackers, /news). Keep them written out.
 */
import { hubOrder, hubNavLabels } from '../data/hubs/index.js';
import BaseLayout from '../components/site/BaseLayout.astro';

const linkClass =
  'inline-flex min-h-11 items-center rounded-md border border-border bg-card px-3 text-[11px] text-muted-foreground hover:border-primary hover:text-foreground';
const labelClass =
  'mt-7 mb-2.5 font-mono text-[10px] font-semibold tracking-widest text-muted-foreground uppercase';
---

<BaseLayout
  title="Page Not Found — The Blue Board"
  description="That page doesn't exist. Jump back to the live United Airlines dashboard, a hub status page, the fleet database, the trackers or the news hub."
  canonical="/404"
  noindex
>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-14 text-center">
    <p class="font-mono text-7xl leading-none font-bold tracking-tighter text-primary sm:text-8xl">
      404
    </p>
    <h1 class="mt-3 text-lg font-semibold text-foreground">Flight not found.</h1>
    <p class="mt-2 max-w-sm text-xs leading-relaxed text-muted-foreground">
      This page doesn't exist — but every United flight does. Head back to the dashboard or check a
      hub below.
    </p>

    <a
      href="/"
      class="mt-7 inline-flex min-h-11 items-center rounded-md bg-primary px-6 text-xs font-semibold text-primary-foreground hover:bg-primary/90"
    >
      ← Back to The Blue Board
    </a>

    <p class={labelClass}>Hub status</p>
    <nav aria-label="United hubs" class="flex max-w-lg flex-wrap justify-center gap-2">
      {hubOrder.map((hub) => <a href={`/hubs/${hub}`} class={linkClass}>{hubNavLabels[hub]}</a>)}
    </nav>

    <p class={labelClass}>Or jump to a section</p>
    <nav aria-label="Site sections" class="flex max-w-lg flex-wrap justify-center gap-2">
      <a href="/fleet" class={linkClass}>Fleet database</a>
      <a href="/hubs" class={linkClass}>All hubs</a>
      <a href="/trackers" class={linkClass}>Trackers</a>
      <a href="/news" class={linkClass}>News</a>
      <a href="/newark" class={linkClass}>Newark ops</a>
    </nav>

    <p class="mt-8 max-w-lg text-[11px] leading-loose text-muted-foreground">
      Crawlers and agents:
      <a href="/sitemap.xml" class="underline underline-offset-2 hover:text-foreground"
        >/sitemap.xml</a
      > &middot;
      <a href="/llms.txt" class="underline underline-offset-2 hover:text-foreground">/llms.txt</a> &middot;
      <a href="/llms-full.txt" class="underline underline-offset-2 hover:text-foreground"
        >/llms-full.txt</a
      > &middot;
      <a href="/feed.xml" class="underline underline-offset-2 hover:text-foreground">/feed.xml</a>
      <br />
      Send <code class="rounded-sm bg-muted px-1 py-0.5 font-mono text-[10px] text-foreground"
        >Accept: text/markdown</code
      > for a Markdown 404 with the same links.
    </p>
  </div>
</BaseLayout>
