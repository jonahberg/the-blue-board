---
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import BaseLayout from '../components/site/BaseLayout.astro';

const title = 'Privacy Policy | The Blue Board';
const description =
  "What The Blue Board collects (your email, if you sign up), where it lives, what it's used for, and how to unsubscribe or delete it.";
---

<BaseLayout title={title} description={description} canonical="/privacy">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Privacy' }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="text-2xl font-bold tracking-tight text-foreground">Privacy Policy</h1>
      <p class="mt-1.5 font-mono text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
        Effective November 10, 2026
      </p>
    </header>

    <div class="mt-6 max-w-2xl space-y-4 text-sm leading-relaxed text-muted-foreground">
      <p>
        The Blue Board is a free, ad-free United Airlines ops dashboard built by one person. The
        short version: the only personal data we collect ourselves is what you give us when you
        sign up for email updates, we use it only to send you those updates, and we never sell it.
        If you donate, the payment processor takes the payment on its own page and tells us about
        the donation (see below).
      </p>

      <h2 class="pt-4 text-base font-bold text-foreground">What we collect</h2>
      <ul class="list-disc space-y-1 pl-5">
        <li>
          <strong class="font-semibold text-foreground">Email address</strong> — only if you join the
          waitlist or email list.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Feature request</strong> — optional free-text
          you can include when signing up.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Source tag</strong> — which page or form you
          signed up from (e.g. the dashboard's &ldquo;Stay in the loop&rdquo; strip or the dashboard
          popup).
        </li>
      </ul>
      <p>
        Your IP address is used transiently in server memory to rate-limit signups; it is not stored
        with your email. We don't run ads or ad trackers.
      </p>

      <h2 class="pt-4 text-base font-bold text-foreground">Where it lives and who processes it</h2>
      <ul class="list-disc space-y-1 pl-5">
        <li>
          <strong class="font-semibold text-foreground">Supabase</strong> — stores the signup list
          (email, feature request, source).
        </li>
        <li>
          <strong class="font-semibold text-foreground">Resend</strong> — delivers our emails and
          holds the news-digest subscriber list.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Vercel</strong> — hosts the site and collects
          cookieless, anonymized usage data: page views and interaction events via Vercel Web
          Analytics, and performance metrics via Vercel Speed Insights.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Anthropic, through Vercel's AI Gateway</strong> —
          writes the delay explanations and the operations brief from flight data, and may read a
          question you type into "Ask" in the search box when the site's own rules cannot interpret
          it. We do not store what you type, and it is not sent to analytics; do not put personal
          details in a question.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Stripe</strong> — processes one-time
          donations on its own checkout page. We see the donation as Stripe reports it (such as the
          amount and the email address you give Stripe), never your full card number. Each donate link
          tells Stripe which link on the site it was (for example, the footer), and Stripe records
          that label with the payment. If you give a display name at checkout, it may be shown on the
          site beside the day your donation covered, and we keep it with the donation's amount and
          time in Supabase; your email address and payment details stay with Stripe.
        </li>
        <li>
          <strong class="font-semibold text-foreground">Buy Me a Coffee</strong> — handles monthly
          memberships.
        </li>
      </ul>

      <h2 class="pt-4 text-base font-bold text-foreground">What it's used for</h2>
      <p>
        A welcome email when you sign up, plus the launch updates and news digests you asked for.
        Nothing else.
      </p>

      <h2 class="pt-4 text-base font-bold text-foreground">No selling</h2>
      <p>We never sell, rent, or share your data with anyone for marketing.</p>

      <h2 class="pt-4 text-base font-bold text-foreground">Unsubscribe &amp; deletion</h2>
      <p>
        Every email we send includes an unsubscribe option. You can also reply &ldquo;unsubscribe&rdquo;
        to any email, or write to <a
          href="mailto:hello@theblueboard.co"
          class="underline underline-offset-2 hover:text-foreground">hello@theblueboard.co</a
        > to unsubscribe or have your data deleted entirely — same address for any privacy question.
      </p>
    </div>
  </div>
</BaseLayout>
