<!-- Schema: BreadcrumbList -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "The Blue Board", "item": "https://theblueboard.co"},
    {"@type": "ListItem", "position": 2, "name": "Newark Operations Center", "item": "https://theblueboard.co/newark"}
  ]
}
</script>

<!-- Schema: FAQPage -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqEntries.map((e) => ({
    "@type": "Question",
    "name": e.question,
    "acceptedAnswer": { "@type": "Answer", "text": e.answer }
  }))
})} />

<link rel="stylesheet" href="/css/style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<style>
  .nwk-page { max-width: 900px; margin: 0 auto; padding: 20px 16px 0; }
  .nwk-breadcrumb { font-family: var(--font-ui); font-size: 11px; font-weight: 500; color: var(--ua-muted); margin-bottom: 20px; }
  .nwk-breadcrumb a { color: var(--ua-accent); text-decoration: none; }
  .nwk-breadcrumb a:hover { text-decoration: underline; }

  .nwk-hero { margin-bottom: 28px; }
  .nwk-hero h1 { font-family: var(--font-ui); font-size: 24px; font-weight: 700; letter-spacing: -0.5px; color: var(--ua-text); margin: 0 0 10px; }
  .nwk-hero p { font-family: var(--font-ui); font-size: 13px; color: var(--ua-muted); line-height: 1.7; margin: 0; }

  .nwk-jump-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
  .nwk-jump-pill { font-family: var(--font-mono); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--ua-muted); background: var(--ua-panel); border: 1px solid var(--ua-border); border-radius: 20px; padding: 6px 14px; text-decoration: none; transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease, transform 150ms ease; }
  .nwk-jump-pill:hover { color: #fff; border-color: var(--ua-blue); background: var(--ua-blue); transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,93,170,.3); }

  .nwk-section { margin-bottom: 40px; padding-top: 24px; border-top: 1px solid var(--ua-border); }
  .nwk-section:first-of-type { border-top: none; padding-top: 0; }
  .nwk-section h2 { font-family: var(--font-ui); font-size: 16px; font-weight: 700; color: var(--ua-text); margin: 0 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--ua-border); }
  .nwk-section h3 { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--ua-accent); margin: 16px 0 8px; }
  .nwk-section p { font-family: var(--font-ui); font-size: 13px; color: var(--ua-text); line-height: 1.7; margin: 0 0 12px; }
  .nwk-section ul { padding-left: 20px; margin: 0 0 12px; }
  .nwk-section li { font-family: var(--font-ui); font-size: 13px; color: var(--ua-text); line-height: 1.7; margin-bottom: 4px; }

  .nwk-live-panel { background: var(--ua-panel); border: 1px solid var(--ua-border); border-radius: 6px; padding: 20px; margin-bottom: 28px; }
  .nwk-live-badge { display: inline-block; background: var(--ua-green); color: #000; font-size: 9px; font-weight: 700; padding: 2px 8px; border-radius: 3px; letter-spacing: 1px; margin-bottom: 12px; animation: nwk-pulse 2s ease-in-out infinite; }
  @keyframes nwk-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.7; } }
  @media (prefers-reduced-motion: reduce) { .nwk-live-badge { animation: none; } }
  .nwk-stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .nwk-stat-card { background: var(--ua-dark); border: 1px solid var(--ua-border); border-radius: 6px; padding: 12px; text-align: center; }
  .nwk-stat-card .label { font-family: var(--font-mono); font-size: 9px; color: var(--ua-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
  .nwk-stat-card .value { font-family: var(--font-mono); font-size: 24px; font-weight: 700; color: var(--ua-green); }
  .nwk-program-status { font-family: var(--font-ui); font-size: 12px; color: var(--ua-text); background: var(--ua-panel-elevated, #152032); border: 1px solid var(--ua-border); border-radius: 6px; padding: 10px 14px; margin-bottom: 12px; }
  .nwk-updated { font-family: var(--font-mono); font-size: 9px; color: var(--ua-dim); text-align: right; margin-bottom: 12px; }
  .nwk-cta { display: inline-block; background: var(--ua-blue); color: #fff; padding: 8px 20px; border-radius: 4px; font-family: var(--font-ui); font-size: 11px; font-weight: 600; text-decoration: none; letter-spacing: 0.5px; margin-right: 8px; }
  .nwk-cta:hover { background: #0070cc; text-decoration: none; }

  .nwk-highlight { background: var(--ua-panel); border-left: 3px solid var(--ua-amber); padding: 12px 16px; margin: 16px 0; border-radius: 0 6px 6px 0; font-size: 12px; color: var(--ua-text); }
  .nwk-highlight.red { border-left-color: var(--ua-red); }
  .nwk-highlight.yellow { border-left-color: var(--ua-yellow); }

  .nwk-timeline { list-style: none; margin: 0; padding: 0; }
  .nwk-timeline li { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--ua-border-subtle, var(--ua-border)); }
  .nwk-timeline li:last-child { border-bottom: none; }
  .nwk-timeline .nwk-t-date { flex: 0 0 130px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--ua-amber); }
  .nwk-timeline .nwk-t-body { flex: 1; }
  .nwk-timeline .nwk-t-label { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--ua-text); margin-bottom: 4px; }
  .nwk-timeline .nwk-t-detail { font-family: var(--font-ui); font-size: 12px; color: var(--ua-muted); line-height: 1.6; }

  .nwk-faq-item { margin-bottom: 16px; }
  .nwk-faq-q { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--ua-text); margin: 0 0 4px; }
  .nwk-faq-a { font-family: var(--font-ui); font-size: 12px; color: var(--ua-muted); line-height: 1.7; margin: 0; }

  .nwk-crosslinks a { color: var(--ua-accent); text-decoration: none; }
  .nwk-crosslinks a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .nwk-hero h1 { font-size: 19px; }
    .nwk-timeline li { flex-direction: column; gap: 4px; }
    .nwk-timeline .nwk-t-date { flex: none; }
  }
</style>
</head>
<body>
<main class="nwk-page">

  <!-- Breadcrumb -->
  <nav class="nwk-breadcrumb" aria-label="Breadcrumb">
    <a href="/">&larr; The Blue Board</a> / Newark Operations Center
  </nav>

  <!-- Hero -->
  <div class="nwk-hero">
    <h1>Newark Operations Center</h1>
    <p>United's Newark Liberty (EWR) hub is operating under an FAA flight cap of <strong>72 total operations per hour</strong> (36 arrivals + 36 departures), extended through <strong>October 30, 2027</strong> by Federal Register order 2026-12589 (issued June 23, 2026). The cap exists because the Philadelphia TRACON facility that controls EWR arrivals — its Area C team specifically — has been running at roughly <strong>48% of target staffing</strong>, a shortfall exposed by a series of 2025 telecommunications and radar outages. Some construction weekends have seen even lower rates. This page is the bookmarkable reference for what's happening at Newark and why.</p>
  </div>

  <!-- Live Status Panel -->
  <div class="nwk-live-panel">
    <div class="nwk-live-badge">● LIVE</div>
    <div class="nwk-stats-grid">
      <div class="nwk-stat-card">
        <div class="label">Active United Flights (EWR)</div>
        <div class="value" id="newark-active">—</div>
      </div>
    </div>
    <div class="nwk-program-status" id="newark-program-status">Checking FAA program status for EWR…</div>
    <div class="nwk-updated" id="newark-updated-time">Connecting to live data...</div>
    <a class="nwk-cta" href="/?hub=ewr">Open EWR on The Blue Board →</a>
    <a class="nwk-cta" href="/?tab=schedule&hub=ewr">View EWR Schedule →</a>
  </div>

  <!-- Jump nav -->
  <nav class="nwk-jump-nav" aria-label="Section navigation">
    <a class="nwk-jump-pill" href="#the-cap">The Cap, Explained</a>
    <a class="nwk-jump-pill" href="#your-flight">Your Flight</a>
    <a class="nwk-jump-pill" href="#faq">FAQ</a>
  </nav>

  <!-- The Cap, Explained -->
  <section class="nwk-section" id="the-cap">
    <h2>The Cap, Explained</h2>
    <p>Newark's flight caps are the result of an air traffic control staffing crisis, not a construction project or a weather event — though both compounded the disruption in 2025. Here's the full timeline:</p>

    <div class="nwk-highlight red">
      <strong>🚨 Bottom line:</strong> The FAA caps EWR at 72 total operations per hour (36 arrivals + 36 departures) through <strong>October 30, 2027</strong>. This is a deliberate, planned reduction to match the number of controllers the Philadelphia TRACON can actually staff — not an emergency measure that could lift on short notice.
    </div>

    <ol class="nwk-timeline" style="margin-top:20px">
      {timeline.map((t) => (
        <li>
          <div class="nwk-t-date">{t.date}</div>
          <div class="nwk-t-body">
            <div class="nwk-t-label" set:html={t.label} />
            <div class="nwk-t-detail" set:html={t.detail} />
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- What It Means For Your Flight -->
  <section class="nwk-section" id="your-flight">
    <h2>What It Means For Your Flight</h2>
    <p>The Newark cap means the schedule is <strong>deliberately thinned, not chaotic</strong> — United and other carriers plan their EWR schedules around the 72-operations-per-hour ceiling, so a normal day at EWR should run close to on-time. The risk comes from what happens on top of an already-tight schedule:</p>
    <ul>
      <li><strong>Evening banks are the most fragile.</strong> Delays compound throughout the day, and by the evening push a single weather cell or ATC hiccup has nowhere to absorb the slack.</li>
      <li><strong>Weather days hit hard.</strong> Thunderstorms, snow, fog, or wind shifts trigger ground delay programs on top of the reduced schedule — there's less cushion than at an uncapped airport.</li>
      <li><strong>Morning departures are the most reliable.</strong> Flights before 9 AM consistently post the best on-time performance at EWR, before delays have a chance to cascade.</li>
      <li><strong>Some weekends run even tighter.</strong> Construction and maintenance windows have occasionally dropped the rate below the standard 72/hour cap — check the live board before you head to the airport.</li>
    </ul>
    <p>Before you leave for the airport, check the live board: <a href="/?tab=schedule&hub=ewr">EWR Schedule on The Blue Board →</a> or read the full <a href="/hubs/ewr">EWR Hub Guide</a> for terminal maps, lounges, and Starlink WiFi coverage.</p>
  </section>

  <!-- FAQ -->
  <section class="nwk-section" id="faq">
    <h2>Frequently Asked Questions</h2>
    {faqEntries.map((entry) => (
      <div class="nwk-faq-item">
        <h3 class="nwk-faq-q">{entry.question}</h3>
        <p class="nwk-faq-a">{entry.answer}</p>
      </div>
    ))}
  </section>

  <!-- Cross-links -->
  <section class="nwk-section nwk-crosslinks" id="more">
    <h2>More on Newark &amp; United</h2>
    <ul>
      <li><a href="/hubs/ewr">EWR Hub Guide</a> — terminals, lounges, Starlink WiFi, and delay patterns.</li>
      <li><a href="/?tab=schedule&hub=ewr">Live EWR Schedule</a> — every United departure and arrival, updated every 30 seconds.</li>
      <li><a href="/tsa#ewr">EWR TSA Checkpoints</a> — security lane guide for Terminal A and Terminal C.</li>
      <li><a href="/hubs">All United Hubs</a> — status across ORD, DEN, IAH, EWR, SFO, IAD, LAX, NRT, and GUM.</li>
    </ul>
  </section>

</main>

<Footer />

<VercelSpeedInsights />
<script defer src="/js/newark-live.js"></script>
</body>
</html>
