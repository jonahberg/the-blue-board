---
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import ContentSection from '../components/site/ContentSection.astro';
import HighlightBox from '../components/site/HighlightBox.astro';
import JumpNav from '../components/site/JumpNav.astro';
import StatTile from '../components/site/StatTile.astro';
import { HUB_ORDER } from '../lib/hub-health.js';
import { hubLink } from '../lib/hub-link.js';
import { NAS_STATUS_HREF } from '../lib/nas-status-link.js';

const faqEntries = [
  {
    question: 'Why is Newark (EWR) capped?',
    answer:
      "In spring 2025, the Philadelphia TRACON facility that controls Newark arrivals suffered repeated radar and radio outages — including a roughly 90-second total loss of radar and radio on April 28, 2025 — which, combined with chronic air traffic controller staffing shortages, threw EWR operations into crisis. The FAA responded by capping total operations (arrivals plus departures) well below Newark's physical runway capacity so the reduced number of available controllers could safely handle the traffic.",
  },
  {
    question: 'How long will the Newark flight caps last?',
    answer:
      'The FAA first imposed an interim cap of 28 arrivals and 28 departures per hour on May 20, 2025, then raised it to 34/34. The cap was later extended to 72 total operations per hour (36 arrivals + 36 departures) through October 24, 2026. A subsequent FAA order (Federal Register document 2026-12589, issued June 18 and published June 23, 2026) extended the 72-per-hour cap through October 30, 2027, and the FAA’s October 9, 2026 scheduling notice for summer 2027 confirmed it, saying staffing at the Philadelphia TRACON’s Area C remains level and will not increase significantly before the summer 2027 season starts.',
  },
  {
    question: 'Is it safe to fly through Newark?',
    answer:
      "Yes. The caps exist because of an air traffic control staffing shortfall at the Philadelphia TRACON, and PHL TRACON's Area C — the team that handles EWR arrivals — had 28 certified controllers against a target of 46 (60.8%) at the time of the FAA's June 2026 order, with six of them due to rotate back to New York by the end of July 2026. Rather than let controllers manage more traffic than they can safely separate, the FAA reduced Newark's hourly schedule to match available controller capacity. The caps are a capacity-management response to a staffing gap, not a signal of unsafe operations.",
  },
  {
    question: 'Which flights are most affected?',
    answer:
      'Evening banks and weather days see the most disruption — delays compound as the day goes on and any thunderstorm, fog, or snow event across the New York area triggers ground delay programs on top of the already-reduced schedule. Some construction weekends have seen even lower rates than the standard 72/hour cap. Early-morning departures (before 9 AM) consistently have the best on-time performance at EWR.',
  },
  {
    question: 'What caused the 2025 Newark crisis in the first place?',
    answer:
      'A combination of air traffic controller staffing shortages at the Philadelphia TRACON and a series of telecommunications and radar outages — including outages on April 28, May 9, and May 11, 2025 — that briefly left controllers without radar or radio contact with aircraft. Several controllers took trauma leave afterward, further reducing the already-thin staffing. Concurrent rehabilitation of runway 4L-22R (April 15 – June 2, 2025) compounded the disruption.',
  },
  {
    question: 'Does the cap mean fewer United flights at Newark?',
    answer:
      'Yes. United proactively cut about 35 daily roundtrips from Newark starting in May 2025 to align its schedule with the reduced FAA operating rate. United now operates roughly 350–400 daily departures from EWR under the current caps, down from prior years, making EWR United’s most heavily schedule-managed hub.',
  },
];

const ogImage = 'https://theblueboard.co/og/og-hub-ewr.jpg';

const timeline = [
  {
    date: 'Apr 15, 2025',
    label: 'Runway 4L-22R rehabilitation begins',
    detail: 'Construction on runway 4L-22R runs through June 2, 2025, cutting available runway capacity during the same window as the ATC crisis below.',
  },
  {
    date: 'Apr 28, 2025',
    label: 'Philadelphia TRACON telecom/radar outage',
    detail: 'A roughly 90-second total loss of radar and radio contact with aircraft at the facility that controls EWR arrivals. Several controllers subsequently took trauma leave, deepening an already thin staffing shortage.',
  },
  {
    date: 'May 9 and 11, 2025',
    label: 'Additional outages',
    detail: 'Further telecommunications/radar outages at the Philadelphia TRACON compound the crisis and controller attrition.',
  },
  {
    date: 'May 20, 2025',
    label: 'FAA imposes interim cap: 28/28 per hour',
    detail: 'The FAA orders an interim limit of 28 arrivals and 28 departures per hour — later raised to 34 arrivals and 34 departures per hour — to match the reduced number of available controllers.',
  },
  {
    date: 'Jun 2, 2025',
    label: 'Runway 4L-22R rehabilitation completes',
    detail: 'Full runway capacity restored, but the ATC staffing shortfall remains the binding constraint on Newark’s schedule.',
  },
  {
    // The source gives this step no date of its own, only the date the cap ran to, which is in
    // the label: the date column shows "—" rather than an end date out of order among event dates.
    date: null,
    label: 'Cap raised to 72 ops/hour, extended through Oct 24, 2026',
    detail: 'The FAA raises the cap to 72 total operations per hour (36 arrivals + 36 departures) and extends it through October 24, 2026, giving airlines a stable planning horizon while ATC staffing recovers.',
  },
  {
    date: 'Jun 23, 2026',
    label: 'Federal Register order 2026-12589',
    detail: 'The FAA extends the 72-operations-per-hour cap through October 30, 2027 (the order was issued June 18 and published June 23), citing continued Philadelphia TRACON Area C staffing shortfalls — 28 certified controllers against a target of 46 (60.8%), with six temporary controllers due to leave by the end of July 2026 — and saying it does not expect Area C to reach its target before the end of the summer 2027 season.',
  },
  {
    date: 'Oct 9, 2026',
    label: 'Summer 2027 schedules: cap confirmed',
    detail: 'The FAA’s summer 2027 scheduling notice restates the cap through October 30, 2027, noting that Area C staffing remains level and will not increase significantly before the summer 2027 season starts.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((e) => ({
    '@type': 'Question',
    name: e.question,
    acceptedAnswer: { '@type': 'Answer', text: e.answer },
  })),
};

const jumpNav = [
  { href: '#the-cap', label: 'The Cap, Explained' },
  { href: '#your-flight', label: 'Your Flight' },
  { href: '#faq', label: 'FAQ' },
];

// The nine hubs named in the "More" list, each a link to its hub page (links everywhere, Nov 12
// 2026). This page is about Newark but is not EWR's hub page, so EWR links too.
const hubLinks = HUB_ORDER.map((code) => hubLink(code, 'site')).filter((link) => link !== null);

const ctaClass =
  'inline-flex min-h-11 items-center rounded-md bg-primary-fill px-5 text-xs font-semibold text-primary-foreground hover:bg-primary-fill/90';
---

<BaseLayout
  title="Newark (EWR) Flight Cap Explained | The Blue Board"
  description="Newark (EWR) is FAA-capped at 72 operations an hour through October 30, 2027. Live United flight status, the ATC crisis timeline and what the cap means."
  canonical="/newark"
  ogImage={ogImage}
  ogTitle="Newark Operations Center — The FAA Cap, Explained"
  ogDescription="EWR is FAA-capped at 72 ops/hour through October 30, 2027. Live United flight status, the full crisis timeline, and what it means for your flight."
  ogImageAlt="The Blue Board — Newark Operations Center"
  twitterDescription="EWR is FAA-capped at 72 ops/hour through October 30, 2027. Live United flight status and the full crisis timeline."
  jsonLd={[faqSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Newark Operations Center' }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-foreground">
        Newark Operations Center
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        United's Newark Liberty (EWR) hub is operating under an FAA flight cap of <strong
          class="font-semibold text-foreground">72 total operations per hour</strong
        > (36 arrivals + 36 departures), extended through <strong
          class="font-semibold text-foreground">October 30, 2027</strong
        > by Federal Register order 2026-12589 (issued June 18, published June 23, 2026). The cap
        exists because the Philadelphia TRACON facility that controls EWR arrivals — its Area C team
        specifically — had only <strong class="font-semibold text-foreground"
          >28 of its 46 targeted certified controllers (60.8%)</strong
        > when that order was issued, a shortfall exposed by a series of 2025 telecommunications and
        radar outages. Some
        construction weekends have seen even lower rates. This page is the bookmarkable reference
        for what's happening at Newark and why.
      </p>
    </header>

    {/* The live panel: the badge and its freshness stamp on one line, then the count and the
        FAA program line side by side from sm, then the ways into the board. */}
    <section aria-label="Live EWR status" class="mt-6 rounded-lg border border-border bg-card p-4">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <p
          class="inline-flex items-center gap-1.5 rounded-sm bg-primary-fill px-2 py-0.5 font-mono text-[11px] font-bold tracking-widest text-primary-foreground uppercase"
        >
          <span aria-hidden="true">●</span> Live
        </p>
        <p id="newark-updated-time" class="font-mono text-[11px] text-muted-foreground">
          Connecting to live data...
        </p>
      </div>
      <div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]">
        {/* The count is United flights to or from EWR in the live feed, so the tile links to the
            Live map filtered to Newark, which shows those flights (StatTile `href`). */}
        <StatTile label="Active United Flights (EWR)" value="—" id="newark-active" href="/?hub=ewr" />
        {/* The FAA program line links to the dashboard's NAS status panel, which lists every FAA
            program in force. src/scripts/newark-live.ts rewrites the text of #newark-program-status
            on each poll, so the id sits on an inner span and the link around it survives. */}
        <a
          href={NAS_STATUS_HREF}
          class="group flex flex-col justify-center gap-1 rounded-lg border border-border bg-background px-3.5 py-2.5 text-xs leading-relaxed text-foreground transition-colors hover:border-primary"
        >
          <span id="newark-program-status">Checking FAA program status for EWR…</span>
          <span
            class="text-[11px] text-muted-foreground underline decoration-muted-foreground/40 underline-offset-2 group-hover:decoration-foreground group-focus-visible:decoration-foreground"
            >FAA status on the dashboard →</span
          >
        </a>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <a class={ctaClass} href="/?hub=ewr">Open EWR on The Blue Board →</a>
        <a class={ctaClass} href="/?tab=schedule&hub=ewr">View EWR Schedule →</a>
      </div>
    </section>

    <JumpNav items={jumpNav} />

    <ContentSection id="the-cap" heading="The Cap, Explained" first>
      <p>
        Newark's flight caps are the result of an air traffic control staffing crisis, not a
        construction project or a weather event — though both compounded the disruption in 2025.
        Here's the full timeline:
      </p>

      <HighlightBox tone="alert">
        <strong>🚨 Bottom line:</strong> The FAA caps EWR at 72 total operations per hour (36
        arrivals + 36 departures) through <strong>October 30, 2027</strong>. This is a deliberate,
        planned reduction to match the number of controllers the Philadelphia TRACON can actually
        staff — not an emergency measure that could lift on short notice.
      </HighlightBox>

      <ol class="mt-5 list-none space-y-0 pl-0">
        {
          timeline.map((t) => (
            <li class="flex flex-col gap-1 border-b border-border py-3 last:border-b-0 sm:flex-row sm:items-baseline sm:gap-4">
              <span class="shrink-0 font-mono text-[11px] font-semibold text-muted-foreground sm:w-32">
                {t.date ?? (
                  <>
                    <span aria-hidden="true">—</span>
                    <span class="sr-only">No date given</span>
                  </>
                )}
              </span>
              <span class="flex-1">
                <span class="block text-sm font-semibold text-foreground" set:html={t.label} />
                <span
                  class="mt-1 block text-xs leading-relaxed text-muted-foreground"
                  set:html={t.detail}
                />
              </span>
            </li>
          ))
        }
      </ol>
    </ContentSection>

    <ContentSection id="your-flight" heading="What It Means For Your Flight">
      <p>
        The Newark cap means the schedule is <strong>deliberately thinned, not chaotic</strong> —
        United and other carriers plan their EWR schedules around the 72-operations-per-hour
        ceiling, so a normal day at EWR should run close to on-time. The risk comes from what
        happens on top of an already-tight schedule:
      </p>
      <ul>
        <li>
          <strong>Evening banks are the most fragile.</strong> Delays compound throughout the day,
          and by the evening push a single weather cell or ATC hiccup has nowhere to absorb the
          slack.
        </li>
        <li>
          <strong>Weather days hit hard.</strong> Thunderstorms, snow, fog, or wind shifts trigger
          ground delay programs on top of the reduced schedule — there's less cushion than at an
          uncapped airport.
        </li>
        <li>
          <strong>Morning departures are the most reliable.</strong> Flights before 9 AM
          consistently post the best on-time performance at EWR, before delays have a chance to
          cascade.
        </li>
        <li>
          <strong>Some weekends run even tighter.</strong> Construction and maintenance windows have
          occasionally dropped the rate below the standard 72/hour cap — <a
            href="/?tab=schedule&hub=ewr">check the live board</a
          > before you head to the airport.
        </li>
      </ul>
      <p>
        Before you leave for the airport, check the live board: <a href="/?tab=schedule&hub=ewr"
          >EWR Schedule on The Blue Board →</a
        > or read the full <a href="/hubs/ewr">EWR Hub Guide</a> for terminal maps, lounges, and
        Starlink WiFi coverage.
      </p>
    </ContentSection>

    <ContentSection id="faq" heading="Frequently Asked Questions">
      {
        faqEntries.map((entry) => (
          <div class="mb-4">
            <h3>{entry.question}</h3>
            <p>{entry.answer}</p>
          </div>
        ))
      }
    </ContentSection>

    <ContentSection id="more" heading="More on Newark & United">
      <ul>
        <li>
          <a href="/hubs/ewr">EWR Hub Guide</a> — terminals, lounges, Starlink WiFi, and delay
          patterns.
        </li>
        <li>
          <a href="/?tab=schedule&hub=ewr">Live EWR Schedule</a> — every United departure and
          arrival, updated every 30 seconds.
        </li>
        <li>
          <a href="/trackers/united-hubs/ewr">EWR Projects</a> — every tracked United and airport
          construction project at Newark, with its sources.
        </li>
        <li>
          <a href="/trackers/atc/ewr">EWR Paper Strips Status</a> — whether Newark's tower still runs
          on paper flight strips.
        </li>
        <li>
          <a href="/hubs">All United Hubs</a> — status across {
            hubLinks.map((link, i) => (
              <>{i === 0 ? '' : i === hubLinks.length - 1 ? ', and ' : ', '}<a href={link.href}>{link.code}</a></>
            ))
          }.
        </li>
      </ul>
    </ContentSection>
  </div>

  <script src="../scripts/newark-live.ts"></script>
</BaseLayout>
