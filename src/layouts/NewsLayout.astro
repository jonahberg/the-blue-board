---
/**
 * The thirteen news articles (`/news/{slug}`), driven by
 * `src/data/news/index.js`. Tags resolve to hub and fleet cross-links.
 */
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import HighlightBox from '../components/site/HighlightBox.astro';
import { resolveTag } from '../data/news/index.js';

const { article } = Astro.props;
const slug: string = article.slug;

// Resolve tags to cross-links
const crossLinks = (article.tags || []).map((t: string) => resolveTag(t)).filter(Boolean);

// Format date for display
const displayDate = new Date(article.date + 'T12:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const ogImage = article.ogImage || 'https://theblueboard.co/og/og-news.jpg';

// NewsArticle JSON-LD
const newsArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title,
  datePublished: article.date,
  dateModified: article.date,
  author: { '@type': 'Person', name: 'Jonah Berg', url: 'https://jonahberg.com' },
  publisher: {
    '@type': 'Organization',
    // Same node as the homepage Organization (which carries contactPoint + address) so
    // crawlers consolidate the two instead of seeing a second, thinner publisher entity.
    '@id': 'https://theblueboard.co/#organization',
    name: 'The Blue Board',
    url: 'https://theblueboard.co',
  },
  description: article.summary,
  mainEntityOfPage: `https://theblueboard.co/news/${slug}`,
  image: ogImage,
};
---

<BaseLayout
  title={`${article.title} | United Airlines News | The Blue Board`}
  description={article.summary}
  canonical={`/news/${slug}`}
  ogType="article"
  ogImage={ogImage}
  ogTitle={article.title}
  ogImageAlt={article.title}
  jsonLd={[newsArticleSchema]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={article.date} />
    <meta property="article:section" content={article.category} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'News', href: '/news' }, { label: article.title }]} />

    <article>
      <header class="mt-6 border-b border-border pb-5">
        <p class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">
          <span class="font-semibold text-primary">{article.category}</span> &middot; {displayDate}
        </p>
        <h1
          class="mt-2 text-2xl leading-tight font-bold tracking-tight text-balance text-foreground"
        >
          {article.title}
        </h1>
      </header>

      <div class="bb-content mt-6 max-w-2xl">
        <Fragment set:html={article.body} />
      </div>

      {
        article.sources && article.sources.length > 0 && (
          <section class="mt-8 rounded-lg border border-border bg-card p-4">
            <h2 class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
              Sources
            </h2>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
              {article.sources.map((s: { name: string; url: string }) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center text-xs text-foreground underline underline-offset-2"
                  >
                    <span aria-hidden="true" class="mr-1">
                      ↗
                    </span>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        crossLinks.length > 0 && (
          <section class="mt-8">
            <h2 class="text-xs font-semibold tracking-wider text-muted-foreground uppercase">
              Related on The Blue Board
            </h2>
            <nav aria-label="Related pages" class="mt-2.5 flex flex-wrap gap-2">
              {crossLinks.map((link: { label: string; url: string }) => (
                <a
                  href={link.url}
                  class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-4 text-[11px] font-semibold text-muted-foreground hover:border-primary hover:bg-primary hover:text-primary-foreground"
                >
                  {link.label} &rarr;
                </a>
              ))}
            </nav>
          </section>
        )
      }

      <div class="mt-8">
        <HighlightBox tone="warn">
          The Blue Board is free, ad-free, and independent. If you find this useful, consider <a
            href="https://buymeacoffee.com/notjbg"
            target="_blank"
            rel="noopener noreferrer">supporting the project</a
          >.
        </HighlightBox>
      </div>

      <div class="bb-content mt-4 rounded-lg border border-border bg-card px-4 py-3 text-xs">
        <p class="mb-0">
          <strong>Coming Soon: Blue Board Pro</strong> &mdash; Personalized delay predictions for
          your flights, push notifications when risk spikes, and more. <a href="/?waitlist=1"
            >Join the waitlist &rarr;</a
          >
        </p>
      </div>
    </article>

    <p class="mt-8">
      <a
        href="/news"
        class="inline-flex min-h-11 items-center text-xs font-medium text-foreground underline underline-offset-2"
        >&larr; All News</a
      >
    </p>
  </div>
</BaseLayout>
