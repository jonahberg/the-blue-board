---
/**
 * The nine hub pages (`/hubs/{iata}`), driven entirely by `src/data/hubs/*.js`.
 *
 * Two variants, as before: `full` (the seven US hubs) renders a header, the
 * live panel, a scroll hint and a jump nav around `contentHtml`; `compact`
 * (NRT, GUM) carries all of that inside `contentHtml` itself. Both now share
 * one chrome, one token set and one footer through `BaseLayout`.
 *
 * `<body data-hub-iata>` is the contract with `src/scripts/hub-live.ts`.
 */
import { hubOrder, hubNavLabels } from '../data/hubs/index.js';
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import HighlightBox from '../components/site/HighlightBox.astro';
import JumpNav from '../components/site/JumpNav.astro';
import PillNav from '../components/site/PillNav.astro';
import StatTile from '../components/site/StatTile.astro';

const { data } = Astro.props;
const iata: string = data.iata;
const iataLower = iata.toLowerCase();
const variant: string = data.variant;
const airport = data.airportSchema;
// P2-B item 5: per-hub OG image (scripts/generate-og.py) instead of the shared og-image.png
const ogImage = `https://theblueboard.co/og/og-hub-${iataLower}.jpg`;

// Build Airport schema with optional icaoCode
const airportSchemaObj: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Airport',
  name: airport.name,
  iataCode: airport.iataCode,
};
if (airport.icaoCode) {
  airportSchemaObj.icaoCode = airport.icaoCode;
}
airportSchemaObj.address = {
  '@type': 'PostalAddress',
  addressLocality: airport.addressLocality,
  addressRegion: airport.addressRegion,
  addressCountry: airport.addressCountry,
};
airportSchemaObj.geo = {
  '@type': 'GeoCoordinates',
  latitude: airport.latitude,
  longitude: airport.longitude,
};
airportSchemaObj.url = airport.url;

const faqSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqSchema.map((faq: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

// The eight hubs with a construction/modernization tracker; the seven
// continental ones are also covered by the TFDM paper-strips tracker.
const TRACKER_HUBS = ['ord', 'den', 'iah', 'ewr', 'sfo', 'iad', 'lax', 'gum'];
const STRIP_HUBS = ['ord', 'den', 'iah', 'ewr', 'sfo', 'iad', 'lax'];

const hubNavItems = hubOrder.map((h) => ({
  href: `/hubs/${h}`,
  label: hubNavLabels[h],
  current: h === iataLower,
}));
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={`/hubs/${iataLower}`}
  ogImage={ogImage}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImageAlt={data.ogImageAlt}
  twitterTitle={data.twitterTitle}
  twitterDescription={data.twitterDescription}
  jsonLd={[faqSchemaObj, airportSchemaObj]}
  dataAttrs={{ 'data-hub-iata': iata }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Hubs', href: '/hubs' }, { label: data.breadcrumbName }]} />

    {
      variant === 'full' && (
        <>
          <header class="mt-6 border-b border-border pb-5">
            <h1 class="bb-content text-2xl font-bold tracking-tight text-balance text-foreground">
              <Fragment set:html={data.headerTitle} />
            </h1>
            <p class="mt-1.5 text-xs text-muted-foreground">{data.subtitle}</p>
          </header>

          <section
            aria-label="Live hub status"
            class="mt-6 rounded-lg border border-border bg-card p-4"
          >
            <p class="inline-flex items-center gap-1.5 rounded-sm bg-primary px-2 py-0.5 font-mono text-[10px] font-bold tracking-widest text-primary-foreground uppercase">
              <span aria-hidden="true">●</span> Live
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-4">
              <StatTile
                label="Active United Flights"
                value="—"
                id="active"
                class="min-w-[9rem] flex-1"
              />
              <p class="min-w-[13rem] flex-2 text-xs leading-relaxed text-muted-foreground">
                Live delay counts and on-time performance are calculated on the full dashboard
                using schedule comparison data.
              </p>
            </div>
            <p
              id="updated-time"
              class="mt-3 text-right font-mono text-[10px] text-muted-foreground"
            >
              Connecting to live data...
            </p>
            <a
              class="mt-3 inline-flex min-h-11 items-center rounded-md bg-primary px-5 text-xs font-semibold text-primary-foreground hover:bg-primary/90"
              href={`/?hub=${iataLower}`}
            >
              Open {iata} on The Blue Board →
            </a>
          </section>

          <p id="scrollHint" class="pt-4 text-center text-xs text-muted-foreground">
            Explore hub details below <span aria-hidden="true">↓</span>
          </p>

          <JumpNav items={data.jumpNav} />
        </>
      )
    }

    <div class="bb-content mt-6">
      <Fragment set:html={data.contentHtml} />
    </div>

    {
      TRACKER_HUBS.includes(iataLower) && (
        <HighlightBox tone="warn">
          <strong>Construction &amp; Modernization</strong> — What's changing at United's {iata} hub
          {STRIP_HUBS.includes(iataLower)
            ? ', and whether its tower still runs on paper flight strips.'
            : '.'}{' '}
          <a href={`/trackers/united-hubs/${iataLower}`}>{iata} projects &rarr;</a>
          {STRIP_HUBS.includes(iataLower) && (
            <>
              {' '}
              <a href={`/trackers/atc/${iataLower}`}>{iata} paper strips status &rarr;</a>
            </>
          )}
        </HighlightBox>
      )
    }

    <section class="mt-8 border-t border-border pt-6">
      <h2
        id="all-hubs"
        class="mb-3 border-b border-border pb-1.5 text-base font-bold tracking-tight text-foreground"
      >
        All United Hubs
      </h2>
      <PillNav items={hubNavItems} label="United hubs" />
    </section>
  </div>

  <script src="../scripts/hub-live.ts"></script>
  <script src="../scripts/scroll-hint.ts"></script>
</BaseLayout>
