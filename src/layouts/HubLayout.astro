---
/**
 * The nine hub pages (`/hubs/{iata}`), driven entirely by `src/data/hubs/*.js`.
 *
 * Two variants, as before: `full` (the seven US hubs) renders a header, the
 * departures board, a scroll hint and a jump nav around `contentHtml`; `compact`
 * (NRT, GUM) carries its header and jump nav inside `contentHtml` itself, and the
 * board takes the place of the string's old one-number LIVE bar
 * (`splitCompactLiveBar`, src/lib/hub-content.js). Both share one chrome, one
 * token set and one footer through `BaseLayout`.
 *
 * The board is `HubBoard` (src/components/site/), filled by
 * `src/scripts/hub-board.ts` from the stored schedule snapshot. The prose's
 * emoji button row becomes plain links at render time (`demoteHubCtaRow`), the
 * hub codes in "Key Routes" link to their hub pages (`linkKeyRoutesHubs`), and a
 * compact page's live-map link comes back beside the board (`liveHref`); the data
 * files are not edited.
 */
import { hubOrder, hubNavLabels } from '../data/hubs/index.js';
import { hubSeo } from '../lib/page-seo.js';
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import HighlightBox from '../components/site/HighlightBox.astro';
import HubBoard from '../components/site/HubBoard.astro';
import JumpNav from '../components/site/JumpNav.astro';
import PillNav from '../components/site/PillNav.astro';
import SupportNote from '../components/site/SupportNote.astro';
import { demoteHubCtaRow, linkKeyRoutesHubs, splitCompactLiveBar } from '../lib/hub-content.js';

const { data } = Astro.props;
const iata: string = data.iata;
const seo = hubSeo(data);
const iataLower = iata.toLowerCase();
const variant: string = data.variant;
const airport = data.airportSchema;
// P2-B item 5: per-hub OG image (scripts/generate-og.py) instead of the shared og-image.png
const ogImage = `https://theblueboard.co/og/og-hub-${iataLower}.jpg`;
// The Dive Deep buttons become plain links, and the hub codes in "Key Routes" link to their hub
// pages (this page's own code stays text): src/lib/hub-content.js.
const contentHtml: string = linkKeyRoutesHubs(demoteHubCtaRow(data.contentHtml), iata);
const compactSplit = variant === 'compact' ? splitCompactLiveBar(contentHtml) : null;

// Build Airport schema with optional icaoCode
const airportSchemaObj: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Airport',
  name: airport.name,
  iataCode: airport.iataCode,
};
if (airport.icaoCode) {
  airportSchemaObj.icaoCode = airport.icaoCode;
}
airportSchemaObj.address = {
  '@type': 'PostalAddress',
  addressLocality: airport.addressLocality,
  addressRegion: airport.addressRegion,
  addressCountry: airport.addressCountry,
};
airportSchemaObj.geo = {
  '@type': 'GeoCoordinates',
  latitude: airport.latitude,
  longitude: airport.longitude,
};
airportSchemaObj.url = airport.url;

const faqSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqSchema.map((faq: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

// The eight hubs with a construction/modernization tracker; the seven
// continental ones are also covered by the TFDM paper-strips tracker.
const TRACKER_HUBS = ['ord', 'den', 'iah', 'ewr', 'sfo', 'iad', 'lax', 'gum'];
const STRIP_HUBS = ['ord', 'den', 'iah', 'ewr', 'sfo', 'iad', 'lax'];

const hubNavItems = hubOrder.map((h) => ({
  href: `/hubs/${h}`,
  label: hubNavLabels[h],
  current: h === iataLower,
}));
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={`/hubs/${iataLower}`}
  ogImage={ogImage}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImageAlt={data.ogImageAlt}
  twitterTitle={seo.twitterTitle}
  twitterDescription={seo.twitterDescription}
  jsonLd={[faqSchemaObj, airportSchemaObj]}
  dataAttrs={{ 'data-hub-iata': iata }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Hubs', href: '/hubs' }, { label: data.breadcrumbName }]} />

    {
      variant === 'full' && (
        <>
          <header class="mt-6 border-b border-border pb-5">
            <h1 class="bb-content text-2xl font-bold tracking-tight text-balance text-foreground">
              <Fragment set:html={data.headerTitle.replace(/ — /g, "&nbsp;— ")} />
            </h1>
            <p class="mt-1.5 text-xs text-muted-foreground">{data.subtitle}</p>
            <SupportNote variant="inline" placement="hub-top" />
          </header>

          <HubBoard iata={iata} />

          <p id="scrollHint" class="pt-4 text-center text-xs text-muted-foreground">
            Explore hub details below <span aria-hidden="true">↓</span>
          </p>

          <JumpNav items={data.jumpNav} />
        </>
      )
    }

    {
      compactSplit ? (
        <>
          <div class="bb-content mt-6">
            <Fragment set:html={compactSplit.before} />
          </div>
          <HubBoard iata={iata} metaHtml={compactSplit.metaHtml} liveHref={compactSplit.liveHref} />
          <div class="bb-content mt-6">
            <Fragment set:html={compactSplit.after} />
          </div>
        </>
      ) : (
        <div class="bb-content mt-6">
          <Fragment set:html={contentHtml} />
        </div>
      )
    }

    {
      TRACKER_HUBS.includes(iataLower) && (
        <HighlightBox>
          <strong>Construction &amp; Modernization</strong> — What's changing at United's {iata} hub{
            STRIP_HUBS.includes(iataLower) ? ', and whether its tower still runs on paper flight strips.' : '.'
          }{' '}
          <a href={`/trackers/united-hubs/${iataLower}`}>{iata} projects &rarr;</a>
          {STRIP_HUBS.includes(iataLower) && (
            <>
              {' · '}
              <a href={`/trackers/atc/${iataLower}`}>{iata} paper strips status &rarr;</a>
            </>
          )}
        </HighlightBox>
      )
    }

    <SupportNote variant="card" placement="hub-end" checkedAgainst="Hub routes are cross-checked against The Blue Board's own departure boards and United's announcements." />

    <section class="mt-8 border-t border-border pt-6">
      <h2
        id="all-hubs"
        class="mb-3 border-b border-border pb-1.5 text-base font-bold tracking-tight text-balance text-foreground"
      >
        All United Hubs
      </h2>
      <PillNav items={hubNavItems} label="United hubs" />
    </section>
  </div>

  <script src="../scripts/scroll-hint.ts"></script>
  <!-- The compact pages' jump row arrives in the raw HTML (`.jump-nav`), not through JumpNav. -->
  <script src="../scripts/jump-nav.ts"></script>
</BaseLayout>
