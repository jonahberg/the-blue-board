---
/**
 * The nineteen aircraft-type pages (`/fleet/{slug}`), driven by
 * `src/data/fleet/*.js` plus the registry rows filtered out of
 * `public/data/fleet.json` at build time.
 */
import { fleetOrder, fleetNavLabels } from '../data/fleet/index.js';
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import ContentSection from '../components/site/ContentSection.astro';
import JumpNav from '../components/site/JumpNav.astro';
import PillNav from '../components/site/PillNav.astro';
import StatTile from '../components/site/StatTile.astro';
import fleetDb from '../../public/data/fleet.json';

const { data } = Astro.props;
const slug: string = data.slug;
const typeCode: string = data.typeCode;

// Filter fleet.json for this aircraft type at build time
const typeAircraft = (fleetDb as any[])
  .filter((a: any) => a.t === typeCode)
  .sort((a: any, b: any) => (a.r || '').localeCompare(b.r || ''));

// Keep these pages classified as informational guides rather than product listings.
const aircraftGuideSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: data.title,
  description: data.description,
  url: `https://theblueboard.co/fleet/${slug}`,
  isPartOf: {
    '@type': 'WebSite',
    name: 'The Blue Board',
    url: 'https://theblueboard.co',
  },
  about: {
    '@type': 'Thing',
    name: `United Airlines ${data.displayName}`,
    description: `${data.displayName} guide with fleet count, seat configuration, WiFi, delivery period, and aircraft registry details.`,
    additionalProperty: [
      { '@type': 'PropertyValue', name: 'Manufacturer', value: data.aircraftSchema.manufacturer },
      { '@type': 'PropertyValue', name: 'Model', value: data.aircraftSchema.model },
      { '@type': 'PropertyValue', name: 'Body type', value: data.aircraftSchema.bodyType },
      { '@type': 'PropertyValue', name: 'Engines', value: data.aircraftSchema.engines },
      { '@type': 'PropertyValue', name: 'Range', value: data.aircraftSchema.range },
      { '@type': 'PropertyValue', name: 'Cruise speed', value: data.aircraftSchema.cruiseSpeed },
      { '@type': 'PropertyValue', name: 'Wingspan', value: data.aircraftSchema.wingspan },
      { '@type': 'PropertyValue', name: 'Length', value: data.aircraftSchema.length },
      { '@type': 'PropertyValue', name: 'Fleet count', value: String(data.count) },
      { '@type': 'PropertyValue', name: 'Total seats', value: String(data.seatConfig.total) },
    ],
  },
};

const faqSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqSchema.map((faq: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const SPEC_ROWS: ReadonlyArray<[string, string]> = [
  ['Manufacturer', data.aircraftSchema.manufacturer],
  ['Model', data.aircraftSchema.model],
  ['Body type', data.aircraftSchema.bodyType],
  ['Engines', data.aircraftSchema.engines],
  ['Range', data.aircraftSchema.range],
  ['Cruise speed', data.aircraftSchema.cruiseSpeed],
  ['Wingspan', data.aircraftSchema.wingspan],
  ['Length', data.aircraftSchema.length],
];

const fleetNavItems = fleetOrder.map((t: string) => ({
  href: `/fleet/${t}`,
  label: fleetNavLabels[t],
  current: t === slug,
}));

/** Registry status tone. Always rendered next to the status text, never alone. */
function statusClass(status: string | undefined): string {
  const value = (status || '').toLowerCase();
  if (value.includes('stored')) return 'text-destructive';
  if (value.includes('maint') || value.includes('paint') || value.includes('mod')) {
    return 'text-[var(--bb-warn)]';
  }
  return 'text-muted-foreground';
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={`/fleet/${slug}`}
  ogImage="https://theblueboard.co/og/og-fleet.jpg"
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImageAlt={data.ogImageAlt}
  twitterTitle={data.twitterTitle}
  twitterDescription={data.twitterDescription}
  jsonLd={[faqSchemaObj, aircraftGuideSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Fleet', href: '/fleet' }, { label: data.breadcrumbName }]} />

    <header class="mt-6 border-b border-border pb-5">
      <h1 class="bb-content text-2xl font-bold tracking-tight text-balance text-foreground">
        <Fragment set:html={data.headerTitle} />
      </h1>
      <p class="mt-1.5 text-xs text-muted-foreground">{data.subtitle}</p>
    </header>

    <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
      <StatTile label="Aircraft" value={data.count} />
      <StatTile label="Total Seats" value={data.seatConfig.total} />
      <StatTile label="Deliveries" value={data.deliveryRange} />
      <StatTile label="Body Type" value={data.bodyType === 'widebody' ? 'Wide' : 'Narrow'} />
    </div>

    <div class="mt-6 text-center">
      <a
        class="inline-flex min-h-11 items-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
        href={`/?tab=fleet&type=${encodeURIComponent(typeCode)}`}
      >
        Explore {data.displayName} in Interactive Database &rarr;
      </a>
    </div>

    <p id="scrollHint" class="pt-4 text-center text-xs text-muted-foreground">
      Explore aircraft details below <span aria-hidden="true">&darr;</span>
    </p>

    <JumpNav items={data.jumpNav} />

    <div class="bb-content mt-6">
      <Fragment set:html={data.contentHtml} />
    </div>

    <ContentSection id="specs" heading="Specifications">
      <p>
        Key technical specifications for the {data.displayName} as operated by United Airlines.
      </p>
      <table>
        <tbody>
          {
            SPEC_ROWS.map(([label, value]) => (
              <tr>
                <th scope="row" class="w-[38%] normal-case">
                  {label}
                </th>
                <td>{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </ContentSection>

    <ContentSection
      id="registry"
      heading={`Aircraft Registry — All ${typeAircraft.length} ${data.displayName}`}
    >
      <p>
        Complete list of every United Airlines {data.displayName} with registration, delivery year,
        seat configuration, WiFi, IFE, and current status. Data updated daily from public aviation
        records.
      </p>
      <table class="tabular-nums">
        <thead>
          <tr>
            <th>Reg</th>
            <th>AC#</th>
            <th>Config</th>
            <th>WiFi</th>
            <th>IFE</th>
            <th>Power</th>
            <th>Year</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {
            typeAircraft.map((ac: any) => {
              const isStarlink = ac.w && String(ac.w).toLowerCase().includes('starlink');
              return (
                <tr>
                  <td class="font-mono font-bold text-foreground">{ac.r}</td>
                  <td>{ac.a || '—'}</td>
                  <td>{ac.c || '—'}</td>
                  <td>{isStarlink ? <span class="starlink-on">{ac.w}</span> : ac.w || '—'}</td>
                  <td>{ac.i || '—'}</td>
                  <td>{ac.p || '—'}</td>
                  <td>{ac.d || '—'}</td>
                  <td class={statusClass(ac.s)}>{ac.s || 'Active'}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </ContentSection>

    <ContentSection id="faq" heading="Frequently Asked Questions">
      {
        data.faqSchema.map((faq: { question: string; answer: string }) => (
          <div class="mb-4">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))
      }
    </ContentSection>

    <ContentSection id="all-types" heading="All United Fleet Types">
      <p>Explore every aircraft type in United Airlines' mainline fleet.</p>
      <PillNav items={fleetNavItems} label="United fleet types" />
      <p><a href="/fleet">&larr; Back to Fleet Overview</a></p>
    </ContentSection>
  </div>

  <script src="../scripts/scroll-hint.ts"></script>
</BaseLayout>
