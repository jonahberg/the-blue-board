---
/**
 * The nineteen aircraft-type pages (`/fleet/{slug}`), driven by
 * `src/data/fleet/*.js` plus the registry rows filtered out of
 * `public/data/fleet.json` at build time.
 *
 * `FleetLive` shows this type in the air right now, matched by those same
 * registry rows against the cached live feed (src/lib/fleet-live.js).
 */
import { fleetOrder, fleetNavLabels } from '../data/fleet/index.js';
import BaseLayout from '../components/site/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import ContentSection from '../components/site/ContentSection.astro';
import FleetLive from '../components/site/FleetLive.astro';
import JumpNav from '../components/site/JumpNav.astro';
import PillNav from '../components/site/PillNav.astro';
import ScrollRegion from '../components/site/ScrollRegion.astro';
import StatTile from '../components/site/StatTile.astro';
import SupportNote from '../components/site/SupportNote.astro';
import { wrapTables } from '../components/site/table-regions';
import fleetDb from '../../public/data/fleet.json';
import { STARLINK_ROSTER_AS_OF, starlinkForType } from '../data/starlink-facts.js';
import { FLEET_DB_AS_OF, formatFleetAsOf, normalizeWifi } from '../lib/fleet-utils.js';
import { fleetSeo } from '../lib/page-seo.js';
import { fleetLiveListHref } from '../lib/fleet-live.js';
import { isStarlinkWifi, registryRowLinks } from '../lib/fleet-registry-links.js';
import { registryStarlinkNote } from '../lib/starlink-facts.js';

const { data } = Astro.props;
const slug: string = data.slug;
const typeCode: string = data.typeCode;
const seo = fleetSeo(data);

// Filter fleet.json for this aircraft type at build time
const typeAircraft = (fleetDb as any[])
  .filter((a: any) => a.t === typeCode)
  .sort((a: any, b: any) => (a.r || '').localeCompare(b.r || ''));

// The registry's WiFi column is the fleet database; the page's Starlink figure ("48 of the 79 had
// it as of 11 Nov") is the Starlink roster joined to it. Where the two disagree, the table says
// both, with their days (src/lib/starlink-facts.js registryStarlinkNote) — on every type page.
const registryNote = registryStarlinkNote({
  marked: typeAircraft.filter((a: any) => isStarlinkWifi(a.w)).length,
  roster: starlinkForType(typeCode).equipped,
  rosterAsOf: STARLINK_ROSTER_AS_OF,
});

// Keep these pages classified as informational guides rather than product listings.
const aircraftGuideSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: seo.title,
  description: seo.description,
  url: `https://theblueboard.co/fleet/${slug}`,
  isPartOf: {
    '@type': 'WebSite',
    name: 'The Blue Board',
    url: 'https://theblueboard.co',
  },
  about: {
    '@type': 'Thing',
    name: `United Airlines ${data.displayName}`,
    description: `${data.displayName} guide with fleet count, seat configuration, WiFi, delivery period, and aircraft registry details.`,
    additionalProperty: [
      { '@type': 'PropertyValue', name: 'Manufacturer', value: data.aircraftSchema.manufacturer },
      { '@type': 'PropertyValue', name: 'Model', value: data.aircraftSchema.model },
      { '@type': 'PropertyValue', name: 'Body type', value: data.aircraftSchema.bodyType },
      { '@type': 'PropertyValue', name: 'Engines', value: data.aircraftSchema.engines },
      { '@type': 'PropertyValue', name: 'Range', value: data.aircraftSchema.range },
      { '@type': 'PropertyValue', name: 'Cruise speed', value: data.aircraftSchema.cruiseSpeed },
      { '@type': 'PropertyValue', name: 'Wingspan', value: data.aircraftSchema.wingspan },
      { '@type': 'PropertyValue', name: 'Length', value: data.aircraftSchema.length },
      { '@type': 'PropertyValue', name: 'Fleet count', value: String(data.count) },
      { '@type': 'PropertyValue', name: 'Total seats', value: String(data.seatConfig.total) },
    ],
  },
};

const faqSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqSchema.map((faq: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const SPEC_ROWS: ReadonlyArray<[string, string]> = [
  ['Manufacturer', data.aircraftSchema.manufacturer],
  ['Model', data.aircraftSchema.model],
  ['Body type', data.aircraftSchema.bodyType],
  ['Engines', data.aircraftSchema.engines],
  ['Range', data.aircraftSchema.range],
  ['Cruise speed', data.aircraftSchema.cruiseSpeed],
  ['Wingspan', data.aircraftSchema.wingspan],
  ['Length', data.aircraftSchema.length],
];

const fleetNavItems = fleetOrder.map((t: string) => ({
  href: `/fleet/${t}`,
  label: fleetNavLabels[t],
  current: t === slug,
}));

// Registry links (src/lib/fleet-registry-links.js) are 44 px tall on touch and relax only for a
// mouse at md+ (DESIGN.md touch rule), reaching into the cell's padding (-my-1.5) so a row is 44 px
// rather than 56, and a mouse keeps the table exactly as dense as before: the /fleet index's
// `touchRowLink`. The tail is the row's one link-coloured link (the row is about it); "Starlink"
// keeps the content pages' quiet underlined look from `.bb-content a`, in Starlink violet.
const touchRowLink = 'inline-flex min-h-11 items-start -my-1.5 pt-1.5 pointer-fine:md:my-0 pointer-fine:md:inline pointer-fine:md:min-h-0 pointer-fine:md:pt-0';
const tailLinkClass = `${touchRowLink} font-bold text-primary no-underline underline-offset-2 hover:underline hover:decoration-current`;

/** Registry status tone. Always rendered next to the status text, never alone. */
function statusClass(status: string | undefined): string {
  const value = (status || '').toLowerCase();
  if (value.includes('stored')) return 'text-destructive';
  if (value.includes('maint') || value.includes('paint') || value.includes('mod')) {
    return 'text-bb-warn';
  }
  return 'text-muted-foreground';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={`/fleet/${slug}`}
  ogImage="https://theblueboard.co/og/og-fleet.jpg"
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImageAlt={data.ogImageAlt}
  twitterTitle={seo.twitterTitle}
  twitterDescription={seo.twitterDescription}
  jsonLd={[faqSchemaObj, aircraftGuideSchema]}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs items={[{ label: 'Fleet', href: '/fleet' }, { label: data.breadcrumbName }]} />

    <header class="mt-6 border-b border-border pb-5">
      {/* The type code in the h1 (`.type-badge`, mono) names this page, so it is not a link
          (ruling 1, self-links are plain) and takes body colour: link colour on it was decoration
          (DESIGN.md "colour that is not a status signal is decoration"). */}
      <h1 class="bb-content text-2xl font-bold tracking-tight text-balance text-foreground [&_.type-badge]:text-foreground">
        <Fragment set:html={data.headerTitle.replace(/ — /g, "&nbsp;— ")} />
      </h1>
      <p class="mt-1.5 text-xs text-muted-foreground">{data.subtitle}</p>
      <SupportNote variant="inline" placement="fleet-top" />
    </header>

    <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
      <StatTile label="Aircraft" value={data.count} />
      <StatTile label="Total Seats" value={data.seatConfig.total} />
      <StatTile label="Deliveries" value={data.deliveryRange} />
      <StatTile label="Body Type" value={data.bodyType === 'widebody' ? 'Wide' : 'Narrow'} />
    </div>

    <FleetLive
      displayName={data.displayName}
      tails={typeAircraft.map((a: any) => String(a.r || '')).filter(Boolean)}
      listHref={fleetLiveListHref(typeCode)}
    />

    <div class="mt-6 text-center">
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-primary-fill px-6 py-2 text-center text-sm leading-snug font-semibold text-balance text-primary-foreground hover:bg-primary-fill/90"
        href={`/?tab=fleet&type=${encodeURIComponent(typeCode)}`}
      >
        Explore {data.displayName} in Interactive Database &rarr;
      </a>
    </div>

    <p id="scrollHint" class="pt-4 text-center text-xs text-muted-foreground">
      Explore aircraft details below <span aria-hidden="true">&darr;</span>
    </p>

    <JumpNav items={data.jumpNav} />

    <div class="bb-content mt-6">
      <Fragment set:html={wrapTables(data.contentHtml)} />
    </div>

    <ContentSection id="specs" heading="Specifications">
      <p>
        Key technical specifications for the {data.displayName} as operated by United Airlines.
      </p>
      <ScrollRegion label="Specifications">
        <table>
          <tbody>
            {
              SPEC_ROWS.map(([label, value]) => (
                <tr>
                  <th scope="row" class="w-[38%] normal-case">
                    {label}
                  </th>
                  <td>{value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </ScrollRegion>
    </ContentSection>

    <ContentSection
      id="registry"
      heading={`Aircraft Registry — All ${typeAircraft.length} ${data.displayName}`}
    >
      <p>
        Complete list of every United Airlines {data.displayName} with registration, delivery year,
        seat configuration, WiFi, IFE, and current status, from public aviation records — as of
        <time datetime={FLEET_DB_AS_OF}>{formatFleetAsOf()}</time>.{registryNote ? ` ${registryNote}` : ''}
      </p>
      <ScrollRegion label="Aircraft registry">
        <table class="tabular-nums">
          <thead>
            <tr>
              <th>Reg</th>
              <th>AC#</th>
              <th>Config</th>
              <th>WiFi</th>
              <th>IFE</th>
              <th>Power</th>
              <th>Year</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {
              typeAircraft.map((ac: any) => {
                const isStarlink = isStarlinkWifi(ac.w);
                const links = registryRowLinks(ac);
                return (
                  <tr>
                    <td class="font-mono font-bold text-foreground">
                      {links.reg ? <a class={tailLinkClass} href={links.reg}>{ac.r}</a> : ac.r}
                    </td>
                    <td class="font-mono">{ac.a || '—'}</td>
                    <td class="font-mono whitespace-nowrap">{ac.c || '—'}</td>
                    {/* The database's raw codes are inconsistent ('Satl Ku' / 'Satl KU'); the
                        dashboard's display names are not (F78). */}
                    <td>
                      {isStarlink ? (
                        links.wifi ? (
                          <a class={touchRowLink} href={links.wifi}><span class="starlink-on">{ac.w}</span></a>
                        ) : (
                          <span class="starlink-on">{ac.w}</span>
                        )
                      ) : ac.w ? (
                        normalizeWifi(ac.w)
                      ) : (
                        '—'
                      )}
                    </td>
                    <td>{ac.i || '—'}</td>
                    <td>{ac.p || '—'}</td>
                    <td class="font-mono">{ac.d || '—'}</td>
                    <td class={statusClass(ac.s)}>{ac.s || 'Active'}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </ScrollRegion>
    </ContentSection>

    <ContentSection id="faq" heading="Frequently Asked Questions">
      {
        data.faqSchema.map((faq: { question: string; answer: string }) => (
          <div class="mb-4">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))
      }
    </ContentSection>

    <SupportNote
      variant="card"
      placement="fleet-end"
      checkedAgainst="Fleet data is cross-checked against the FAA registry and United's own announcements."
    />

    <ContentSection id="all-types" heading="All United Fleet Types">
      <p>Explore every aircraft type in United Airlines' mainline fleet.</p>
      <PillNav items={fleetNavItems} label="United fleet types" />
      <p><a href="/fleet" class="inline-flex min-h-11 items-center">&larr; Back to Fleet Overview</a></p>
    </ContentSection>
  </div>

  <script src="../scripts/scroll-hint.ts"></script>
</BaseLayout>
