---
/**
 * The in-page "jump to a section" pill row used by the hub, fleet-type and
 * Newark pages. Matches `.bb-content .jump-nav` in `content.css`, which styles
 * the same row when it arrives inside a raw `contentHtml` string.
 */

interface Props {
  items: ReadonlyArray<{ href: string; label: string }>;
  label?: string;
}

const { items, label = 'Section navigation' } = Astro.props;
---
{
  items.length > 0 && (
    <nav aria-label={label} class="my-6 flex flex-wrap gap-2">
      {items.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-11 items-center rounded-full border border-border bg-card px-4 text-[10px] font-semibold tracking-wider text-muted-foreground uppercase hover:border-primary hover:bg-primary hover:text-primary-foreground"
        >
          {item.label}
        </a>
      ))}
    </nav>
  )
}
