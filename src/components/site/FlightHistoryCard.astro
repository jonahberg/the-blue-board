---
/**
 * "This flight, last 30 days": one square per day since the archive (flight_history) started
 * collecting, never padded to 30. Each square carries a glyph and a screen-reader line as well as
 * its colour (DESIGN.md status rule); the key and the count line say the same thing in words.
 * The rule for "on time" is the board's own (src/lib/hub-health.js ON_TIME_GRACE_MIN) and the
 * note under the count names it. Filled by src/scripts/flight-page.ts from
 * `flightHistoryView()` (src/lib/flight-page.js).
 */
---

<section class="flex min-w-0 flex-col rounded-lg border border-border bg-card p-4" aria-labelledby="fp-history-title" data-fp-history>
  <div class="flex items-baseline justify-between gap-2">
    <h2 id="fp-history-title" class="text-sm font-semibold text-foreground" data-f="title">This flight, last 30 days</h2>
    <span class="font-mono text-[11px] text-muted-foreground" data-f="route"></span>
  </div>
  <ol class="mt-3 grid grid-cols-10 gap-1" data-f="strip"></ol>
  <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-muted-foreground" aria-hidden="true" data-f="key"></ul>
  <p class="mt-3 text-sm leading-relaxed text-foreground" data-f="count"></p>
  <p class="mt-1 text-sm leading-relaxed text-foreground" data-f="typical" hidden></p>
  <p class="mt-auto pt-3 text-[11px] leading-relaxed text-muted-foreground" data-f="note"></p>

  <template data-fp-day>
    <li class="flex aspect-square min-h-5 items-center justify-center rounded-sm border text-[11px] leading-none font-semibold">
      <span aria-hidden="true" data-f="glyph"></span>
      <span class="sr-only" data-f="sr"></span>
    </li>
  </template>
</section>
