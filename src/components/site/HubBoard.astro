---
/**
 * The hub pages' departures board: the next United departures from this hub, one line of board
 * truth for the day, a "data as of" stamp, and ONE way into the full Schedule board.
 *
 * Progressive enhancement, in three states (`data-state` on the section):
 *  - `static`  what the HTML ships: the heading, a quiet line and the button. Complete on its own,
 *              which is all a JS-off reader or a failed fetch ever sees.
 *  - `live`    src/scripts/hub-board.ts filled the list from /api/hub-board (the stored schedule
 *              snapshot — no provider is ever called for this page).
 *  - `unavailable`  no board to show: the quiet line stays and the reserved height is released.
 *
 * Layout shift: while scripting is ENABLED the body reserves the height of eight rows (and only
 * then — `[@media(scripting:enabled)]`, so a JS-off page has no empty frame). The rows have fixed
 * heights on both layouts so the reservation is exact. Below `md` each row is two lines like the
 * dashboard's phone board; from `md` it is one table-like line under a column header.
 *
 * No `aria-live`: the board refreshes on a timer, and a region that re-announces eight rows every
 * two minutes would talk over the page (DESIGN.md live-region inventory).
 */
import { ArrowRight, PlaneTakeoff } from 'lucide-react';

interface Props {
  iata: string;
  /** Copy carried over from a compact page's old LIVE bar (ICAO · time zone · terminal), as HTML. */
  metaHtml?: string;
  /**
   * A compact page's link to the dashboard's live map (`/?hub=gum`), carried over from its old
   * LIVE bar. The full pages have theirs in "More on the dashboard". A quiet text link, so the
   * board keeps its one button.
   */
  liveHref?: string;
}

const { iata, metaHtml = '', liveHref = '' } = Astro.props;
const hubLower = iata.toLowerCase();
const boardHref = `/?tab=schedule&hub=${hubLower}`;
const titleId = `hub-board-title-${hubLower}`;
---

<section
  class="mt-6 rounded-lg border border-border bg-card"
  aria-labelledby={titleId}
  data-hub-board={iata}
  data-state="static"
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 border-b border-border px-4 py-3">
    <h2 id={titleId} class="text-sm font-semibold tracking-tight text-foreground">
      Next United departures from <span class="font-mono">{iata}</span>
    </h2>
    <p
      class="w-full font-mono text-[11px] text-muted-foreground tabular-nums sm:w-auto [@media(scripting:enabled)]:min-h-4"
      data-hb-stamp
    >
    </p>
  </div>

  <div
    class="flex flex-col px-4 [@media(scripting:enabled)]:min-h-[28.25rem] md:[@media(scripting:enabled)]:min-h-[26.75rem]"
    data-hb-body
  >
    <p class="pt-2.5 text-xs leading-5 text-muted-foreground" data-hb-truth hidden></p>

    <p class="my-auto py-4 text-xs leading-relaxed text-muted-foreground" data-hb-fallback>
      Today's {iata} departures, with gates, delays and cancellations, are on the full board.
    </p>

    <div data-hb-table hidden>
      <div
        class="mt-2 hidden h-7 grid-cols-[3rem_4.5rem_3.5rem_minmax(0,1fr)_6rem_10rem] items-center gap-x-3 border-b border-border font-mono text-[11px] tracking-wider text-muted-foreground uppercase md:grid"
        aria-hidden="true"
      >
        <span>Time</span><span>Flight</span><span class="col-span-2">To</span><span>Gate</span><span class="text-right">Status</span>
      </div>
      <ol class="mb-2 max-md:mt-2" aria-label={`Next United departures from ${iata}`} data-hb-list></ol>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-border px-4 py-3">
    <p class="text-[11px] leading-relaxed text-muted-foreground">
      {metaHtml ? <Fragment set:html={metaHtml} /> : <>Times are local to {iata}.</>}
    </p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {
        liveHref && (
          <a
            class="inline-flex min-h-11 items-center text-xs font-semibold text-foreground underline decoration-muted-foreground/40 underline-offset-2 hover:decoration-foreground focus-visible:decoration-foreground"
            href={liveHref}
          >
            Live {iata} map
          </a>
        )
      }
      <a
        class="inline-flex min-h-11 items-center gap-1.5 rounded-md bg-primary-fill px-5 text-xs font-semibold text-primary-foreground hover:bg-primary-fill/90"
        href={boardHref}
      >
        Open the full {iata} board
        <ArrowRight aria-hidden="true" className="size-4" />
      </a>
    </div>
  </div>

  <!-- The flight number links to its flight page (src/scripts/flight-link.ts). Its hit box is the
       whole row height over the flight column (the `after:` box is placed on the `relative` row,
       at the column's offset in each grid below, and takes in the row's 1 px rule), so a tap
       anywhere in that column lands — 48 px on a phone row, 44 px from md — while the status pill and the delay keep their own titles.
       It runs right up to where the destination's box starts (112 px on a phone, 144 px from md),
       so the two abut: no dead sliver between them, and no overlap.
       A number the site has no page for stays text: the script leaves the `<a>` without an href.
       The far end links to its hub page when it is another of the nine hubs (links everywhere,
       Nov 12 2026; `destHref`, src/lib/hub-board-view.js), any other airport stays text. It is a
       quiet link (body colour, muted underline) so the board's one button stays the way in. Its hit
       box is hung off the row the same way, over the "To" column (48 px wide and the row's height
       on a phone, the column's 56 px from md), clear of the flight column's box and the status. On a
       phone that column is `minmax(3rem,1fr)`, never narrower than the box, so a wide status group
       truncates its pill instead of sliding under the box. The link's focus ring is drawn inside it
       (`-outline-offset-2`): the truncating cell around it would clip a ring drawn outside. -->
  <template data-hb-row>
    <li
      class="relative grid h-12 grid-cols-[2.75rem_3.25rem_minmax(3rem,1fr)_auto] grid-rows-[1.25rem_1rem] content-center gap-x-2 border-b border-border last:border-b-0 md:h-11 md:grid-cols-[3rem_4.5rem_3.5rem_minmax(0,1fr)_6rem_10rem] md:grid-rows-1 md:gap-x-3"
    >
      <span class="col-start-1 row-span-2 flex flex-col font-mono tabular-nums md:row-span-1 md:justify-center">
        <span class="text-xs leading-5 text-foreground" data-f="time"></span>
        <span class="text-[11px] leading-4 text-muted-foreground" data-f="under"></span>
      </span>
      <a
        class="col-start-2 row-start-1 self-center justify-self-start font-mono text-xs font-semibold text-primary underline-offset-2 after:absolute after:top-0 after:-bottom-px after:left-12 after:w-16 hover:underline md:after:left-[3.375rem] md:after:w-[5.625rem] [&:not([href])]:text-foreground [&:not([href])]:no-underline [&:not([href])]:after:hidden"
        data-f="ident"></a
      >
      <span class="col-start-3 row-start-1 min-w-0 self-center truncate font-mono text-xs text-foreground">
        <span class="sr-only">to </span><a
          class="underline decoration-muted-foreground/40 underline-offset-2 after:absolute after:top-0 after:-bottom-px after:left-28 after:w-12 hover:decoration-foreground focus-visible:decoration-foreground focus-visible:-outline-offset-2 md:after:left-36 md:after:w-14 [&:not([href])]:no-underline [&:not([href])]:after:hidden"
          data-f="dest"></a
        >
      </span>
      <span
        class="col-span-2 col-start-2 row-start-2 min-w-0 truncate text-[11px] leading-4 text-muted-foreground md:col-span-1 md:col-start-4 md:row-start-1 md:self-center md:text-xs"
        data-f="city"
      ></span>
      <span
        class="col-start-4 row-start-2 min-w-0 truncate text-right font-mono text-[11px] leading-4 text-muted-foreground md:col-start-5 md:row-start-1 md:self-center md:text-left md:text-xs"
        data-f="gate"
      ></span>
      <span class="col-start-4 row-start-1 flex min-w-0 items-center justify-end gap-1.5 self-center md:col-start-6">
        <span class="truncate rounded-sm border px-1.5 text-[11px] leading-4 font-medium whitespace-nowrap" data-f="pill"></span>
        <span
          class="shrink-0 rounded-sm bg-secondary px-1 font-mono text-[11px] leading-4 font-semibold tracking-wide text-secondary-foreground"
          data-f="live">LIVE</span
        >
        <span class="inline-flex shrink-0 items-center gap-0.5 font-mono text-xs font-semibold whitespace-nowrap tabular-nums" data-f="delay">
          <PlaneTakeoff aria-hidden="true" className="size-3 shrink-0 text-muted-foreground" data-f="runway" />
        </span>
      </span>
    </li>
  </template>
</section>

<script src="../../scripts/hub-board.ts"></script>
