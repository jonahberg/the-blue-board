---
/**
 * Visible breadcrumb trail plus the matching BreadcrumbList structured data.
 *
 * The trail always starts at the site root, so callers pass only the levels
 * below it. The last item is the current page and is not a link.
 */
import JsonLd from './JsonLd.astro';
import { SITE_URL } from '../../lib/site.js';

export interface Crumb {
  label: string;
  /** Site-root path, e.g. `/hubs`. Omit on the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ label: 'The Blue Board', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: `${SITE_URL}${crumb.href === '/' ? '' : crumb.href}` } : {}),
  })),
};
---
{/* Each link is 44 px tall on touch without moving the row: the negative margin gives back the
    extra height, so the hit area reaches into the space above and below the trail. */}
<nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      trail.map((crumb, index) => (
        <li class="flex items-center gap-1.5">
          {crumb.href ? (
            <a
              href={crumb.href}
              class="-my-3.5 inline-flex min-h-11 items-center underline underline-offset-2 hover:text-foreground pointer-fine:md:my-0 pointer-fine:md:min-h-0"
            >
              {crumb.label}
            </a>
          ) : (
            <span aria-current="page" class="text-foreground">
              {crumb.label}
            </span>
          )}
          {/* The separator trails its crumb, so a wrapped line never starts with a bare "/". */}
          {index < trail.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={schema} />
