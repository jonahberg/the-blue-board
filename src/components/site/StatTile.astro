---
/**
 * One labelled figure in a stat row (hub live panel, fleet type header,
 * fleet index summary). Same family as the trackers' StatStrip and detail
 * tiles: the classes live in ./stat-tile.ts.
 *
 * `id` is passed through to the value element so a page script can update it
 * in place — the hub live panel writes the active-flight count into `#active`.
 */
import { STAT_CARD, STAT_LABEL, STAT_VALUE } from './stat-tile';

interface Props {
  label: string;
  value: string | number;
  /** DOM id for the value element, for scripts that refresh it. */
  id?: string;
  class?: string;
}

const { label, value, id, class: className = '' } = Astro.props;
---
<div class:list={[STAT_CARD, className]}>
  <div class={STAT_LABEL}>{label}</div>
  <div id={id} class:list={[STAT_VALUE, 'text-foreground']}>{value}</div>
</div>
