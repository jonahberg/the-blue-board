---
/**
 * A callout box. The Astro-side twin of `.bb-content .highlight-box` in
 * `content.css`, so a callout written in a page looks identical to one that
 * arrives inside a raw `contentHtml` string.
 *
 * `tone` only tints the left rule — every call site also carries a bold label
 * or an icon, so the tone is never the only signal (design spec §2.4).
 */

interface Props {
  tone?: 'default' | 'warn' | 'ok' | 'alert';
  class?: string;
}

const { tone = 'default', class: className = '' } = Astro.props;

// `--bb-warn` / `--bb-ok` are the two status hues declared in `content.css`.
const TONE_CLASS = {
  default: 'border-l-primary',
  warn: 'border-l-[var(--bb-warn)]',
  ok: 'border-l-[var(--bb-ok)]',
  alert: 'border-l-destructive',
} as const;
---
<div
  class:list={[
    'bb-content my-4 rounded-r-md border-l-2 bg-card px-4 py-3 text-xs leading-relaxed text-muted-foreground',
    TONE_CLASS[tone],
    className,
  ]}
>
  <slot />
</div>
