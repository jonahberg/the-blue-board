---
/**
 * "The read": the existing AI delay explanation (/api/delay-explain), asked for ONLY when the
 * reader presses the button. Crawlers load these pages, and a model call per page view would be
 * a bill nobody asked for; nothing in this card runs on load.
 *
 * On press, the script scores the leg with the board's own delay-risk model from the dashboard's
 * shared, CDN-cached inputs (/api/faa, /api/nas, /api/irops, /api/metar) and sends the same request
 * body the board's explain dialog sends (src/lib/flight-page-read.js). Only a flight that has not
 * left gets a prediction, exactly as on the board, so the button is offered only then.
 */
import { Sparkles } from 'lucide-react';
---

<section class="flex min-w-0 flex-col rounded-lg border border-border bg-card p-4" aria-labelledby="fp-read-title" data-fp-read>
  <div class="flex items-baseline justify-between gap-2">
    <h2 id="fp-read-title" class="text-sm font-semibold text-foreground">The read</h2>
    <span class="font-mono text-[11px] tracking-wide text-muted-foreground uppercase">AI, on request</span>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground" data-f="intro"></p>
  <div data-f="ask-block" hidden>
    <button
      type="button"
      class="mt-3 inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border px-4 text-sm font-semibold text-foreground hover:bg-accent disabled:opacity-60"
      data-f="ask"
    >
      <Sparkles aria-hidden="true" className="size-4" />
      <span data-f="ask-label">Explain the delay risk</span>
    </button>
  </div>
  <div role="status" data-f="answer-region">
    <p class="mt-3 font-mono text-[11px] text-muted-foreground tabular-nums" data-f="risk" hidden></p>
    <p class="mt-1 text-sm leading-relaxed text-foreground" data-f="answer" hidden></p>
  </div>
  <p class="mt-auto pt-3 text-[11px] leading-relaxed text-muted-foreground" data-f="note">
    Written by an AI model from the data shown on this site. It can be wrong; check with United before you travel.
  </p>
</section>
