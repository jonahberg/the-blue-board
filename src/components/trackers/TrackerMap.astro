---
// Build-time inline SVG US map — zero dependencies, zero render JS. Status is encoded twice:
// colour AND marker shape (dot / diamond / ring), per the site's never-colour-alone rule.
// Interaction is an inspector card below the map (populated by `src/scripts/trackers.ts` on
// hover/focus/tap of a marker); with JS off the map is a static overview and the table below
// carries the detail. Airports outside CONUS/AK/HI render as an honest "beyond the map" strip
// rather than being silently dropped.
//
// Shapes draw with `currentColor`, so one tone class on the wrapping `<g>` colours the marker,
// and the legend reuses the same map.
import StatusBadge from './StatusBadge.astro';
import { TONE_TEXT, toneClass } from './tones';

interface MapPoint {
  id: string;
  code: string;
  x: number;
  y: number;
  shape: 'dot' | 'diamond' | 'ring';
  tone: string;
  label?: boolean;
  card: {
    title: string;
    badge: { label: string; tone: string; glyph: string };
    line1?: string;
    line2?: string;
  };
}

interface Props {
  paths: { conus: string; alaska: string; hawaii: string };
  points: MapPoint[];
  legend: { label: string; shape: 'dot' | 'diamond' | 'ring'; tone: string }[];
  offMap?: { title: string; badge: { label: string; tone: string; glyph: string } }[];
  ariaLabel: string;
  hint: string;
}

const { paths, points, legend, offMap = [], ariaLabel, hint } = Astro.props;
---

<div data-trk-map>
  <!-- role=group (not img): img would make the focusable marker buttons
       presentational to AT — axe nested-interactive -->
  <svg
    viewBox="0 0 960 600"
    class="block h-auto w-full rounded-md border border-border bg-card"
    role="group"
    aria-label={ariaLabel}
  >
    <g class="trk-map-outline" aria-hidden="true">
      <path d={paths.conus}></path>
      <path d={paths.alaska}></path>
      <path d={paths.hawaii}></path>
    </g>
    <g>
      {
        points.map((p) => (
          <g
            class:list={[
              'trk-marker group cursor-pointer focus-visible:outline-none',
              toneClass(TONE_TEXT, p.tone),
            ]}
            data-trk-marker={p.id}
            tabindex="0"
            role="button"
            aria-label={`${p.card.title} — ${p.card.badge.label}`}
          >
            <circle class="fill-transparent" cx={p.x} cy={p.y} r="14" />
            {p.shape === 'dot' && (
              <circle
                class="trk-marker-shape"
                cx={p.x}
                cy={p.y}
                r="4.5"
                fill="currentColor"
              />
            )}
            {p.shape === 'diamond' && (
              <rect
                class="trk-marker-shape"
                x={p.x - 3.8}
                y={p.y - 3.8}
                width="7.6"
                height="7.6"
                fill="currentColor"
                transform={`rotate(45 ${p.x} ${p.y})`}
              />
            )}
            {p.shape === 'ring' && (
              <circle
                class="trk-marker-shape"
                cx={p.x}
                cy={p.y}
                r="3.6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              />
            )}
            {p.label && (
              <text
                class="fill-muted-foreground font-mono text-[9px] font-semibold tracking-wide"
                x={p.x}
                y={p.y - 9}
                text-anchor="middle"
              >
                {p.code}
              </text>
            )}
          </g>
        ))
      }
    </g>
  </svg>

  <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1.5" role="list" aria-label="Map legend">
    {
      legend.map((l) => (
        <span
          class="inline-flex items-center gap-1.5 font-mono text-[10px] font-semibold uppercase tracking-wide text-muted-foreground"
          role="listitem"
        >
          <svg
            viewBox="0 0 14 14"
            class:list={['size-3.5 shrink-0', toneClass(TONE_TEXT, l.tone)]}
            aria-hidden="true"
          >
            {l.shape === 'dot' && <circle cx="7" cy="7" r="4.5" fill="currentColor" />}
            {l.shape === 'diamond' && (
              <rect
                x="3.2"
                y="3.2"
                width="7.6"
                height="7.6"
                fill="currentColor"
                transform="rotate(45 7 7)"
              />
            )}
            {l.shape === 'ring' && (
              <circle cx="7" cy="7" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6" />
            )}
          </svg>
          {l.label}
        </span>
      ))
    }
  </div>

  <div
    class="mt-2.5 min-h-15 rounded-md border border-border bg-card px-3.5 py-2.5"
    data-trk-card-slot
    aria-live="polite"
  >
    <div
      class="pt-2.5 font-mono text-[10px] uppercase tracking-wide text-muted-foreground"
      data-trk-card-hint
    >
      {hint}
    </div>
    {
      points.map((p) => (
        <div hidden data-trk-card={p.id}>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="text-sm font-bold text-foreground">{p.card.title}</span>
            <StatusBadge
              label={p.card.badge.label}
              tone={p.card.badge.tone}
              glyph={p.card.badge.glyph}
            />
          </div>
          {p.card.line1 && (
            <div class="mt-1 text-xs leading-relaxed text-muted-foreground">{p.card.line1}</div>
          )}
          {p.card.line2 && (
            <div class="mt-1 text-[11px] leading-relaxed text-muted-foreground">{p.card.line2}</div>
          )}
        </div>
      ))
    }
  </div>

  {
    offMap.length > 0 && (
      <div class="mt-2.5 flex flex-wrap items-center gap-x-3.5 gap-y-2">
        <span class="font-mono text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
          Beyond the map:
        </span>
        {offMap.map((o) => (
          <span class="inline-flex items-center gap-1.5">
            <StatusBadge label={o.badge.label} tone={o.badge.tone} glyph={o.badge.glyph} />
            <span class="text-[11px] text-muted-foreground">{o.title}</span>
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  /* The land outline is drawn from data-driven `d` attributes — a fill and stroke on a
     generated <path> is not something a utility class can reach. */
  .trk-map-outline path {
    fill: color-mix(in oklab, var(--muted) 55%, transparent);
    stroke: var(--border);
    stroke-width: 1;
  }

  /* Hover/focus halo on the marker. The shape carries no stroke of its own for dots and
     diamonds, so this is an addition, not an override — and it has to select a CHILD of the
     focused <g>, which is the one thing the utility syntax cannot express on an SVG group. */
  .trk-marker:hover .trk-marker-shape,
  .trk-marker:focus-visible .trk-marker-shape {
    stroke: var(--primary);
    stroke-width: 2;
  }
</style>
