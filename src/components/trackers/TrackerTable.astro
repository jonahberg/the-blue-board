---
import ScrollRegion from '../site/ScrollRegion.astro';
import StatusBadge from './StatusBadge.astro';
import SourceDisclosure from './SourceDisclosure.astro';

// The sortable registry table — also the SEO surface: every entry is real text at build time.
// Sorting and filtering are progressive enhancement via `src/scripts/trackers.ts` reading the
// `data-sort` / `data-trk-*` attributes; with JS off this is a complete static table.
//
// Cell descriptor: { primary, href?, tone?, secondary?, mono?, dim?, badge?: {label, tone, glyph},
//                    link?: {href, text, tone?}, evidence?, sortVal? }
//
// LINKS (links everywhere, Nov 12 2026). `href` makes the cell's primary text a link (a hub code to
// its hub page, a project name to its card); `link` is the arrow link under it ("ORD status →").
// Each takes a tone: 'entry' (the default) is the row's own link — the entry's page, in link
// colour, one per row — and 'quiet' is every other link in the row: body colour with a muted
// underline that takes the text colour on hover and focus. A primary link is 44 px on touch and
// relaxes for a mouse at md (`touchRowLink`, after the fleet index's pattern), so an 89-row table
// keeps its height with a mouse.
//
// BELOW `md` THE SAME TABLE IS A STACK OF CARDS (the dashboard's phone schedule board solves the
// same problem with a two-line row): six or seven columns scrolled sideways at 390 px and every
// row was ~200 px tall. It stays ONE table, restyled — never a second list — because the search
// filter counts `[data-trk-row]`, the sort reorders `<tr>`s by header index, and `#row-…` ids are
// the targets of the briefing strip and Share. Each row becomes a two-column grid:
//
//   ORD  Chicago O'Hare International          [● LIVE]
//   Chicago, IL                 Went digital Nov 2025
//   Note text…                          United hub →
//   Sources (3) verified …            [Watch] [Share]
//
// A column's `phone` classes place its cell in that grid (default: a full-width line) and
// `phoneLabel` prints a visible label before a value that does not explain itself (a date, a
// scale). That label is `aria-hidden`: the explicit table roles below keep every cell tied to its
// column header for a screen reader, which a `display` change on a table can otherwise drop
// (WebKit), so the header already names it. The sortable headers stay, as a row of sort pills;
// the others are visually hidden but still head their columns. A "Sort by" caption leads that
// row on screen only (`content: 'Sort by' / ''` gives it no spoken text).
interface Column {
  key: string;
  label: string;
  sortable?: boolean;
  /** Where the cell sits in the phone card (below md), as literal Tailwind classes. */
  phone?: string;
  /** A visible label before the value in the phone card. */
  phoneLabel?: string;
}

interface Props {
  caption: string;
  columns: Column[];
  rows: { id: string; searchText: string; cells: Record<string, any> }[];
}

const { caption, columns, rows } = Astro.props;

/** "ORD status →": the arrow never wraps onto a line of its own. */
const linkText = (text: string) => String(text).replace(/ (→|&rarr;)$/, ' →');

type Tone = 'entry' | 'quiet' | undefined;
/** The row's own link (link colour) or any other link in the row (body colour, quiet underline). */
const toneClass = (tone: Tone) =>
  tone === 'quiet'
    ? 'text-foreground underline decoration-muted-foreground/40 underline-offset-2 hover:decoration-foreground focus-visible:decoration-foreground'
    : 'text-primary underline-offset-2 hover:underline';
/**
 * After src/pages/fleet/index.astro `touchRowLink`: 44 px on touch, the text's own height for a
 * mouse at md, the text level with the row's other cells (it reaches up into the cell's padding).
 * Two changes for these tables: a 44 px minimum width, because a three-letter code ("ORD") is 20 px
 * wide; and it reaches UP only (`-mt-1.5`, not `-my-1.5`), because a project name wraps to three or
 * four lines in a narrow column, and a box pulled down as well ran 5 px into the "airport builds"
 * line under it (measured at 820 px with the touch classes). A touch row is a few pixels taller.
 */
const touchRowLink =
  'inline-flex min-h-11 min-w-11 items-start -mt-1.5 pt-1.5 pointer-fine:md:mt-0 pointer-fine:md:inline pointer-fine:md:min-h-0 pointer-fine:md:min-w-0 pointer-fine:md:pt-0';

// From md to lg the columns are tight (a 734 px table at 768): headers and link text may wrap
// there, and keep to one line from lg.
const TH_BASE =
  'top-0 z-1 border-b-2 border-primary bg-card text-left font-mono text-[11px] font-semibold uppercase tracking-wide text-muted-foreground md:sticky lg:whitespace-nowrap';
---

<!-- The table's own scroll container: a focusable region named by the caption, kept a tab stop
     only while the table is wider than it (ScrollRegion.astro). The sort buttons inside can be
     reached either way; the region is what lets a keyboard scroll to the Evidence column. -->
<ScrollRegion label={caption} class="rounded-lg border border-border">
  <table class="trk-table w-full border-collapse text-[11px] max-md:block" role="table">
    <caption class="sr-only">{caption}</caption>
    <thead class="max-md:block" role="rowgroup">
      <tr
        class="max-md:flex max-md:flex-wrap max-md:items-center max-md:gap-1.5 max-md:border-b max-md:border-border max-md:p-2 max-md:before:mr-0.5 max-md:before:font-mono max-md:before:text-[11px] max-md:before:font-semibold max-md:before:tracking-wide max-md:before:text-muted-foreground max-md:before:uppercase max-md:before:content-['Sort_by'_/_'']"
        role="row"
      >
        {
          columns.map((c) =>
            c.sortable ? (
              <th
                scope="col"
                role="columnheader"
                class:list={[TH_BASE, 'p-0 max-md:border-0 max-md:bg-transparent max-md:whitespace-nowrap']}
                aria-sort="none"
                data-trk-sort={c.key}
              >
                <button
                  type="button"
                  class="inline-flex min-h-11 cursor-pointer items-center gap-1 px-2 text-left hover:text-primary max-md:rounded-md max-md:border max-md:border-border max-md:px-2.5 max-md:hover:border-primary"
                >
                  {c.label}
                  <span class="trk-th-arrow" aria-hidden="true" />
                </button>
              </th>
            ) : (
              <th scope="col" role="columnheader" class:list={[TH_BASE, 'p-2 max-md:sr-only']}>
                {c.label}
              </th>
            )
          )
        }
      </tr>
    </thead>
    <tbody class="max-md:block" role="rowgroup" data-trk-tbody>
      {
        rows.map((row) => (
          <tr
            class="border-b border-border last:border-b-0 hover:bg-muted/40 max-md:grid max-md:grid-cols-[minmax(0,1fr)_auto] max-md:gap-x-3 max-md:gap-y-1.5 max-md:px-3 max-md:py-3"
            role="row"
            data-trk-row
            data-trk-search-text={row.searchText}
            id={`row-${row.id}`}
          >
            {columns.map((c) => {
              const cell = row.cells[c.key] ?? {};
              return (
                <td
                  class:list={[
                    'px-1.5 py-1.5 align-top sm:px-2 max-md:min-w-0 max-md:p-0 max-md:empty:hidden',
                    c.phone ?? 'max-md:col-span-2',
                  ]}
                  role="cell"
                  data-sort={cell.sortVal ?? ''}
                >
                  {c.phoneLabel ? (
                    <span
                      class="mr-1.5 font-mono text-[11px] font-semibold tracking-wide text-muted-foreground uppercase md:hidden"
                      aria-hidden="true"
                    >
                      {c.phoneLabel}
                    </span>
                  ) : null}
                  {cell.badge ? (
                    <StatusBadge
                      label={cell.badge.label}
                      tone={cell.badge.tone}
                      glyph={cell.badge.glyph}
                    />
                  ) : null}
                  {cell.primary ? (
                    <span
                      class:list={[
                        'block text-[11px] leading-snug sm:text-xs',
                        c.phoneLabel && 'max-md:inline',
                        cell.badge && 'mt-1',
                        cell.mono && 'font-mono font-semibold',
                        cell.dim ? 'text-muted-foreground' : 'text-foreground',
                      ]}
                    >
                      {cell.href ? (
                        <a class:list={[touchRowLink, toneClass(cell.tone)]} href={cell.href}>
                          {cell.primary}
                        </a>
                      ) : (
                        cell.primary
                      )}
                    </span>
                  ) : null}
                  {cell.secondary ? (
                    <span
                      class:list={[
                        'mt-px block text-[11px] leading-normal text-muted-foreground',
                        c.phoneLabel && 'max-md:ml-1.5 max-md:inline',
                      ]}
                    >
                      {cell.secondary}
                    </span>
                  ) : null}
                  {cell.link ? (
                    <a
                      class:list={[
                        'mt-0.5 inline-flex min-h-11 items-center font-mono text-[11px] font-semibold max-md:mt-0 lg:whitespace-nowrap',
                        toneClass(cell.link.tone),
                      ]}
                      href={cell.link.href}
                    >
                      {linkText(cell.link.text)}
                    </a>
                  ) : null}
                  {cell.evidence ? (
                    <SourceDisclosure
                      sources={cell.evidence.sources}
                      verified={cell.evidence.verified}
                      entryId={cell.evidence.entryId}
                      entryLabel={cell.evidence.entryLabel}
                      shareHref={cell.evidence.shareHref}
                      compact
                    />
                  ) : null}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</ScrollRegion>

<style>
  /* Nothing here resets the sort button: Tailwind's preflight already zeroes a button's
     border, padding, margin and background and makes it inherit `font` and `color`, so it
     picks up the `<th>`'s mono/uppercase treatment on its own. A scoped `all: unset` would
     be WORSE than nothing — scoped styles are unlayered and would outrank every utility
     class on the element, stripping the layout back off.

     The sort indicator below is generated content keyed off `aria-sort`, so the state lives
     in one accessible attribute instead of a parallel class. No utility can express
     `content`. */
  .trk-th-arrow::after {
    content: '↕';
    font-size: 11px;
    opacity: 0.45;
  }
  .trk-table th[aria-sort='ascending'] .trk-th-arrow::after {
    content: '↑';
    opacity: 1;
    color: var(--primary);
  }
  .trk-table th[aria-sort='descending'] .trk-th-arrow::after {
    content: '↓';
    opacity: 1;
    color: var(--primary);
  }
</style>
