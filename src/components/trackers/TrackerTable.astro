---
import StatusBadge from './StatusBadge.astro';
import SourceDisclosure from './SourceDisclosure.astro';

// The sortable registry table — also the SEO surface: every entry is real text at build time.
// Sorting and filtering are progressive enhancement via `src/scripts/trackers.ts` reading the
// `data-sort` / `data-trk-*` attributes; with JS off this is a complete static table.
//
// Cell descriptor: { primary, secondary?, mono?, dim?, badge?: {label, tone, glyph}, link?,
//                    evidence?, sortVal? }
interface Column {
  key: string;
  label: string;
  sortable?: boolean;
}

interface Props {
  caption: string;
  columns: Column[];
  rows: { id: string; searchText: string; cells: Record<string, any> }[];
}

const { caption, columns, rows } = Astro.props;
---

<!-- No tabindex on the scroll wrapper: it contains focusable sort buttons, so keyboard
     users can already reach and scroll it — a tabindex here trips axe nested-interactive. -->
<div class="overflow-x-auto rounded-md border border-border">
  <table class="trk-table w-full border-collapse text-[11px]">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        {
          columns.map((c) =>
            c.sortable ? (
              <th
                scope="col"
                class="sticky top-0 z-1 whitespace-nowrap border-b-2 border-primary bg-card p-0 text-left font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground"
                aria-sort="none"
                data-trk-sort={c.key}
              >
                <button
                  type="button"
                  class="inline-flex min-h-11 cursor-pointer items-center gap-1 px-2 hover:text-primary"
                >
                  {c.label}
                  <span class="trk-th-arrow" aria-hidden="true" />
                </button>
              </th>
            ) : (
              <th
                scope="col"
                class="sticky top-0 z-1 whitespace-nowrap border-b-2 border-primary bg-card p-2 text-left font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground"
              >
                {c.label}
              </th>
            )
          )
        }
      </tr>
    </thead>
    <tbody data-trk-tbody>
      {
        rows.map((row) => (
          <tr
            class="border-b border-border last:border-b-0 hover:bg-muted/40"
            data-trk-row
            data-trk-search-text={row.searchText}
            id={`row-${row.id}`}
          >
            {columns.map((c) => {
              const cell = row.cells[c.key] ?? {};
              return (
                <td class="px-1.5 py-1.5 align-top sm:px-2" data-sort={cell.sortVal ?? ''}>
                  {cell.badge ? (
                    <StatusBadge
                      label={cell.badge.label}
                      tone={cell.badge.tone}
                      glyph={cell.badge.glyph}
                    />
                  ) : null}
                  {cell.primary ? (
                    <span
                      class:list={[
                        'block text-[11px] leading-snug sm:text-xs',
                        cell.badge && 'mt-1',
                        cell.mono && 'font-mono font-semibold',
                        cell.dim ? 'text-muted-foreground' : 'text-foreground',
                      ]}
                    >
                      {cell.primary}
                    </span>
                  ) : null}
                  {cell.secondary ? (
                    <span class="mt-px block text-[10px] leading-normal text-muted-foreground sm:text-[11px]">
                      {cell.secondary}
                    </span>
                  ) : null}
                  {cell.link ? (
                    <a
                      class="mt-0.5 inline-flex min-h-11 items-center whitespace-nowrap font-mono text-[10px] font-semibold text-primary underline-offset-2 hover:underline"
                      href={cell.link.href}
                    >
                      {cell.link.text}
                    </a>
                  ) : null}
                  {cell.evidence ? (
                    <SourceDisclosure
                      sources={cell.evidence.sources}
                      verified={cell.evidence.verified}
                      entryId={cell.evidence.entryId}
                      entryLabel={cell.evidence.entryLabel}
                      shareHref={cell.evidence.shareHref}
                      compact
                    />
                  ) : null}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Nothing here resets the sort button: Tailwind's preflight already zeroes a button's
     border, padding, margin and background and makes it inherit `font` and `color`, so it
     picks up the `<th>`'s mono/uppercase treatment on its own. A scoped `all: unset` would
     be WORSE than nothing — scoped styles are unlayered and would outrank every utility
     class on the element, stripping the layout back off.

     The sort indicator below is generated content keyed off `aria-sort`, so the state lives
     in one accessible attribute instead of a parallel class. No utility can express
     `content`. */
  .trk-th-arrow::after {
    content: '↕';
    font-size: 8px;
    opacity: 0.45;
  }
  .trk-table th[aria-sort='ascending'] .trk-th-arrow::after {
    content: '↑';
    opacity: 1;
    color: var(--primary);
  }
  .trk-table th[aria-sort='descending'] .trk-th-arrow::after {
    content: '↓';
    opacity: 1;
    color: var(--primary);
  }
</style>
