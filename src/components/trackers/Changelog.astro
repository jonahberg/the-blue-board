---
// Reverse-chronological update ledger. Dates render mono; entries in body type.
interface Props {
  entries: { date: string; entry: string }[];
  id?: string;
}

const { entries, id = 'changelog' } = Astro.props;
const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<ol class="list-none" id={id}>
  {
    entries.map((e) => (
      <li class="flex flex-col gap-0.5 border-b border-border py-2.5 last:border-b-0 sm:flex-row sm:items-baseline sm:gap-3.5">
        <time
          class="font-mono text-[10px] font-semibold uppercase tracking-wider text-muted-foreground sm:basis-23 sm:shrink-0"
          datetime={e.date}
        >
          {fmt(e.date)}
        </time>
        <span class="text-sm leading-relaxed text-foreground">{e.entry}</span>
      </li>
    ))
  }
</ol>
