---
/**
 * Evidence and return actions at the point of the claim. The source list is real HTML at
 * build time; watch and share are progressive enhancements in `src/scripts/trackers.ts`.
 */
interface Props {
  sources: string[];
  verified: string;
  entryId: string;
  entryLabel: string;
  shareHref: string;
  compact?: boolean;
}

const { sources, verified, entryId, entryLabel, shareHref, compact = false } = Astro.props;

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const PUBLISHERS: Record<string, string> = {
  'aerotime.aero': 'AeroTime',
  'aol.com': 'AOL News',
  'aopa.org': 'AOPA',
  'chicago.gov': 'City of Chicago',
  'fedscoop.com': 'FedScoop',
  'fly2houston.com': 'Houston Airports',
  'flychicago.com': 'Chicago Airports',
  'flydenver.com': 'Denver International Airport',
  'flydulles.com': 'Washington Dulles',
  'flyingmag.com': 'Flying Magazine',
  'gao.gov': 'US Government Accountability Office',
  'highergov.com': 'HigherGov',
  'l3harris.com': 'L3Harris',
  'lawa.org': 'Los Angeles World Airports',
  'leidos.com': 'Leidos',
  'modernskies.faa.gov': 'FAA Modern Skies',
  'oig.dot.gov': 'US DOT Inspector General',
  'onemileatatime.com': 'One Mile at a Time',
  'panynj.gov': 'Port Authority of NY & NJ',
  'simpleflying.com': 'Simple Flying',
  'thepointsguy.com': 'The Points Guy',
  'united.mediaroom.com': 'United Newsroom',
  'viewfromthewing.com': 'View from the Wing',
};

const sourceLabel = (source: string) => {
  const host = new URL(source).hostname.replace(/^www\./, '');
  return PUBLISHERS[host] ?? host;
};

// 44 px tall per the touch-target rule, so the label is centred and set a size up from the
// old 8 px chip — at 8 px it read as an empty box rather than a button.
const actionClass =
  'inline-flex min-h-11 flex-1 items-center justify-center rounded-sm border border-border px-2.5 font-mono text-[9px] font-semibold uppercase tracking-wide text-muted-foreground hover:border-primary hover:text-primary aria-pressed:border-emerald-400/55 aria-pressed:text-emerald-400';
---

<div
  class:list={[
    'flex gap-2',
    compact
      ? 'min-w-42 flex-col'
      : 'mt-2.5 flex-col items-start justify-between border-t border-border pt-2 sm:flex-row',
  ]}
>
  <details class="min-w-0">
    <summary
      class="flex cursor-pointer items-center gap-1.5 font-mono text-[9px] font-semibold uppercase tracking-wide text-primary marker:text-muted-foreground"
    >
      <span>Sources ({sources.length})</span>
      <span class="font-medium text-muted-foreground">verified {fmt(verified)}</span>
    </summary>
    <ol class="mt-1.5 ml-4 list-decimal">
      {
        sources.map((source) => (
          <li class="text-[10px] leading-relaxed text-muted-foreground">
            <a
              href={source}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-primary/35 underline-offset-2 hover:decoration-primary"
            >
              {sourceLabel(source)}
            </a>
          </li>
        ))
      }
    </ol>
  </details>
  <div class="flex shrink-0 gap-1" aria-label={`Actions for ${entryLabel}`}>
    <button
      type="button"
      class={actionClass}
      data-trk-watch
      data-trk-watch-id={entryId}
      data-trk-watch-label={entryLabel}
      aria-pressed="false"
      aria-label={`Watch ${entryLabel} for changes on this device`}
      title="Highlight changes when you return">Watch</button
    >
    <button
      type="button"
      class={actionClass}
      data-trk-share
      data-trk-share-href={shareHref}
      data-trk-share-label={entryLabel}
      aria-label={`Share ${entryLabel}`}
    >
      Share
    </button>
  </div>
</div>
