---
/**
 * Shared download and correction affordance for tracker landing and detail pages.
 * The correction link is a pre-filled GitHub issue so a reader who spots a wrong
 * figure lands in a form that already names the page and asks for a source.
 */
interface Props {
  slug: 'atc' | 'united-hubs';
  pageLabel: string;
  pagePath: string;
}

const { slug, pageLabel, pagePath } = Astro.props;
const issueTitle = `Tracker correction: ${pageLabel}`;
const issueBody = `Page: https://theblueboard.co${pagePath}\n\nWhat looks wrong or out of date?\n\nSource that supports the correction:`;
const correctionHref = `https://github.com/jonahberg/the-blue-board/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;

const linkClass =
  'inline-flex min-h-11 items-center justify-center rounded-md border border-border px-2.5 py-1.5 font-mono text-[9px] font-semibold uppercase tracking-wide text-primary transition-colors hover:border-primary hover:bg-accent';
---

<aside
  class="mt-4.5 flex flex-col items-stretch gap-4 rounded-r-md border border-border border-l-[3px] border-l-amber-400 bg-card px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
  aria-label="Tracker downloads and corrections"
>
  <div class="min-w-0">
    <strong class="block text-xs font-semibold text-amber-400">Use the data</strong>
    <span class="text-[11px] text-muted-foreground">Versioned, sourced, and ready to cite.</span>
  </div>
  <nav
    class="grid grid-cols-2 gap-1.5 sm:flex sm:flex-wrap sm:items-stretch sm:justify-end"
    aria-label="Download tracker data or report a correction"
  >
    <a href={`/trackers/${slug}.csv`} download class={linkClass}>Download CSV</a>
    <a href={`/trackers/${slug}.json`} download class={linkClass}>Download JSON</a>
    <a
      href={correctionHref}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[linkClass, 'col-span-2 sm:col-span-1']}>Report a correction ↗</a
    >
  </nav>
</aside>
