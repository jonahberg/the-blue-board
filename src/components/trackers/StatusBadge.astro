---
// Status badge: mono, uppercase, tint background + toned border + solid-token text.
// Status is never conveyed by colour alone — every badge carries its text label, and
// the glyph gives a second non-colour channel where the label alone is ambiguous in
// dense tables. Tone classes come from `tones.ts` so the map, the strip and the badge
// can never drift apart.
import { TONE_BADGE, toneClass } from './tones';

interface Props {
  label: string;
  tone?: string;
  glyph?: string;
}

const { label, tone = 'neutral', glyph = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1 whitespace-nowrap rounded-sm border px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider',
    toneClass(TONE_BADGE, tone),
  ]}
>{glyph && <span class="text-[8px] leading-none" aria-hidden="true">{glyph}</span>}{label}</span>
