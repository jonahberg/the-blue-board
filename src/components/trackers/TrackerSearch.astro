---
// "Check your airport / hub." Progressive enhancement: the page renders everything at build
// time; this input (wired up by `src/scripts/trackers.ts`) only filters what is already there.
// With JS off the wrapper keeps its `hidden` attribute and the full table stands alone — so
// never give this element a `display` rule in a stylesheet, or `hidden` stops hiding it.
interface Props {
  label: string;
  placeholder: string;
  emptyTitle: string;
  emptyBody: string;
  noun?: string;
}

const { label, placeholder, emptyTitle, emptyBody, noun = 'matches' } = Astro.props;
---

<div hidden data-trk-search-wrap>
  <label
    class="mb-2 block font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400"
    for="trk-search-input">{label}</label
  >
  <div class="flex items-center gap-3">
    <input
      type="search"
      id="trk-search-input"
      class="min-h-11 w-full max-w-105 flex-1 rounded-md border border-border bg-card px-3.5 py-2.5 text-sm text-foreground transition-colors placeholder:text-muted-foreground hover:border-primary"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      data-trk-search
    />
    <span
      class="whitespace-nowrap font-mono text-[10px] uppercase tracking-wide text-muted-foreground"
      data-trk-count
      data-trk-noun={noun}
      aria-live="polite"></span>
  </div>
  <div
    class="mt-3 rounded-r-md border-l-[3px] border-amber-400 bg-card px-4 py-3"
    hidden
    data-trk-empty
  >
    <div class="mb-1 text-xs font-semibold text-amber-400">{emptyTitle}</div>
    <p class="text-xs leading-relaxed text-muted-foreground">{emptyBody}</p>
  </div>
</div>
