---
/**
 * The shell for a single tracker entity page (`/trackers/atc/ord`, `/trackers/united-hubs/den`).
 *
 * It wraps `BaseLayout`, so the whole `<head>`, the site chrome, Web Analytics and the JSON-LD
 * blocks come from one place. `Breadcrumbs` renders the visible trail AND its BreadcrumbList
 * structured data — four levels here (site → Trackers → the parent tracker → this entity), so
 * the layout never emits a second one.
 *
 * The share card deliberately diverges from the document title: `ogTitle` is the `heading`
 * ("Does ORD Still Use Paper Flight Strips?"), because a shared link should lead with the
 * question the page answers, while `<title>` stays the SERP-tuned string from
 * `atcAirportSeo()` / `unitedHubSeo()`. `twitterTitle` and `twitterDescription` are left
 * unset: `Seo.astro` falls them back to the OG pair, which is what the pre-rebuild pages did.
 */
import BaseLayout from '../site/BaseLayout.astro';
import Breadcrumbs from '../site/Breadcrumbs.astro';
import LastUpdated from './LastUpdated.astro';
import TrackerDataActions from './TrackerDataActions.astro';
import { SECTION, SECTION_H2 } from './detail';
import { hubLink } from '../../lib/hub-link.js';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage: string;
  ogImageAlt: string;
  parentHref: string;
  parentLabel: string;
  breadcrumbLabel: string;
  kicker: string;
  heading: string;
  subtitle: string;
  lastUpdated: string;
  lastVerified: string;
  /** Entries on this page checked later than the rest (`verifiedNote()`); the ATC pages pass none. */
  verifiedNote?: { label: string; iso: string } | null;
  schemas?: Record<string, unknown>[];
  dataSlug: 'atc' | 'united-hubs';
  pagePath: string;
  pageLabel: string;
  peerLabel: string;
  peerLinks: { href: string; label: string; active?: boolean }[];
  /**
   * The hub this page is about ('ORD'). Every tracker detail page is about a United hub, and a
   * hub named as a hub links to its hub page (links everywhere, Nov 12 2026): the header carries
   * one quiet "ORD hub guide" door beside the way back to the full tracker.
   */
  hubCode?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  parentHref,
  parentLabel,
  breadcrumbLabel,
  kicker,
  heading,
  subtitle,
  lastUpdated,
  lastVerified,
  verifiedNote = null,
  schemas = [],
  dataSlug,
  pagePath,
  pageLabel,
  peerLabel,
  peerLinks,
  hubCode,
} = Astro.props;

const hubGuide = hubCode ? hubLink(hubCode, 'site') : null;

const peerLinkClass =
  'inline-flex min-h-11 items-center rounded-md border border-border px-3 font-mono text-[11px] font-semibold text-muted-foreground hover:border-primary hover:bg-accent hover:text-primary aria-[current=page]:border-primary aria-[current=page]:bg-primary/15 aria-[current=page]:text-foreground';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType="article"
  ogTitle={heading}
  jsonLd={schemas}
  dataAttrs={{ 'data-trk-page': dataSlug }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs
      items={[
        { label: 'Trackers', href: '/trackers' },
        { label: parentLabel, href: parentHref },
        { label: breadcrumbLabel },
      ]}
    />

    <header class="mt-6 mb-8">
      {/* A label, not a link: body colours only (link colour means link). */}
      <div class="font-mono text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
        {kicker}
      </div>
      <h1 class="mt-0.5 mb-1.5 text-2xl font-bold tracking-tight text-balance text-foreground">
        {heading}
      </h1>
      <p class="mb-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">{subtitle}</p>
      <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1">
        <LastUpdated iso={lastUpdated} />
        <LastUpdated iso={lastVerified} prefix="Verified" note={verifiedNote} />
      </div>
      <div class="flex flex-wrap items-center gap-x-5">
        <a
          class="inline-flex min-h-11 items-center font-mono text-[11px] font-semibold uppercase tracking-wide text-primary underline underline-offset-2"
          href={parentHref}>&larr; Open the complete {parentLabel}</a
        >
        {
          hubGuide && (
            <a
              class="inline-flex min-h-11 items-center font-mono text-[11px] font-semibold uppercase tracking-wide text-foreground underline decoration-muted-foreground/40 underline-offset-2 hover:decoration-foreground focus-visible:decoration-foreground"
              href={hubGuide.href}
            >
              {hubGuide.code} hub guide &rarr;
            </a>
          )
        }
      </div>
    </header>

    <slot />

    <section class={SECTION} aria-labelledby="tracker-peer-heading">
      <h2 id="tracker-peer-heading" class={SECTION_H2}>{peerLabel}</h2>
      <nav class="flex flex-wrap gap-1.5" aria-label={peerLabel}>
        {
          peerLinks.map((link) => (
            <a href={link.href} class={peerLinkClass} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </section>

    <section class={SECTION}>
      <TrackerDataActions slug={dataSlug} pageLabel={pageLabel} pagePath={pagePath} />
    </section>
  </div>

  <script src="../../scripts/trackers.ts"></script>
</BaseLayout>
