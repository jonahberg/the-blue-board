---
/**
 * The shell for a single tracker entity page (`/trackers/atc/ord`, `/trackers/united-hubs/den`).
 *
 * It wraps `BaseLayout`, so the whole `<head>`, the site chrome, Web Analytics and the JSON-LD
 * blocks come from one place. `Breadcrumbs` renders the visible trail AND its BreadcrumbList
 * structured data — four levels here (site → Trackers → the parent tracker → this entity), so
 * the layout never emits a second one.
 */
import BaseLayout from '../site/BaseLayout.astro';
import Breadcrumbs from '../site/Breadcrumbs.astro';
import LastUpdated from './LastUpdated.astro';
import TrackerDataActions from './TrackerDataActions.astro';
import { SECTION, SECTION_H2 } from './detail';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage: string;
  parentHref: string;
  parentLabel: string;
  breadcrumbLabel: string;
  kicker: string;
  heading: string;
  subtitle: string;
  lastUpdated: string;
  lastVerified: string;
  schemas?: Record<string, unknown>[];
  dataSlug: 'atc' | 'united-hubs';
  pagePath: string;
  pageLabel: string;
  peerLabel: string;
  peerLinks: { href: string; label: string; active?: boolean }[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  parentHref,
  parentLabel,
  breadcrumbLabel,
  kicker,
  heading,
  subtitle,
  lastUpdated,
  lastVerified,
  schemas = [],
  dataSlug,
  pagePath,
  pageLabel,
  peerLabel,
  peerLinks,
} = Astro.props;

const peerLinkClass =
  'inline-flex min-h-11 items-center rounded-md border border-border px-3 font-mono text-[10px] font-semibold text-muted-foreground hover:border-primary hover:bg-accent hover:text-primary aria-[current=page]:border-primary aria-[current=page]:bg-accent aria-[current=page]:text-primary';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  jsonLd={schemas}
  dataAttrs={{ 'data-trk-page': dataSlug }}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumbs
      items={[
        { label: 'Trackers', href: '/trackers' },
        { label: parentLabel, href: parentHref },
        { label: breadcrumbLabel },
      ]}
    />

    <header class="mt-6 mb-8">
      <div class="font-mono text-[10px] font-semibold uppercase tracking-widest text-amber-400">
        {kicker}
      </div>
      <h1 class="mt-0.5 mb-1.5 text-lg font-bold tracking-tight text-balance text-foreground sm:text-2xl">
        {heading}
      </h1>
      <p class="mb-2.5 max-w-2xl text-sm leading-relaxed text-muted-foreground">{subtitle}</p>
      <div class="mb-3 flex flex-wrap items-center gap-4">
        <LastUpdated iso={lastUpdated} />
        <LastUpdated iso={lastVerified} prefix="Verified" />
      </div>
      <a
        class="inline-flex min-h-11 items-center font-mono text-[9px] font-semibold uppercase tracking-wide text-primary underline underline-offset-2"
        href={parentHref}>&larr; Open the complete {parentLabel}</a
      >
    </header>

    <slot />

    <section class={SECTION} aria-labelledby="tracker-peer-heading">
      <h2 id="tracker-peer-heading" class={SECTION_H2}>{peerLabel}</h2>
      <nav class="flex flex-wrap gap-1.5" aria-label={peerLabel}>
        {
          peerLinks.map((link) => (
            <a href={link.href} class={peerLinkClass} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </section>

    <section class={SECTION}>
      <TrackerDataActions slug={dataSlug} pageLabel={pageLabel} pagePath={pagePath} />
    </section>
  </div>

  <script src="../../scripts/trackers.ts"></script>
</BaseLayout>
