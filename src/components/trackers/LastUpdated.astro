---
// Renders from data, never hardcoded. Noon-UTC anchor matches the news pages' formatter so a
// bare YYYY-MM-DD never renders a day early west of UTC.
//
// `note` adds the entries checked later than the rest, after the date:
// "Verified November 3, 2026 (Dulles Concourse E entries November 11)". It comes from
// `verifiedNote()` in src/data/trackers/verified.js, never typed.
interface Props {
  iso: string;
  prefix?: string;
  note?: { label: string; iso: string } | null;
}

const { iso, prefix = 'Updated', note = null } = Astro.props;
const display = new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
// The note's day drops the year when it matches the main date's.
const noteDisplay = note
  ? new Date(note.iso + 'T12:00:00Z').toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      ...(note.iso.slice(0, 4) === iso.slice(0, 4) ? {} : { year: 'numeric' }),
    })
  : '';
---

{
  note ? (
    // One text run after the dot, so a narrow screen wraps it like a sentence; the dot sits on
    // the first line's baseline.
    <span class="inline-flex items-baseline gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
      <span class="size-1.5 shrink-0 rounded-full bg-bb-ok" aria-hidden="true" />
      <span>
        {prefix} <time datetime={iso} class="whitespace-nowrap text-foreground">{display}</time>{' '}
        ({note.label} <time datetime={note.iso} class="whitespace-nowrap text-foreground">{noteDisplay}</time>)
      </span>
    </span>
  ) : (
    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
      <span class="size-1.5 shrink-0 rounded-full bg-bb-ok" aria-hidden="true" />
      {prefix}
      <time datetime={iso} class="text-foreground">{display}</time>
    </span>
  )
}
