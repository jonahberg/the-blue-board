---
// Renders from data, never hardcoded. Noon-UTC anchor matches the news pages' formatter so a
// bare YYYY-MM-DD never renders a day early west of UTC.
interface Props {
  iso: string;
  prefix?: string;
}

const { iso, prefix = 'Updated' } = Astro.props;
const display = new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<span
  class="inline-flex items-center gap-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-muted-foreground"
  ><span class="size-1.5 shrink-0 rounded-full bg-emerald-400" aria-hidden="true"></span>{prefix}
  <time datetime={iso} class="text-foreground">{display}</time></span
>
