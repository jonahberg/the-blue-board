---
/**
 * The briefing strip: what changed since your last visit, and your home airport's line.
 *
 * The `data-trk-config` blob is a `type="application/json"` script — data, not code, so it
 * costs the CSP nothing — and `src/scripts/trackers.ts` reads it to personalize the strip.
 * Everything here renders statically first; JS only replaces text and unhides rows.
 */
interface Props {
  slug: string;
  kind: string;
  lastUpdated: string;
  lastVerified: string;
  changes: { date: string; entry: string }[];
  entities: Record<string, { label: string; summary: string; href: string }>;
}

const { slug, kind, lastUpdated, lastVerified, changes, entities } = Astro.props;
const latest = changes[0];
const config = JSON.stringify({ slug, kind, lastUpdated, lastVerified, changes, entities }).replace(
  /</g,
  '\\u003c'
);
---

<!-- A plain card. It once led with a three-colour bar in the status hues (blue, amber, green)
     that encoded nothing; colour is status only (DESIGN.md), so it went. -->
<section
  class="mt-4 mb-8 grid grid-cols-[minmax(0,1fr)] items-center gap-x-3.5 overflow-hidden rounded-lg border border-border bg-card px-4 py-3.5 sm:grid-cols-[minmax(0,1fr)_auto]"
  data-trk-pulse
  aria-labelledby="trk-pulse-title"
>
  <div class="min-w-0">
    <div
      class="font-mono text-[11px] font-bold uppercase tracking-widest text-muted-foreground"
      id="trk-pulse-title"
    >
      Your tracker briefing
    </div>
    <div class="mt-0.5 text-xs leading-relaxed text-foreground" data-trk-delta>
      <strong class="font-semibold text-foreground">Latest:</strong>
      {latest.entry}
    </div>
    <div
      class="mt-1.5 flex flex-wrap items-baseline gap-1.5 text-[11px] text-muted-foreground"
      data-trk-personal
      hidden
    >
      <span class="font-mono font-bold text-foreground" data-trk-personal-code></span>
      <span data-trk-personal-summary></span>
      <a
        class="font-mono text-[11px] font-semibold uppercase text-primary underline-offset-2 hover:underline"
        data-trk-personal-link
        href="#">Open entry &rarr;</a
      >
    </div>
    <div class="mt-1.5 text-[11px] text-muted-foreground" data-trk-personal-empty>
      Set your home airport on <a
        href="/"
        class="text-primary underline decoration-primary/40 underline-offset-2 hover:decoration-primary">The Blue Board</a
      > to put its status here.
    </div>
  </div>

  <!-- On a phone this column is a second row: it takes no height until the watch button or its
       status has something to show, so an idle strip has no empty band at its foot. -->
  <div class="col-start-1 flex flex-col items-start gap-1 has-[button:not([hidden])]:mt-3 sm:col-start-2 sm:items-end sm:has-[button:not([hidden])]:mt-0">
    <button
      type="button"
      class="inline-flex min-h-11 items-center whitespace-nowrap rounded-md border border-primary bg-primary-fill/20 px-2.5 font-mono text-[11px] font-bold uppercase tracking-wide text-primary hover:bg-primary-fill hover:text-primary-foreground aria-pressed:border-bb-ok/55 aria-pressed:bg-bb-ok/10 aria-pressed:text-bb-ok"
      data-trk-pulse-watch
      hidden
      aria-pressed="false"
      title="Highlight changes when you return">Watch this {kind}</button
    >
    <span
      class="font-mono text-[11px] uppercase text-muted-foreground sm:min-h-3.5"
      data-trk-watch-status
      aria-live="polite"></span>
  </div>

  <script type="application/json" data-trk-config set:html={config}></script>
</section>
