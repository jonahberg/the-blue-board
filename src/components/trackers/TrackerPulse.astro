---
/**
 * The briefing strip: what changed since your last visit, and your home airport's line.
 *
 * The `data-trk-config` blob is a `type="application/json"` script — data, not code, so it
 * costs the CSP nothing — and `src/scripts/trackers.ts` reads it to personalize the strip.
 * Everything here renders statically first; JS only replaces text and unhides rows.
 */
interface Props {
  slug: string;
  kind: string;
  lastUpdated: string;
  lastVerified: string;
  changes: { date: string; entry: string }[];
  entities: Record<string, { label: string; summary: string; href: string }>;
}

const { slug, kind, lastUpdated, lastVerified, changes, entities } = Astro.props;
const latest = changes[0];
const config = JSON.stringify({ slug, kind, lastUpdated, lastVerified, changes, entities }).replace(
  /</g,
  '\\u003c'
);
---

<section
  class="mt-1 mb-8 grid grid-cols-[8px_minmax(0,1fr)] items-center gap-3.5 overflow-hidden rounded-md border border-border bg-card py-3.5 pr-4 pl-3 sm:grid-cols-[8px_minmax(0,1fr)_auto]"
  data-trk-pulse
  aria-labelledby="trk-pulse-title"
>
  <div class="flex h-full flex-col justify-center gap-0.5" aria-hidden="true">
    <span class="block h-3 rounded-xs bg-primary"></span>
    <span class="block h-3 rounded-xs bg-amber-400"></span>
    <span class="block h-3 rounded-xs bg-emerald-400"></span>
  </div>

  <div class="min-w-0">
    <div
      class="font-mono text-[9px] font-bold uppercase tracking-widest text-amber-400"
      id="trk-pulse-title"
    >
      Your tracker briefing
    </div>
    <div class="mt-0.5 text-xs leading-relaxed text-foreground" data-trk-delta>
      <strong class="font-semibold text-primary">Latest:</strong>
      {latest.entry}
    </div>
    <div
      class="mt-1.5 flex flex-wrap items-baseline gap-1.5 text-[11px] text-muted-foreground"
      data-trk-personal
      hidden
    >
      <span class="font-mono font-bold text-foreground" data-trk-personal-code></span>
      <span data-trk-personal-summary></span>
      <a
        class="font-mono text-[9px] font-semibold uppercase text-primary underline-offset-2 hover:underline"
        data-trk-personal-link
        href="#">Open entry &rarr;</a
      >
    </div>
    <div class="mt-1.5 text-[10px] text-muted-foreground" data-trk-personal-empty>
      Set your home airport on <a
        href="/"
        class="text-primary underline-offset-2 hover:underline">The Blue Board</a
      > to put its status here.
    </div>
  </div>

  <div class="col-start-2 flex flex-col items-start gap-1 sm:col-start-3 sm:items-end">
    <button
      type="button"
      class="inline-flex min-h-11 items-center whitespace-nowrap rounded-md border border-primary bg-primary/20 px-2.5 font-mono text-[9px] font-bold uppercase tracking-wide text-primary hover:bg-primary hover:text-primary-foreground aria-pressed:border-emerald-400/55 aria-pressed:bg-emerald-400/10 aria-pressed:text-emerald-400"
      data-trk-pulse-watch
      hidden
      aria-pressed="false"
      title="Highlight changes when you return">Watch this {kind}</button
    >
    <span
      class="min-h-3.5 font-mono text-[8px] uppercase text-muted-foreground"
      data-trk-watch-status
      aria-live="polite"></span>
  </div>

  <script type="application/json" data-trk-config set:html={config}></script>
</section>
