---
// Amber highlight-box cross-link — same idiom as the hub pages' cross-links.
interface Props {
  title: string;
  body: string;
  href: string;
  linkText: string;
}

const { title, body, href, linkText } = Astro.props;
---

<div class="rounded-r-md border-l-[3px] border-amber-400 bg-card px-4 py-3">
  <div class="mb-1 text-xs font-semibold text-amber-400">{title}</div>
  <p class="mb-1.5 text-xs leading-relaxed text-muted-foreground">{body}</p>
  <a
    class="inline-flex min-h-11 items-center font-mono text-[11px] font-semibold text-primary underline-offset-2 hover:underline"
    href={href}>{linkText} &rarr;</a
  >
</div>
