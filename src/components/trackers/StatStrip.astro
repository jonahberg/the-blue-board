---
// The scoreboard. 3–4 tiles, mono values, one amber "featured" tile max — amber
// discipline. This is the strip people screenshot; keep it clean.
import { STAT_TONE, toneClass } from './tones';

interface Props {
  stats: { label: string; value: string; tone?: string; sub?: string }[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]">
  {
    stats.map((s) => (
      <div
        class:list={[
          'rounded-md border border-border bg-card px-3 py-4 text-center',
          s.tone === 'amber' && 'border-l-[3px] border-l-amber-400',
        ]}
      >
        <div class="mb-1.5 font-mono text-[9px] font-semibold uppercase tracking-widest text-muted-foreground">
          {s.label}
        </div>
        <div
          class:list={[
            'font-mono text-xl font-bold leading-tight sm:text-2xl',
            toneClass(STAT_TONE, s.tone ?? 'default'),
          ]}
        >
          {s.value}
        </div>
        {s.sub && (
          <div class="mt-1.5 font-mono text-[9px] tracking-wide text-muted-foreground">{s.sub}</div>
        )}
      </div>
    ))
  }
</div>
