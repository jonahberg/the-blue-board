{
  "name": "the-blue-board",
  "description": "The Blue Board \u2014 Unofficial United Airlines operations dashboard",
  "author": "Jonah Berg (https://github.com/jonahberg)",
  "license": "FSL-1.1-MIT",
  "repository": "jonahberg/the-blue-board",
  "private": true,
  "type": "module",
  "version": "1.8.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun scripts/refresh-starlink-facts.mjs && astro build && bun scripts/stamp-seo-build-date.mjs && bun scripts/build-agent-markdown.mjs && bun scripts/verify-csp-hashes.mjs",
    "preview": "astro preview",
    "seed:schedules": "bun scripts/seed-schedules.mjs",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "typecheck": "tsc --noEmit",
    "ui-audit": "bun scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@astrojs/react": "^5.0.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.4.3",
    "astro": "^6.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "fast-xml-parser": "^5.5.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.9.4",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.3.11",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.6.12",
    "jsdom": "30.0.1",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.7"
  }
}
